<!-- ================================================================
     MODAL: ملف المورد (المشتريات والديون)
     ================================================================ -->
<div class="modal-overlay" id="supplierFileModal" onclick="closeFileModalOutside(event)">
    <div class="modal-box modal-box-lg" id="supplierFileModalBox">

        <!-- Modal Header -->
        <div class="modal-header-custom file-header">
            <div class="file-header-info">
                <h5 class="modal-title-custom" id="fileSupplierName">ملف المورد: ---</h5>
                <div class="file-header-sub">
                    <span id="fileSupplierPhone">رقم الهاتف: ---</span>
                    <span id="fileSupplierID">ID: ---</span>
                </div>
            </div>
            <div class="file-header-left">
                <div class="file-avatar" id="fileSupplierAvatar">؟</div>
                <button class="modal-close-btn" onclick="closeFileModal()">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        </div>

        <!-- Stats Row -->
        <div class="file-stats-row">
            <div class="file-stat-card stat-purchases">
                <span class="stat-label">إجمالي المشتريات من هذا المورد</span>
                <span class="stat-value green" id="statTotalPurchases">0.00 دج</span>
            </div>
            <div class="file-stat-card stat-paid">
                <span class="stat-label">إجمالي المدفوعات</span>
                <span class="stat-value green" id="statTotalPaid">0.00 دج</span>
            </div>
            <div class="file-stat-card stat-debt">
                <span class="stat-label">الديون المستحقة للمورد</span>
                <span class="stat-value red" id="statTotalDebt">0.00 دج</span>
                <div class="stat-debt-bar"></div>
            </div>
        </div>

        <!-- Initial Debt Box -->
        <div class="initial-debt-box" id="initialDebtBox" style="display:none">
            <div class="initial-debt-right">
                <h6 class="initial-debt-title">الدين الابتدائي للمورد</h6>
                <p class="initial-debt-sub">
                    الدين الابتدائي (ديون سابقة قبل بدء استخدام البرنامج):
                    <span id="initialDebtAmount" class="text-orange fw-bold">0.00 دج</span>
                </p>
            </div>
            <div class="initial-debt-left">
                <span class="initial-debt-badge-label">الدين الابتدائي (الباقي)</span>
                <span class="initial-debt-value" id="initialDebtRemaining">0.00 دج</span>
            </div>
        </div>

        <!-- Payment Section -->
        <div class="payment-section">
            <h6 class="payment-title">
                <i class="fas fa-cash-register me-2"></i>
                تسديد دفعة للمورد
            </h6>
            <div class="payment-form-row">
                <button class="btn-confirm-payment" onclick="confirmPayment()">
                    <i class="fas fa-check-circle me-2"></i>
                    تأكيد التسديد
                </button>
                <div class="payment-field">
                    <label>التاريخ</label>
                    <input type="date" id="paymentDate" class="payment-input"
                           value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                </div>
                <div class="payment-field flex-1">
                    <label>المبلغ المدفوع</label>
                    <input type="number" id="paymentAmount"
                           class="payment-input payment-amount"
                           value="0.00" min="0" step="0.01" />
                </div>
            </div>
            <small class="payment-note">
                يُسدَّد الدين الابتدائي أولاً ثم الفواتير الأقدم فالأحدث.
            </small>
        </div>

        <!-- Tables Row -->
        <div class="file-tables-row">

            <!-- Invoices Table -->
            <div class="file-table-wrap">
                <h6 class="table-title">
                    <i class="fas fa-file-invoice me-2 text-teal"></i>
                    فواتير المشتريات
                </h6>
                <div class="table-responsive">
                    <table class="file-table">
                        <thead>
                            <tr>
                                <th>رقم الفاتورة / التاريخ</th>
                                <th>الإجمالي</th>
                                <th>المدفوع</th>
                                <th class="text-red">المتبقي (الديون)</th>
                            </tr>
                        </thead>
                        <tbody id="invoicesTableBody">
                            <tr>
                                <td colspan="4" class="text-center text-muted py-3">
                                    لا توجد فواتير.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Payments Table -->
            <div class="file-table-wrap">
                <h6 class="table-title">
                    <i class="fas fa-history me-2 text-teal"></i>
                    سجل الدفعات المتراكمة
                </h6>
                <div class="table-responsive">
                    <table class="file-table">
                        <thead>
                            <tr>
                                <th>التاريخ</th>
                                <th>المبلغ المدفوع</th>
                                <th>رقم الفاتورة المرتبطة</th>
                            </tr>
                        </thead>
                        <tbody id="paymentsTableBody">
                            <tr>
                                <td colspan="3" class="text-center text-muted py-3">
                                    لا يوجد سجل دفعات.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- ================================================================
     DELETE CONFIRM MODAL
     ================================================================ -->
<div class="modal-overlay" id="deleteModal" onclick="closeDeleteModalOutside(event)">
    <div class="modal-box modal-box-sm">
        <div class="modal-header-custom">
            <h5 class="modal-title-custom text-danger">
                <i class="fas fa-exclamation-triangle me-2"></i>
                تأكيد الحذف
            </h5>
            <button class="modal-close-btn" onclick="closeDeleteModal()">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="modal-body-custom text-center py-4">
            <p class="mb-1">هل أنت متأكد من حذف المورد:</p>
            <h5 class="text-danger fw-bold" id="deleteSupplierName">---</h5>
            <p class="text-muted small mt-2">لا يمكن التراجع عن هذا الإجراء.</p>
        </div>
        <div class="modal-footer-custom justify-content-center gap-3">
            <button class="btn-cancel" onclick="closeDeleteModal()">إلغاء</button>
            <button class="btn-delete-confirm" onclick="confirmDelete()">
                <i class="fas fa-trash me-2"></i> حذف
            </button>
        </div>
    </div>
</div>

@section Styles {
    <style>

        /* ==============================
           GLOBAL
           ============================== */
        .suppliers-page {
            font-family: 'Tajawal', sans-serif;
        }

        /* ==============================
           PAGE HEADER
           ============================== */
        .page-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
        }

        .page-title {
            font-size: 1.6rem;
            font-weight: 700;
            color: #1a3a2a;
            margin: 0;
        }

        .btn-add-supplier {
            background: #3b5bdb;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            transition: all 0.2s;
            font-family: 'Tajawal', sans-serif;
        }

            .btn-add-supplier:hover {
                background: #2f4ac5;
                transform: translateY(-1px);
                box-shadow: 0 4px 14px rgba(59,91,219,0.35);
            }

        /* ==============================
           SEARCH
           ============================== */
        .search-container {
            background: white;
            border-radius: 12px;
            border: 1px solid #e5e7eb;
            padding: 14px 16px;
            margin-bottom: 20px;
            box-shadow: 0 1px 6px rgba(0,0,0,0.04);
        }

        .search-box {
            display: flex;
            align-items: center;
            gap: 10px;
            justify-content: flex-end;
        }

        .search-icon {
            color: #9ca3af;
            font-size: 16px;
        }

        .search-input {
            border: none;
            outline: none;
            font-size: 14px;
            font-family: 'Tajawal', sans-serif;
            color: #374151;
            background: transparent;
            width: 100%;
            text-align: right;
        }

            .search-input::placeholder {
                color: #9ca3af;
            }

        /* ==============================
           SUPPLIER CARD
           ============================== */
        .suppliers-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-bottom: 20px;
        }

        .supplier-card {
            background: white;
            border-radius: 12px;
            border: 1px solid #e9ecef;
            padding: 18px 18px 18px 22px;
            position: relative;
            overflow: hidden;
            box-shadow: 0 1px 6px rgba(0,0,0,0.04);
            transition: box-shadow 0.2s;
            display: grid;
            grid-template-columns: auto 1fr auto;
            grid-template-rows: auto auto auto;
            gap: 8px 14px;
        }

            .supplier-card:hover {
                box-shadow: 0 4px 18px rgba(0,0,0,0.09);
            }

        /* Right Color Bar */
        .supplier-card-bar {
            position: absolute;
            right: 0;
            top: 0;
            bottom: 0;
            width: 5px;
            background: #1a8a5c;
            border-radius: 0 12px 12px 0;
        }

        /* Avatar */
        .supplier-avatar-wrap {
            grid-column: 3;
            grid-row: 1 / 3;
            display: flex;
            align-items: flex-start;
            padding-top: 2px;
        }

        .supplier-avatar {
            width: 52px;
            height: 52px;
            background: #e8f5ee;
            color: #1a8a5c;
            border-radius: 10px;
            display: flex;
            align-items: center;
