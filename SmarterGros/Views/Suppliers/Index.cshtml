@section Scripts {
    <script>
        function openSupplierModal() {
            document.getElementById('supplierId').value = '0';
            document.getElementById('supplierModalTitle').textContent = 'إضافة مورد جديد';
            clearSupplierForm();
            document.getElementById('supplierModal').classList.add('show');
        }

        function closeSupplierModal() {
            document.getElementById('supplierModal').classList.remove('show');
        }

        function clearSupplierForm() {
            ['supplierName','supplierActivity','supplierPhone','supplierPhone2',
             'supplierEmail','supplierCity','supplierAddress','supplierCR',
             'supplierTax','supplierBank','supplierBankName'].forEach(id => {
                document.getElementById(id).value = '';
            });
        }

        async function editSupplier(id) {
            const res = await fetch(`/Suppliers/GetSupplier/${id}`);
            const s = await res.json();
            document.getElementById('supplierId').value = s.id;
            document.getElementById('supplierName').value = s.name || '';
            document.getElementById('supplierActivity').value = s.businessActivity || '';
            document.getElementById('supplierPhone').value = s.phone || '';
            document.getElementById('supplierPhone2').value = s.phone2 || '';
            document.getElementById('supplierEmail').value = s.email || '';
            document.getElementById('supplierCity').value = s.city || '';
            document.getElementById('supplierAddress').value = s.address || '';
            document.getElementById('supplierCR').value = s.RC || '';
            document.getElementById('supplierTax').value = s.NIF || '';
            document.getElementById('supplierBank').value = s.bankAccount || '';
            document.getElementById('supplierBankName').value = s.bankName || '';
            document.getElementById('supplierModalTitle').textContent = 'تعديل المورد';
            document.getElementById('supplierModal').classList.add('show');
        }

        async function saveSupplier() {
            const id = parseInt(document.getElementById('supplierId').value);
            const data = {
                id,
                name: document.getElementById('supplierName').value,
                businessActivity: document.getElementById('supplierActivity').value,
                phone: document.getElementById('supplierPhone').value,
                phone2: document.getElementById('supplierPhone2').value,
                email: document.getElementById('supplierEmail').value,
                city: document.getElementById('supplierCity').value,
                address: document.getElementById('supplierAddress').value,
                RC: document.getElementById('supplierCR').value,
                NIF: document.getElementById('supplierTax').value,
                bankAccount: document.getElementById('supplierBank').value,
                bankName: document.getElementById('supplierBankName').value
            };

            const url = id === 0 ? '/Suppliers/Create' : '/Suppliers/Edit';
            const res = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            const result = await res.json();
            if (result.success) {
                closeSupplierModal();
                location.reload();
            }
        }

        async function deleteSupplier(id, name) {
            if (!confirm(`هل تريد حذف المورد: ${name}؟`)) return;
            const res = await fetch(`/Suppliers/Delete`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(id)
            });
            const result = await res.json();
            if (result.success) location.reload();
        }
    </script>
} *@