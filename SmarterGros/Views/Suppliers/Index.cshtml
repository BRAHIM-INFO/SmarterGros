@section Scripts {
    <script>
        // ================================================
        //  PAGINATION
        // ================================================
        const ITEMS_PER_PAGE = 10;
        let currentPage = 1;
        let allCards = [];

        document.addEventListener('DOMContentLoaded', () => {
            allCards = Array.from(document.querySelectorAll('.supplier-card'));
            renderPage();
        });

        function renderPage() {
            const visible = allCards.filter(c => c.style.display !== 'none');
            const total   = Math.ceil(visible.length / ITEMS_PER_PAGE) || 1;
            if (currentPage > total) currentPage = total;

            visible.forEach((c, i) => {
                c.style.visibility = (i >= (currentPage-1)*ITEMS_PER_PAGE &&
                                      i <  currentPage*ITEMS_PER_PAGE) ? '' : 'hidden';
                c.style.position   = (i >= (currentPage-1)*ITEMS_PER_PAGE &&
                                      i <  currentPage*ITEMS_PER_PAGE) ? '' : 'absolute';
            });

            document.getElementById('pageInfo').textContent =
                `صفحة ${currentPage} من ${total}`;
            document.getElementById('prevBtn').disabled = currentPage === 1;
            document.getElementById('nextBtn').disabled = currentPage === total;
        }

        function changePage(dir) {
            currentPage += dir;
            renderPage();
        }

        // ================================================
        //  SEARCH / FILTER
        // ================================================
        function filterSuppliers() {
            const q = document.getElementById('searchInput').value.toLowerCase().trim();
            allCards.forEach(c => {
                const name = c.dataset.name || '';
                c.style.display = name.includes(q) ? '' : 'none';
            });
            currentPage = 1;
            renderPage();
        }

        // ================================================
        //  ADD MODAL
        // ================================================
        function openAddModal() {
            document.getElementById('modalTitle').textContent = 'إضافة مورد جديد';
            document.getElementById('supplierId').value = '0';
            document.getElementById('supplierName').value = '';
            document.getElementById('supplierPhone').value = '';
            document.getElementById('supplierAddress').value = '';
            document.getElementById('supplierRC').value = '';
            document.getElementById('supplierNIF').value = '';
            document.getElementById('supplierAI').value = '';
            document.getElementById('supplierNIS').value = '';
            document.getElementById('supplierInitialDebt').value = '0';
            document.getElementById('supplierModal').classList.add('show');
        }

        function closeSupplierModal() {
            document.getElementById('supplierModal').classList.remove('show');
        }

        function closeModalOutside(e) {
            if (e.target.id === 'supplierModal') closeSupplierModal();
        }

        // ================================================
        //  EDIT MODAL
        // ================================================
               // تحديث openEditModal
        function openEditModal(id) {
            fetch(`/Suppliers/GetById/${id}`)
                .then(r => r.json())
                .then(data => {
                    document.getElementById('modalTitle').textContent
                        = 'تعديل بيانات المورد';
                    document.getElementById('supplierId').value
                        = data.id;
                    document.getElementById('supplierName').value
                        = data.name || '';
                    document.getElementById('supplierBusinessActivity').value
                        = data.businessActivity || '';
                    document.getElementById('supplierPhone').value
                        = data.phone || '';
                    document.getElementById('supplierPhone2').value
                        = data.phone2 || '';
                    document.getElementById('supplierEmail').value
                        = data.email || '';
                    document.getElementById('supplierAddress').value
                        = data.address || '';
                    document.getElementById('supplierCity').value
                        = data.city || '';
                    document.getElementById('supplierRC').value
                        = data.RC || '';
                    document.getElementById('supplierNIF').value
                        = data.NIF || '';
                    document.getElementById('supplierAI').value
                        = data.ai || '';
                    document.getElementById('supplierNIS').value
                        = data.nis || '';
                    document.getElementById('supplierBankName').value
                        = data.bankName || '';
                    document.getElementById('supplierBankAccount').value
                        = data.bankAccount || '';
                    document.getElementById('supplierInitialDebt').value
                        = data.initialDebt || 0;
                    document.getElementById('supplierIsActive').checked
                        = data.isActive;

                    document.getElementById('supplierModal').classList.add('show');
                });
        }

        // ================================================
        //  SAVE SUPPLIER
        // ================================================
               // تحديث saveSupplier
        function saveSupplier() {
            const id   = parseInt(document.getElementById('supplierId').value);
            const name = document.getElementById('supplierName').value.trim();

            if (!name) {
                alert('اسم المورد مطلوب!');
                document.getElementById('supplierName').focus();
                return;
            }

            const payload = {
                id:                 id,
                name:               name,
                businessActivity:   document.getElementById('supplierBusinessActivity').value.trim(),
                phone:              document.getElementById('supplierPhone').value.trim(),
                phone2:             document.getElementById('supplierPhone2').value.trim(),
                email:              document.getElementById('supplierEmail').value.trim(),
                address:            document.getElementById('supplierAddress').value.trim(),
                city:               document.getElementById('supplierCity').value.trim(),
                RC: document.getElementById('supplierRC').value.trim(),
                NIF:          document.getElementById('supplierNIF').value.trim(),
                ai:                 document.getElementById('supplierAI').value.trim(),
                nis:                document.getElementById('supplierNIS').value.trim(),
                bankName:           document.getElementById('supplierBankName').value.trim(),
                bankAccount:        document.getElementById('supplierBankAccount').value.trim(),
                initialDebt:        parseFloat(document.getElementById('supplierInitialDebt').value) || 0,
                isActive:           document.getElementById('supplierIsActive').checked
            };

            const url = id === 0 ? '/Suppliers/Create' : '/Suppliers/Edit';

            fetch(url, {
                method:  'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': getToken()
                },
                body: JSON.stringify(payload)
            })
            .then(r => r.json())
            .then(res => {
                if (res.success) {
                    closeSupplierModal();
                    location.reload();
                } else {
                    alert(res.message || 'حدث خطأ!');
                }
            })
            .catch(() => alert('تعذر الاتصال بالخادم!'));
        }

        // ================================================
        //  DELETE MODAL
        // ================================================
        let deleteTargetId = 0;

        function deleteSupplier(id, name) {
            deleteTargetId = id;
            document.getElementById('deleteSupplierName').textContent = name;
            document.getElementById('deleteModal').classList.add('show');
        }

        function closeDeleteModal() {
            document.getElementById('deleteModal').classList.remove('show');
        }

        function closeDeleteModalOutside(e) {
            if (e.target.id === 'deleteModal') closeDeleteModal();
        }

        function confirmDelete() {
            fetch(`/Suppliers/Delete/${deleteTargetId}`, {
                method: 'POST',
                headers: { 'RequestVerificationToken': getToken() }
            })
            .then(r => r.json())
            .then(res => {
                if (res.success) { closeDeleteModal(); location.reload(); }
                else alert(res.message || 'حدث خطأ أثناء الحذف!');
            });
        }

        // ================================================
        //  SUPPLIER FILE MODAL
        // ================================================
        function openSupplierFile(id) {
            fetch(`/Suppliers/GetFile/${id}`)
                .then(r => r.json())
                .then(data => {
                    // Header
                    document.getElementById('fileSupplierName').textContent =
                        'ملف المورد: ' + data.name;
                    document.getElementById('fileSupplierPhone').textContent =
                        'رقم الهاتف: ' + (data.phone || '---');
                    document.getElementById('fileSupplierID').textContent =
                        'ID: ' + data.id;
                    document.getElementById('fileSupplierAvatar').textContent =
                        data.name.substring(0,1).toUpperCase();

                    // Stats
                    document.getElementById('statTotalPurchases').textContent =
                        formatMoney(data.totalPurchases) + ' دج';
                    document.getElementById('statTotalPaid').textContent =
                        formatMoney(data.totalPaid) + ' دج';
                    document.getElementById('statTotalDebt').textContent =
                        formatMoney(data.totalDebt) + ' دج';

                    // Initial Debt
                    if (data.initialDebt > 0) {
                        document.getElementById('initialDebtBox').style.display = 'flex';
                        document.getElementById('initialDebtAmount').textContent =
                            formatMoney(data.initialDebt) + ' دج';
                        document.getElementById('initialDebtRemaining').textContent =
                            formatMoney(data.initialDebtRemaining) + ' دج';
                    } else {
                        document.getElementById('initialDebtBox').style.display = 'none';
                    }

                    // Invoices Table
                    const invBody = document.getElementById('invoicesTableBody');
                    invBody.innerHTML = '';
                    if (data.initialDebt > 0) {
                        invBody.innerHTML += `
                            <tr>
                                <td>
                                    <strong class="text-orange">الدين الابتدائي (ديون سابقة قبل بدء استخدام البرنامج)</strong>
                                    <br/><small class="text-muted">الرصيد الافتتاحي</small>
                                </td>
                                <td>${formatMoney(data.initialDebt)}</td>
                                <td class="text-teal">${formatMoney(data.initialDebt - data.initialDebtRemaining)}</td>
                                <td class="text-red">${formatMoney(data.initialDebtRemaining)}</td>
                            </tr>`;
                    }
                    if (data.invoices && data.invoices.length > 0) {
                        data.invoices.forEach(inv => {
                            invBody.innerHTML += `
                                <tr>
                                    <td>
                                        <strong>${inv.invoiceNumber}</strong>
                                        <br/><small class="text-muted">${inv.date}</small>
                                    </td>
                                    <td>${formatMoney(inv.total)}</td>
                                    <td class="text-teal">${formatMoney(inv.paid)}</td>
                                    <td class="${inv.remaining > 0 ? 'text-red' : 'text-teal'}">
                                        ${formatMoney(inv.remaining)}
                                    </td>
                                </tr>`;
                        });
                    } else if (data.initialDebt === 0) {
                        invBody.innerHTML = '<tr><td colspan="4" class="text-center text-muted py-3">لا توجد فواتير.</td></tr>';
                    }

                    // Payments Table
                    const payBody = document.getElementById('paymentsTableBody');
                    payBody.innerHTML = '';
                    if (data.payments && data.payments.length > 0) {
                        data.payments.forEach(p => {
                            payBody.innerHTML += `
                                <tr>
                                    <td>${p.date}</td>
                                    <td class="text-teal fw-bold">${formatMoney(p.amount)}</td>
                                    <td>${p.invoiceRef || '—'}</td>
                                </tr>`;
                        });
                    } else {
                        payBody.innerHTML = '<tr><td colspan="3" class="text-center text-muted py-3">لا يوجد سجل دفعات.</td></tr>';
                    }

                    // Payment date default
                    document.getElementById('paymentDate').value =
                        new Date().toISOString().split('T')[0];
                    document.getElementById('paymentAmount').value = '0.00';
                    document.getElementById('paymentAmount').dataset.supplierId = id;

                    document.getElementById('supplierFileModal').classList.add('show');
                });
        }

        function closeFileModal() {
            document.getElementById('supplierFileModal').classList.remove('show');
        }

        function closeFileModalOutside(e) {
            if (e.target.id === 'supplierFileModal') closeFileModal();
        }

        // ================================================
        //  CONFIRM PAYMENT
        // ================================================
        function confirmPayment() {
            const amount = parseFloat(document.getElementById('paymentAmount').value);
            const date   = document.getElementById('paymentDate').value;
            const suppId = parseInt(document.getElementById('paymentAmount').dataset.supplierId);

            if (!amount || amount <= 0) {
                alert('يرجى إدخال مبلغ صحيح!');
                return;
            }

            fetch('/Suppliers/Pay', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json',
                           'RequestVerificationToken': getToken() },
                body: JSON.stringify({ supplierId: suppId, amount: amount, date: date })
            })
            .then(r => r.json())
            .then(res => {
                if (res.success) { openSupplierFile(suppId); }
                else alert(res.message || 'حدث خطأ!');
            });
        }

        // ================================================
        //  HELPERS
        // ================================================
        function formatMoney(val) {
            return parseFloat(val || 0).toLocaleString('fr-DZ', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
        }

        function getToken() {
            const el = document.querySelector('input[name="__RequestVerificationToken"]');
            return el ? el.value : '';
        }
    </script>
}

