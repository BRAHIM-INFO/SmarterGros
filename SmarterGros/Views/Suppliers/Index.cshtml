@model IEnumerable<SmarterGros.Models.Supplier>
@{
    ViewData["Title"] = "الموردون";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div dir="rtl" class="suppliers-page">

    <!-- ===== PAGE HEADER ===== -->
    <div class="page-header">
        <h4 class="page-title">
            <i class="fas fa-truck me-2"></i> إدارة الموردين
        </h4>
        <button class="btn-add-supplier" onclick="openAddModal()">
            <i class="fas fa-user-plus me-2"></i>
            إضافة مورد جديد
        </button>
    </div>

    <!-- ===== SEARCH BAR ===== -->
    <div class="search-container">
        <div class="search-box">
            <i class="fas fa-search search-icon"></i>
            <input type="text"
                   id="searchInput"
                   class="search-input"
                   placeholder="البحث في أسماء الموردين..."
                   onkeyup="filterSuppliers()" />
        </div>
    </div>

    <!-- ===== SUPPLIERS LIST ===== -->
    <div class="suppliers-list" id="suppliersList">
        @if (Model != null && Model.Any())
        {
            @foreach (var supplier in Model)
            {
                <div class="supplier-card" data-name="@supplier.Name.ToLower()">

                    <!-- Right Color Bar -->
                    <div class="supplier-card-bar"></div>

                    <!-- Avatar -->
                    <div class="supplier-avatar-wrap">
                        <div class="supplier-avatar">
                            @supplier.Name.Substring(0, 1).ToUpper()
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="supplier-actions-top">
                        <button class="action-btn delete-btn"
                                onclick="deleteSupplier(@supplier.Id, '@supplier.Name')"
                                title="حذف">
                            <i class="fas fa-trash"></i>
                        </button>
                        <button class="action-btn edit-btn"
                                onclick="openEditModal(@supplier.Id)"
                                title="تعديل">
                            <i class="fas fa-pen"></i>
                        </button>
                    </div>

                    <!-- Info -->
                    <div class="supplier-info">
                        <h5 class="supplier-name">@supplier.Name</h5>
                        @if (!string.IsNullOrEmpty(supplier.Address))
                        {
                            <p class="supplier-address">
                                <i class="fas fa-map-marker-alt me-1"></i>
                                @supplier.Address
                            </p>
                        }
                    </div>

                    <!-- Details -->
                    <div class="supplier-details">
                        @if (!string.IsNullOrEmpty(supplier.Phone))
                        {
                            <div class="detail-row">
                                <span class="detail-label">رقم الهاتف</span>
                                <span class="detail-value">@supplier.Phone</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(supplier.NIF))
                        {
                            <div class="detail-row">
                                <span class="detail-label text-teal">NIF</span>
                                <span class="detail-value">@supplier.NIF</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(supplier.RC))
                        {
                            <div class="detail-row">
                                <span class="detail-label text-teal">RC</span>
                                <span class="detail-value">@supplier.RC</span>
                            </div>
                        }
                    </div>

                    <!-- View Button -->
                    <div class="supplier-footer">
                        <button class="btn-view-details"
                                onclick="openSupplierFile(@supplier.Id)">
                            <i class="fas fa-file-invoice me-2"></i>
                            عرض المشتريات والديون
                        </button>
                    </div>

                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-truck-loading"></i>
                <p>لا يوجد موردون مسجلون بعد</p>
                <button class="btn-add-supplier" onclick="openAddModal()">
                    <i class="fas fa-plus me-2"></i> إضافة أول مورد
                </button>
            </div>
        }
    </div>

    <!-- ===== PAGINATION ===== -->
    <div class="pagination-bar">
        <button class="page-btn" id="prevBtn" onclick="changePage(-1)">السابق</button>
        <span class="page-info" id="pageInfo">صفحة 1 من 1</span>
        <button class="page-btn" id="nextBtn" onclick="changePage(1)">التالي</button>
    </div>

</div>

<!-- ================================================================
     MODAL: إضافة / تعديل مورد
     ================================================================ -->
<div class="modal-overlay" id="supplierModal" onclick="closeModalOutside(event)">
    <div class="modal-box" id="supplierModalBox">

        <!-- Modal Header -->
        <div class="modal-header-custom">
            <h5 class="modal-title-custom" id="modalTitle">إضافة مورد جديد</h5>
            <button class="modal-close-btn" onclick="closeSupplierModal()">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <!-- استبدل modal body في Index.cshtml بهذا -->
        <div class="modal-body-custom">
            <form id="supplierForm">
                <input type="hidden" id="supplierId" value="0" />

                <!-- اسم المورد -->
                <div class="form-group-custom">
                    <label class="form-label-custom">
                        المورد / اسم الشركة <span class="text-danger">*</span>
                    </label>
                    <input type="text" id="supplierName"
                           class="form-input-custom" required />
                </div>

                <!-- النشاط التجاري -->
                <div class="form-group-custom">
                    <label class="form-label-custom">النشاط التجاري</label>
                    <input type="text" id="supplierBusinessActivity"
                           class="form-input-custom"
                           placeholder="مثال: مواد غذائية، إلكترونيات..." />
                </div>

                <!-- الهاتف والمدينة -->
                <div class="form-row-custom">
                    <div class="form-col-custom">
                        <label class="form-label-custom">رقم الهاتف الأساسي</label>
                        <input type="text" id="supplierPhone"
                               class="form-input-custom" />
                    </div>
                    <div class="form-col-custom">
                        <label class="form-label-custom">رقم الهاتف الثاني</label>
                        <input type="text" id="supplierPhone2"
                               class="form-input-custom" />
                    </div>
                </div>

                <!-- البريد والعنوان -->
                <div class="form-row-custom">
                    <div class="form-col-custom">
                        <label class="form-label-custom">البريد الإلكتروني</label>
                        <input type="email" id="supplierEmail"
                               class="form-input-custom" />
                    </div>
                    <div class="form-col-custom">
                        <label class="form-label-custom">المدينة</label>
                        <input type="text" id="supplierCity"
                               class="form-input-custom" />
                    </div>
                </div>

                <!-- العنوان كامل -->
                <div class="form-group-custom">
                    <label class="form-label-custom">العنوان والموقع</label>
                    <input type="text" id="supplierAddress"
                           class="form-input-custom" />
                </div>

                <!-- السجل التجاري والضريبي -->
                <div class="form-section-box">
                    <h6 class="form-section-title">
                        <i class="fas fa-file-alt me-2 text-teal"></i>
                        السجل التجاري والمعلومات الضريبية
                    </h6>
                    <div class="form-row-custom">
                        <div class="form-col-custom">
                            <label class="form-label-custom">RC (السجل التجاري)</label>
                            <input type="text" id="supplierRC"
                                   class="form-input-custom" />
                        </div>
                        <div class="form-col-custom">
                            <label class="form-label-custom">NIF (الرقم الجبائي)</label>
                            <input type="text" id="supplierNIF"
                                   class="form-input-custom" />
                        </div>
                    </div>
                    <div class="form-row-custom">
                        <div class="form-col-custom">
                            <label class="form-label-custom">AI (المادة الجبائية)</label>
                            <input type="text" id="supplierAI"
                                   class="form-input-custom" />
                        </div>
                        <div class="form-col-custom">
                            <label class="form-label-custom">NIS (رقم الإحصاء)</label>
                            <input type="text" id="supplierNIS"
                                   class="form-input-custom" />
                        </div>
                    </div>
                </div>

                <!-- المعلومات البنكية -->
                <div class="form-section-box">
                    <h6 class="form-section-title">
                        <i class="fas fa-university me-2 text-teal"></i>
                        المعلومات البنكية
                    </h6>
                    <div class="form-row-custom">
                        <div class="form-col-custom">
                            <label class="form-label-custom">اسم البنك</label>
                            <input type="text" id="supplierBankName"
                                   class="form-input-custom" />
                        </div>
                        <div class="form-col-custom">
                            <label class="form-label-custom">رقم الحساب البنكي</label>
                            <input type="text" id="supplierBankAccount"
                                   class="form-input-custom" />
                        </div>
                    </div>
                </div>

                <!-- الدين الابتدائي -->
                <div class="form-debt-box">
                    <label class="form-label-custom">
                        الدين الابتدائي
                        <small>(مبلغ تَدين به لهذا المورد قبل بدء استخدام البرنامج)</small>
                    </label>
                    <div class="debt-input-wrap">
                        <span class="currency-label">دج</span>
                        <input type="number" id="supplierInitialDebt"
                               class="form-input-custom debt-input"
                               value="0" min="0" step="0.01" />
                    </div>
                    <small class="debt-hint">
                        سيُضاف هذا المبلغ إلى دينك الإجمالي لهذا المورد.
                        اتركه 0 إذا لم يكن هناك دين سابق.
                    </small>
                </div>

                <!-- حالة المورد -->
                <div class="form-group-custom">
                    <label class="form-check-label-custom">
                        <input type="checkbox" id="supplierIsActive"
                               checked class="form-check-input me-2" />
                        المورد نشط
                    </label>
                </div>

                <!-- Footer Buttons -->
                <div class="modal-footer-custom">
                    <button type="button" class="btn-cancel"
                            onclick="closeSupplierModal()">
                        إلغاء
                    </button>
                    <button type="button" class="btn-save"
                            onclick="saveSupplier()">
                        <i class="fas fa-save me-2"></i>
                        حفظ المورد
                    </button>
                </div>
            </form>
        </div>
       @*  <!-- Modal Body -->
