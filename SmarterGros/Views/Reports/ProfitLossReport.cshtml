@model SmarterGros.ViewModels.Reports.ProfitLossReportViewModel

@{
    ViewData["Title"] = "تقرير الأرباح والخسائر";
    var culture = new System.Globalization.CultureInfo("ar-DZ");
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@@400;600;700;900&display=swap" rel="stylesheet">

    <style>
        body {
            background: #f5f7fa;
            font-family: 'Cairo', Arial, sans-serif;
        }

        .report-header {
            background: linear-gradient(135deg, #4facfe, #00f2fe);
            color: white;
            padding: 25px 30px;
            border-radius: 15px;
            margin-bottom: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 8px 25px rgba(79,172,254,0.3);
        }

            .report-header h1 {
                margin: 0;
                font-size: 1.6rem;
                font-weight: 800;
            }

            .report-header p {
                margin: 5px 0 0;
                opacity: 0.95;
            }

        .btn-print-custom {
            background: white;
            color: #4facfe;
            border: none;
            padding: 10px 20px;
            border-radius: 8px;
            font-weight: 700;
            text-decoration: none;
        }

        .btn-back-custom {
            background: rgba(255,255,255,0.2);
            color: white;
            border: 1px solid rgba(255,255,255,0.3);
            padding: 10px 20px;
            border-radius: 8px;
            font-weight: 700;
            text-decoration: none;
        }

        .filters-card {
            background: white;
            padding: 20px;
            border-radius: 15px;
            margin-bottom: 20px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.08);
        }

        /* البطاقات الرئيسية */
        .main-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
            margin-bottom: 25px;
        }

        .main-card {
            border-radius: 20px;
            padding: 25px;
            color: white;
            box-shadow: 0 8px 25px rgba(0,0,0,0.15);
            position: relative;
            overflow: hidden;
        }

            .main-card::before {
                content: '';
                position: absolute;
                top: -50px;
                left: -50px;
                width: 150px;
                height: 150px;
                background: rgba(255,255,255,0.1);
                border-radius: 50%;
            }

            .main-card .content {
                position: relative;
                z-index: 1;
            }

            .main-card .icon {
                font-size: 3rem;
                opacity: 0.9;
                margin-bottom: 10px;
            }

            .main-card .label {
                font-size: 1rem;
                opacity: 0.9;
                margin-bottom: 5px;
            }

            .main-card .value {
                font-size: 2rem;
                font-weight: 900;
                margin-bottom: 5px;
            }

                .main-card .value small {
                    font-size: 0.5em;
                    opacity: 0.9;
                }

            .main-card .meta {
                font-size: 0.85rem;
                opacity: 0.85;
            }

        .card-revenue {
            background: linear-gradient(135deg, #11998e, #38ef7d);
        }

        .card-expense {
            background: linear-gradient(135deg, #f5576c, #f093fb);
        }

        .card-profit {
            background: linear-gradient(135deg, #4facfe, #00f2fe);
        }

        .card-margin {
            background: linear-gradient(135deg, #fa709a, #fee140);
        }

        .growth-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 3px 10px;
            background: rgba(255,255,255,0.25);
            border-radius: 15px;
            font-size: 0.8rem;
            font-weight: 700;
            margin-top: 5px;
        }

        /* قسم البيان المالي */
        .financial-statement {
            background: white;
            border-radius: 15px;
            padding: 30px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.08);
            margin-bottom: 20px;
        }

        .statement-title {
            font-size: 1.4rem;
            font-weight: 800;
            color: #2c3e50;
            margin-bottom: 25px;
            padding-bottom: 15px;
            border-bottom: 3px solid #4facfe;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .statement-section {
            margin-bottom: 25px;
        }

        .section-title-bar {
            background: linear-gradient(135deg, #f8f9fa, #ffffff);
            padding: 12px 18px;
            border-right: 4px solid;
            border-radius: 8px;
            margin-bottom: 12px;
            font-weight: 800;
            color: #2c3e50;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .section-revenues {
            border-color: #11998e;
        }

        .section-expenses {
            border-color: #f5576c;
        }

        .section-net {
            border-color: #4facfe;
        }

        .section-title-bar .total {
            font-size: 1.1rem;
            font-weight: 900;
        }

        .section-revenues .total {
            color: #11998e;
        }

        .section-expenses .total {
            color: #f5576c;
        }

        .section-net .total {
            color: #4facfe;
        }

        .line-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 18px;
            border-bottom: 1px dashed #e9ecef;
            font-size: 0.95rem;
        }

            .line-item:last-child {
                border-bottom: none;
            }

            .line-item .label {
                color: #495057;
                display: flex;
                align-items: center;
                gap: 8px;
            }

            .line-item .amount {
                font-weight: 700;
                color: #2c3e50;
            }

            .line-item.gross {
                background: #e8f5e9;
                border: 2px solid #11998e;
                border-radius: 8px;
                margin-top: 10px;
                padding: 12px 18px;
                font-weight: 800;
            }

                .line-item.gross .label,
                .line-item.gross .amount {
                    color: #11998e;
                    font-size: 1.1rem;
                }

            .line-item.net-profit {
                background: linear-gradient(135deg, #4facfe, #00f2fe);
                color: white;
                border-radius: 12px;
                margin-top: 15px;
                padding: 20px;
                font-size: 1.3rem;
                font-weight: 900;
            }

                .line-item.net-profit .label,
                .line-item.net-profit .amount {
                    color: white;
                }

            .line-item.net-loss {
                background: linear-gradient(135deg, #f5576c, #f093fb);
                color: white;
                border-radius: 12px;
                margin-top: 15px;
                padding: 20px;
                font-size: 1.3rem;
                font-weight: 900;
            }

                .line-item.net-loss .label,
                .line-item.net-loss .amount {
                    color: white;
                }

        /* الرسوم البيانية */
        .section-card {
            background: white;
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 20px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.08);
        }

            .section-card h3 {
                font-size: 1.2rem;
                font-weight: 800;
                color: #2c3e50;
                margin-bottom: 20px;
                padding-bottom: 15px;
                border-bottom: 2px solid #f0f0f0;
                display: flex;
                align-items: center;
                gap: 10px;
            }

                .section-card h3 i {
                    color: #4facfe;
                }

        .chart-container {
            position: relative;
            height: 300px;
        }

        /* قائمة المصاريف */
        .expense-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .expense-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px;
            border-radius: 10px;
            margin-bottom: 8px;
            background: #f8f9fa;
            transition: all 0.2s;
        }

            .expense-item:hover {
                background: white;
                box-shadow: 0 3px 10px rgba(0,0,0,0.08);
                transform: translateX(-3px);
            }

        .expense-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.1rem;
        }

        .expense-info {
            flex: 1;
        }

        .expense-name {
            font-weight: 700;
            color: #2c3e50;
        }

        .expense-percentage {
            font-size: 0.75rem;
            color: #6c757d;
        }

        .expense-amount {
            font-weight: 900;
            color: #f5576c;
        }

        .progress-bar-mini {
            height: 4px;
            background: #e9ecef;
            border-radius: 2px;
            margin-top: 5px;
            overflow: hidden;
        }

        .progress-bar-mini-fill {
            height: 100%;
            border-radius: 2px;
            transition: width 0.5s;
        }

        @@media print {
            body {
                background: white;
            }

            .no-print {
                display: none !important;
            }
        }
    </style>

    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
}

<!-- الترويسة -->
<div class="report-header">
    <div>
        <h1><i class="fas fa-chart-line"></i> تقرير الأرباح والخسائر</h1>
        <p><i class="fas fa-calendar"></i> @Model.PeriodLabel</p>
    </div>
    <div class="d-flex gap-2 no-print">
        <a href="@Url.Action("PrintProfitLossReport", new { dateFrom = Model.DateFrom, dateTo = Model.DateTo })" target="_blank" class="btn-print-custom">
            <i class="fas fa-print"></i> طباعة
        </a>
        <a href="@Url.Action("Index")" class="btn-back-custom">
            <i class="fas fa-arrow-right"></i> العودة
        </a>
    </div>
</div>

<!-- الفلاتر -->
<div class="filters-card no-print">
    <form method="get" action="@Url.Action("ProfitLossReport")">
        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label fw-bold small">من تاريخ</label>
                <input type="date" name="dateFrom" value="@Model.DateFrom.ToString("yyyy-MM-dd")" class="form-control" required />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-bold small">إلى تاريخ</label>
                <input type="date" name="dateTo" value="@Model.DateTo.ToString("yyyy-MM-dd")" class="form-control" required />
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-search"></i> عرض التقرير
                </button>
            </div>
        </div>
    </form>
</div>

<!-- البطاقات الرئيسية -->
<div class="main-cards">
    <div class="main-card card-revenue">
        <div class="content">
            <div class="icon"><i class="fas fa-arrow-down"></i></div>
            <div class="label">إجمالي الإيرادات</div>
            <div class="value">@Model.TotalRevenues.ToString("N0", culture) <small>دج</small></div>
            <div class="meta">المبيعات + الإيرادات الأخرى</div>
        </div>
    </div>

    <div class="main-card card-expense">
        <div class="content">
            <div class="icon"><i class="fas fa-arrow-up"></i></div>
            <div class="label">إجمالي المصاريف</div>
            <div class="value">@Model.TotalExpenses.ToString("N0", culture) <small>دج</small></div>
            <div class="meta">التكلفة + المصاريف التشغيلية</div>
        </div>
    </div>

    <div class="main-card card-profit">
        <div class="content">
            <div class="icon"><i class="fas fa-chart-line"></i></div>
            <div class="label">صافي الربح</div>
            <div class="value">@Model.NetProfit.ToString("N0", culture) <small>دج</small></div>
            @if (Model.ProfitGrowthPercent != 0)
            {
                <div class="growth-badge">
                    <i class="fas fa-arrow-@(Model.ProfitGrowthPercent > 0 ? "up" : "down")"></i>
                    @Math.Abs(Model.ProfitGrowthPercent)% عن السابق
                </div>
            }
        </div>
    </div>

    <div class="main-card card-margin">
        <div class="content">
            <div class="icon"><i class="fas fa-percentage"></i></div>
            <div class="label">هامش الربح الصافي</div>
            <div class="value">@Model.NetProfitMargin%</div>
            <div class="meta">إجمالي: @Model.GrossProfitMargin%</div>
        </div>
    </div>
</div>

<!-- البيان المالي -->
<div class="financial-statement">
    <div class="statement-title">
        <i class="fas fa-file-invoice-dollar"></i>
        <span>قائمة الدخل التفصيلية</span>
    </div>

    <!-- الإيرادات -->
    <div class="statement-section">
        <div class="section-title-bar section-revenues">
            <span><i class="fas fa-arrow-circle-down text-success"></i> الإيرادات (Revenues)</span>
            <span class="total">@Model.TotalRevenues.ToString("N0", culture) دج</span>
        </div>

        <div class="line-item">
            <span class="label">💰 إيرادات المبيعات</span>
            <span class="amount">@Model.SalesRevenue.ToString("N0", culture) دج</span>
        </div>

        @if (Model.OtherIncome > 0)
        {
            <div class="line-item">
                <span class="label">📈 إيرادات أخرى</span>
                <span class="amount">@Model.OtherIncome.ToString("N0", culture) دج</span>
            </div>
        }
    </div>

    <!-- المصاريف -->
    <div class="statement-section">
        <div class="section-title-bar section-expenses">
            <span><i class="fas fa-arrow-circle-up text-danger"></i> المصاريف (Expenses)</span>
            <span class="total">@Model.TotalExpenses.ToString("N0", culture) دج</span>
        </div>

        <div class="line-item">
            <span class="label">📦 تكلفة البضاعة المباعة</span>
            <span class="amount">@Model.CostOfGoodsSold.ToString("N0", culture) دج</span>
        </div>

        <!-- الربح الإجمالي -->
        <div class="line-item gross">
            <span class="label">🎯 الربح الإجمالي (Gross Profit)</span>
            <span class="amount">@Model.GrossProfit.ToString("N0", culture) دج (@Model.GrossProfitMargin%)</span>
        </div>

        @if (Model.Electricity > 0)
        {
            <div class="line-item">
                <span class="label">⚡ كهرباء</span>
                <span class="amount">@Model.Electricity.ToString("N0", culture) دج</span>
            </div>
        }

        @if (Model.Water > 0)
        {
            <div class="line-item">
                <span class="label">💧 ماء</span>
                <span class="amount">@Model.Water.ToString("N0", culture) دج</span>
            </div>
        }

        @if (Model.Communications > 0)
        {
            <div class="line-item">
                <span class="label">📞 اتصالات وإنترنت</span>
                <span class="amount">@Model.Communications.ToString("N0", culture) دج</span>
            </div>
        }

        @if (Model.Rent > 0)
        {
            <div class="line-item">
                <span class="label">🏠 إيجار</span>
                <span class="amount">@Model.Rent.ToString("N0", culture) دج</span>
            </div>
        }

        @if (Model.Salaries > 0)
        {
            <div class="line-item">
                <span class="label">👔 رواتب وأجور</span>
                <span class="amount">@Model.Salaries.ToString("N0", culture) دج</span>
            </div>
        }

        @if (Model.Transportation > 0)
        {
            <div class="line-item">
                <span class="label">🚚 نقل ومواصلات</span>
                <span class="amount">@Model.Transportation.ToString("N0", culture) دج</span>
            </div>
        }

        @if (Model.Maintenance > 0)
        {
            <div class="line-item">
                <span class="label">🔧 صيانة</span>
                <span class="amount">@Model.Maintenance.ToString("N0", culture) دج</span>
            </div>
        }

        @if (Model.Taxes > 0)
        {
            <div class="line-item">
                <span class="label">📄 ضرائب</span>
                <span class="amount">@Model.Taxes.ToString("N0", culture) دج</span>
            </div>
        }

        @if (Model.OtherExpenses > 0)
        {
            <div class="line-item">
                <span class="label">➕ مصاريف أخرى</span>
                <span class="amount">@Model.OtherExpenses.ToString("N0", culture) دج</span>
            </div>
        }
    </div>

    <!-- صافي الربح / الخسارة -->
    <div class="line-item @(Model.NetProfit >= 0 ? "net-profit" : "net-loss")">
        <span class="label">
            @if (Model.NetProfit >= 0)
            {
                <span>💰 صافي الربح</span>
            }
            else
            {
                <span>📉 صافي الخسارة</span>
            }
            (Net @(Model.NetProfit >= 0 ? "Profit" : "Loss"))
        </span>
        <span class="amount">
            @Model.NetProfit.ToString("N0", culture) دج
            (@Model.NetProfitMargin%)
        </span>
    </div>
</div>

<!-- الرسوم البيانية -->
<div class="row g-3">
    <div class="col-lg-7">
        <div class="section-card">
            <h3><i class="fas fa-chart-area"></i> الإيرادات vs المصاريف (يومياً)</h3>
            <div class="chart-container">
                <canvas id="dailyChart"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="section-card">
            <h3><i class="fas fa-list"></i> تفصيل المصاريف</h3>
            @if (Model.ExpenseBreakdown.Any())
            {
                <ul class="expense-list">
                    @foreach (var expense in Model.ExpenseBreakdown)
                    {
                        <li class="expense-item">
                            <div class="expense-icon" style="background: @expense.Color;">
                                <i class="fas @expense.Icon"></i>
                            </div>
                            <div class="expense-info">
                                <div class="expense-name">@expense.Category</div>
                                <div class="expense-percentage">@expense.Percentage% من إجمالي المصاريف</div>
                                <div class="progress-bar-mini">
                                    <div class="progress-bar-mini-fill" style="width: @expense.Percentage%; background: @expense.Color;"></div>
                                </div>
                            </div>
                            <div class="expense-amount">@expense.Amount.ToString("N0", culture)</div>
                        </li>
                    }
                </ul>
            }
            else
            {
                <div class="text-center text-muted py-4">
                    <i class="fas fa-inbox fa-3x mb-2 opacity-50"></i>
                    <p>لا توجد مصاريف</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const ctx = document.getElementById('dailyChart').getContext('2d');
        new Chart(ctx, {
            type: 'line',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.DailyData.Select(d => d.DateLabel))),
                datasets: [
                    {
                        label: '💚 الإيرادات',
                        data: @Html.Raw(Json.Serialize(Model.DailyData.Select(d => d.Revenue))),
                        borderColor: '#11998e',
                        backgroundColor: 'rgba(17,153,142,0.1)',
                        borderWidth: 3,
                        fill: true,
                        tension: 0.4
                    },
                    {
                        label: '🔴 المصاريف',
                        data: @Html.Raw(Json.Serialize(Model.DailyData.Select(d => d.Expenses))),
                        borderColor: '#f5576c',
                        backgroundColor: 'rgba(245,87,108,0.1)',
                        borderWidth: 3,
                        fill: true,
                        tension: 0.4
                    },
                    {
                        label: '💰 صافي الربح',
                        data: @Html.Raw(Json.Serialize(Model.DailyData.Select(d => d.NetProfit))),
                        borderColor: '#4facfe',
                        backgroundColor: 'rgba(79,172,254,0.2)',
                        borderWidth: 3,
                        fill: false,
                        borderDash: [5, 5]
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'top', labels: { font: { family: 'Cairo', size: 13 } } }
                },
                scales: {
                    y: { beginAtZero: true, ticks: { font: { family: 'Cairo' } } },
                    x: { ticks: { font: { family: 'Cairo' } } }
                }
            }
        });
    </script>
}