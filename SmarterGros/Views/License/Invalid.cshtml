@{
    Layout = null;
    ViewData["Title"] = "تنبيه!";
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>تنبيه - SmarterGros</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@@400;600;700;900&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Cairo', Arial, sans-serif;
            background: linear-gradient(135deg, #f5576c, #f093fb);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            margin: 0;
        }

        .alert-card {
            background: white;
            border-radius: 20px;
            padding: 40px;
            max-width: 500px;
            text-align: center;
            box-shadow: 0 25px 60px rgba(0,0,0,0.3);
        }

        .alert-icon {
            font-size: 5rem;
            color: #f5576c;
            margin-bottom: 20px;
        }

        h1 {
            color: #2c3e50;
            font-weight: 900;
            margin-bottom: 15px;
        }

        p {
            color: #6c757d;
            margin-bottom: 10px;
        }

        .contact-info {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 10px;
            margin: 20px 0;
        }
    </style>
</head>
<body>
    <div class="alert-card">
        <i class="fas fa-exclamation-triangle alert-icon"></i>
        <h1>⚠️ تنبيه أمني</h1>
        <p>تم اكتشاف محاولة تلاعب بتاريخ النظام!</p>
        <p>الرجاء تصحيح التاريخ والوقت في جهازك</p>

        <div class="contact-info">
            <strong>للمساعدة:</strong>
            <p>📞 0551 73 52 94</p>
            <p>📱 واتساب: 0790 05 86 77</p>
        </div>

        <button onclick="location.reload()" class="btn btn-primary" style="background: #4facfe; color: white; border: none; padding: 12px 30px; border-radius: 10px; font-weight: 700; cursor: pointer;">
            <i class="fas fa-redo"></i> إعادة المحاولة
        </button>
    </div>
</body>
</html>