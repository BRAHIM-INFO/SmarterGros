@{
    Layout = null;
    ViewData["Title"] = "تفعيل الترخيص";
    var remainingDays = (int)(ViewBag.RemainingDays ?? 0);
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>تفعيل الترخيص - SmarterGros</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@@400;600;700;900&display=swap" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Cairo', Arial, sans-serif;
            background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .activate-card {
            background: white;
            border-radius: 25px;
            padding: 40px;
            max-width: 650px;
            width: 100%;
            box-shadow: 0 25px 60px rgba(0,0,0,0.3);
            text-align: center;
        }

        .icon-wrapper {
            width: 100px;
            height: 100px;
            margin: 0 auto 20px;
            background: linear-gradient(135deg, #4facfe, #00f2fe);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 10px 30px rgba(79,172,254,0.4);
        }

            .icon-wrapper i {
                font-size: 3rem;
                color: white;
            }

        h1 {
            color: #2c3e50;
            font-weight: 900;
            margin-bottom: 10px;
        }

        .trial-info {
            background: linear-gradient(135deg, #11998e, #38ef7d);
            color: white;
            padding: 20px;
            border-radius: 15px;
            margin: 20px 0;
        }

            .trial-info .days {
                font-size: 3rem;
                font-weight: 900;
                margin: 10px 0;
            }

        .hw-id-section {
            background: #f8f9fa;
            border: 2px dashed #4facfe;
            border-radius: 12px;
            padding: 20px;
            margin: 20px 0;
        }

        .hw-id-value {
            font-family: 'Courier New', monospace;
            font-size: 1.3rem;
            font-weight: 900;
            color: #4facfe;
            letter-spacing: 2px;
            user-select: all;
        }

        .btn-copy {
            background: #4facfe;
            color: white;
            border: none;
            padding: 8px 20px;
            border-radius: 20px;
            font-weight: 700;
            cursor: pointer;
            margin-top: 10px;
            font-family: inherit;
        }

        .activation-section {
            margin: 25px 0;
        }

        .form-control-custom {
            width: 100%;
            padding: 18px;
            font-size: 1.2rem;
            font-weight: 700;
            text-align: center;
            border: 3px solid #e9ecef;
            border-radius: 12px;
            font-family: 'Courier New', monospace;
            letter-spacing: 2px;
        }

            .form-control-custom:focus {
                outline: none;
                border-color: #4facfe;
            }

        .btn-activate {
            background: linear-gradient(135deg, #11998e, #38ef7d);
            color: white;
            border: none;
            padding: 15px 40px;
            border-radius: 12px;
            font-weight: 800;
            font-size: 1.1rem;
            cursor: pointer;
            margin-top: 15px;
            font-family: inherit;
        }

        .btn-continue {
            background: #6c757d;
            color: white;
            border: none;
            padding: 12px 30px;
            border-radius: 10px;
            font-weight: 600;
            margin-top: 10px;
            text-decoration: none;
            display: inline-block;
            font-family: inherit;
        }

        .alert-msg {
            padding: 12px;
            border-radius: 8px;
            margin: 15px 0;
            display: none;
            font-weight: 600;
        }

            .alert-msg.success {
                background: #d4edda;
                color: #155724;
            }

            .alert-msg.error {
                background: #f8d7da;
                color: #721c24;
            }

        .contact-quick {
            display: flex;
            gap: 15px;
            justify-content: center;
            margin-top: 20px;
        }

        .contact-link {
            color: #4facfe;
            text-decoration: none;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 5px;
        }
    </style>
</head>
<body>

    <div class="activate-card">
        <div class="icon-wrapper">
            <i class="fas fa-key"></i>
        </div>

        <h1>🔑 تفعيل الترخيص</h1>
        <p class="text-muted">قم بإدخال مفتاح التفعيل أو استمر في الفترة التجريبية</p>

        @if (remainingDays > 0)
        {
            <div class="trial-info">
                <div>⏰ متبقي من الفترة التجريبية</div>
                <div class="days">@remainingDays</div>
                <div>يوم</div>
            </div>
        }

        <div class="hw-id-section">
            <div style="color: #6c757d; margin-bottom: 8px;">
                <i class="fas fa-key"></i> رقم جهازك:
            </div>
            <div class="hw-id-value" id="hardwareId" style="font-size: 1.1rem; word-break: break-all;">@ViewBag.FullHardwareId</div>            
            <button class="btn-copy" onclick="copyHardwareId()">
                <i class="fas fa-copy"></i> نسخ
            </button>
        </div>

        <div class="activation-section">

            <!-- ✅ Form يرسل البيانات إلى ActivateKey -->
            <form id="activationForm" method="post" action="/License/ActivateKey">
                @Html.AntiForgeryToken()

                <div class="input-wrapper">
                    <label for="ActivationKey" class="input-label">
                        🔑 مفتاح التفعيل
                    </label>
                    <textarea name="activationKey"
                              id="ActivationKey"
                              maxlength="300"
                              class="form-control activation-input"
                              placeholder="SMARTERGROS-XXXX-XXXX-XXXX-..."
                              rows="3"
                              spellcheck="false"
                              autocomplete="off"
                              required></textarea>
                    <small class="input-hint">
                        💡 الصق المفتاح كاملاً بدون حذف أي جزء
                    </small>
                </div>

                <div id="alertMsg" class="alert-msg"></div>

                <button type="submit" class="btn-activate" id="activateBtn">
                    <i class="fas fa-check-circle"></i> تفعيل الترخيص
                </button>
            </form>

            <div style="margin-top: 15px;">
                <a href="/Dashboard" class="btn-continue">
                    <i class="fas fa-arrow-left"></i> متابعة التجربة
                </a>
            </div>
        </div>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- 🎨 الأنماط -->
        <!-- ═══════════════════════════════════════════════════ -->
        <style>
            .input-wrapper {
                margin-bottom: 15px;
            }

            .input-label {
                display: block;
                font-weight: 600;
                margin-bottom: 8px;
                color: #333;
                font-size: 14px;
            }

            .activation-input {
                width: 100%;
                padding: 12px 15px;
                font-family: 'Courier New', Consolas, monospace !important;
                font-size: 13px !important;
                text-transform: uppercase;
                letter-spacing: 1px;
                line-height: 1.6;
                border: 2px solid #e0e0e0;
                border-radius: 8px;
                resize: vertical;
                min-height: 90px;
                background: #f9f9f9;
                color: #2e7d32;
                font-weight: bold;
                transition: all 0.3s ease;
                word-break: break-all;
                overflow-wrap: break-word;
                white-space: pre-wrap;
                box-sizing: border-box;
                direction: ltr;
                text-align: left;
            }

                .activation-input:focus {
                    outline: none;
                    border-color: #4caf50;
                    background: white;
                    box-shadow: 0 0 0 3px rgba(76, 175, 80, 0.1);
                }

            .input-hint {
                display: block;
                margin-top: 6px;
                font-size: 12px;
                color: #757575;
            }

            .alert-msg {
                display: none;
                padding: 12px 16px;
                margin: 12px 0;
                border-radius: 8px;
                font-size: 14px;
                font-weight: 500;
                white-space: pre-line;
            }

            .alert-success {
                background: #d4edda;
                color: #155724;
                border: 1px solid #c3e6cb;
                display: block !important;
            }

            .alert-error {
                background: #f8d7da;
                color: #721c24;
                border: 1px solid #f5c6cb;
                display: block !important;
            }

            .alert-warning {
                background: #fff3cd;
                color: #856404;
                border: 1px solid #ffeaa7;
                display: block !important;
            }
        </style>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- 🧹 JavaScript -->
        <!-- ═══════════════════════════════════════════════════ -->
        <script>
            // عرض Hardware ID الكامل عند فتح الصفحة
            window.addEventListener('load', function() {
                fetch('/License/GetHardwareInfo')
                    .then(r => r.json())
                    .then(data => {
                        // تحديث العرض في الصفحة
                        var hwElement = document.getElementById('hardwareId');
                        if (hwElement) {
                            hwElement.textContent = data.fullHardwareId;
                        }

                        // عرض MessageBox
                        alert('🔑 رقم جهازك الفريد (Hardware ID):\n\n' + data.fullHardwareId + '\n\n📋 انسخه وأرسله للمبرمج للحصول على مفتاح التفعيل');
                    });
            });

            function copyHwId() {
                fetch('/License/GetHardwareInfo')
                    .then(r => r.json())
                    .then(data => {
                        navigator.clipboard.writeText(data.fullHardwareId).then(() => {
                            alert('✅ تم نسخ الرقم الكامل!\n\n' + data.fullHardwareId);
                        });
                    });
            }
            (function () {
                'use strict';

                console.log('✅ License activation script loaded');

                const keyInput = document.getElementById('ActivationKey');
                const form = document.getElementById('activationForm');
                const btn = document.getElementById('activateBtn');
                const alertMsg = document.getElementById('alertMsg');

                if (!keyInput || !form || !btn) {
                    console.error('❌ عناصر الصفحة غير موجودة!');
                    return;
                }

                // ✅ تنظيف المفتاح عند اللصق
                keyInput.addEventListener('paste', function (e) {
                    e.preventDefault();
                    const pastedText = (e.clipboardData || window.clipboardData).getData('text');
                    const cleaned = pastedText.trim().replace(/\s+/g, '').toUpperCase();
                    this.value = cleaned;
                    console.log('📋 Pasted key length:', cleaned.length);
                });

                // ✅ تنظيف عند الكتابة
                keyInput.addEventListener('input', function () {
                    const cleaned = this.value.replace(/\s+/g, '').toUpperCase();
                    if (this.value !== cleaned) {
                        const pos = this.selectionStart;
                        this.value = cleaned;
                        this.setSelectionRange(pos, pos);
                    }
                });

                // ✅ معالجة إرسال النموذج
                form.addEventListener('submit', async function (e) {
                    e.preventDefault();
                    console.log('🚀 Form submitted');

                    const activationKey = keyInput.value.trim().replace(/\s+/g, '').toUpperCase();

                    console.log('🔑 Key:', activationKey);
                    console.log('📏 Length:', activationKey.length);

                    // ─── التحقق من المفتاح ───
                    if (!activationKey) {
                        showAlert('⚠️ يرجى إدخال مفتاح التفعيل', 'warning');
                        return;
                    }

                    if (activationKey.length < 50) {
                        showAlert(`⚠️ المفتاح قصير جداً (${activationKey.length} حرف)\nتأكد من نسخه كاملاً`, 'warning');
                        return;
                    }

                    // ─── إظهار حالة التحميل ───
                    btn.disabled = true;
                    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري التفعيل...';

                    try {
                        // ─── الحصول على Anti-Forgery Token ───
                        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                        console.log('🔐 Token found:', token ? 'Yes' : 'No');

                        // ─── إرسال الطلب ───
                        const formData = new FormData();
                        formData.append('activationKey', activationKey);
                        if (token) {
                            formData.append('__RequestVerificationToken', token);
                        }

                        // ✅ المسار الصحيح: /License/ActivateKey
                        console.log('📤 Sending request to /License/ActivateKey');

                        const response = await fetch('/License/ActivateKey', {
                            method: 'POST',
                            body: formData,
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest'
                            }
                        });

                        console.log('📥 Response status:', response.status);

                        if (!response.ok) {
                            throw new Error(`HTTP ${response.status}: ${response.statusText}`);
                        }

                        const result = await response.json();
                        console.log('✅ Result:', result);

                        if (result.success) {
                            showAlert(result.message || '✅ تم التفعيل بنجاح!', 'success');

                            // ─── تحويل بعد ثانيتين ───
                            setTimeout(() => {
                                const redirectUrl = result.redirectUrl || '/Dashboard';
                                console.log('🔀 Redirecting to:', redirectUrl);
                                window.location.href = redirectUrl;
                            }, 2000);
                        } else {
                            showAlert(result.message || '❌ فشل التفعيل', 'error');
                        }

                    } catch (error) {
                        console.error('❌ Error:', error);
                        showAlert('❌ حدث خطأ: ' + error.message, 'error');
                    } finally {
                        btn.disabled = false;
                        btn.innerHTML = '<i class="fas fa-check-circle"></i> تفعيل الترخيص';
                    }
                });

                function showAlert(message, type) {
                    alertMsg.textContent = message;
                    alertMsg.className = 'alert-msg alert-' + type;
                    console.log(`[${type.toUpperCase()}]`, message);

                    // ─── تمرير لرؤية الرسالة ───
                    alertMsg.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }

                console.log('✅ Event listeners attached successfully');
            })();
        </script>
        <div class="contact-quick">
            <a href="tel:0551735294" class="contact-link">
                <i class="fas fa-phone"></i> 0551735294
            </a>
            <a href="https://wa.me/213790058677" target="_blank" class="contact-link">
                <i class="fab fa-whatsapp"></i> واتساب
            </a>
        </div>
    </div>

    @Html.AntiForgeryToken()

    <script>
        function copyHardwareId() {
            const hwId = document.getElementById('hardwareId').textContent;
            navigator.clipboard.writeText(hwId).then(() => {
                alert('✅ تم النسخ!');
            });
        }

        function activateLicense() {
            const key = document.getElementById('activationKey').value.trim();
            const alertMsg = document.getElementById('alertMsg');
            const btn = document.getElementById('activateBtn');

            if (!key) {
                showAlert('error', '❌ يرجى إدخال مفتاح التفعيل');
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري التفعيل...';

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            const formData = new FormData();
            formData.append('activationKey', key);
            formData.append('__RequestVerificationToken', token);

            fetch('@Url.Action("ActivateKey", "License")', {
                method: 'POST',
                body: formData
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    showAlert('success', data.message);
                    setTimeout(() => {
                        window.location.href = data.redirectUrl || '/';
                    }, 2000);
                } else {
                    showAlert('error', data.message);
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-check-circle"></i> تفعيل الترخيص';
                }
            });
        }

        function showAlert(type, message) {
            const alertMsg = document.getElementById('alertMsg');
            alertMsg.className = 'alert-msg ' + type;
            alertMsg.textContent = message;
            alertMsg.style.display = 'block';
        }

        document.getElementById('activationKey').addEventListener('input', function(e) {
            this.value = this.value.toUpperCase();
        });

        document.getElementById('activationKey').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                activateLicense();
            }
        });
    </script>

</body>
</html>