@{
    Layout = null;
    ViewData["Title"] = "انتهت الفترة التجريبية";
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>انتهت الفترة التجريبية - SmarterGros</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@@400;600;700;900&display=swap" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Cairo', Arial, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .expired-card {
            background: white;
            border-radius: 25px;
            padding: 50px;
            max-width: 700px;
            width: 100%;
            box-shadow: 0 25px 60px rgba(0,0,0,0.3);
            text-align: center;
            animation: fadeInUp 0.6s ease;
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .expired-icon {
            width: 120px;
            height: 120px;
            margin: 0 auto 25px;
            background: linear-gradient(135deg, #f5576c, #f093fb);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 10px 30px rgba(245,87,108,0.4);
            animation: pulse 2s infinite;
        }

        @@keyframes pulse {
            0%, 100% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.05);
            }
        }

        .expired-icon i {
            font-size: 4rem;
            color: white;
        }

        h1 {
            font-size: 2rem;
            color: #2c3e50;
            font-weight: 900;
            margin-bottom: 10px;
        }

        .subtitle {
            color: #6c757d;
            font-size: 1.1rem;
            margin-bottom: 30px;
        }

        .hw-id-section {
            background: linear-gradient(135deg, #f8f9fa, #ffffff);
            border: 2px dashed #667eea;
            border-radius: 15px;
            padding: 25px;
            margin: 25px 0;
        }

            .hw-id-section .label {
                color: #6c757d;
                font-size: 0.9rem;
                margin-bottom: 8px;
                font-weight: 600;
            }

        .hw-id-value {
            font-family: 'Courier New', monospace;
            font-size: 1.4rem;
            font-weight: 900;
            color: #667eea;
            letter-spacing: 2px;
            margin: 10px 0;
            user-select: all;
        }

        .btn-copy {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            border: none;
            padding: 10px 25px;
            border-radius: 25px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s;
            font-family: inherit;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

            .btn-copy:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(102,126,234,0.4);
            }

        .contact-section {
            background: linear-gradient(135deg, #11998e, #38ef7d);
            color: white;
            padding: 30px;
            border-radius: 15px;
            margin: 25px 0;
        }

            .contact-section h3 {
                font-size: 1.3rem;
                margin-bottom: 20px;
                font-weight: 800;
            }

        .contact-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
        }

        .contact-item {
            background: rgba(255,255,255,0.2);
            padding: 12px;
            border-radius: 10px;
            backdrop-filter: blur(10px);
        }

            .contact-item i {
                font-size: 1.5rem;
                margin-bottom: 5px;
            }

            .contact-item .label {
                font-size: 0.75rem;
                opacity: 0.9;
                margin-bottom: 3px;
            }

            .contact-item .value {
                font-weight: 700;
                font-size: 0.95rem;
                direction: ltr;
            }

        .activation-section {
            margin: 25px 0;
        }

        .form-control-custom {
            width: 100%;
            padding: 18px 20px;
            font-size: 1.2rem;
            font-weight: 700;
            text-align: center;
            border: 3px solid #e9ecef;
            border-radius: 12px;
            font-family: 'Courier New', monospace;
            letter-spacing: 2px;
            transition: all 0.3s;
        }

            .form-control-custom:focus {
                outline: none;
                border-color: #667eea;
                box-shadow: 0 0 0 0.25rem rgba(102,126,234,0.25);
            }

        .btn-activate {
            background: linear-gradient(135deg, #11998e, #38ef7d);
            color: white;
            border: none;
            padding: 15px 40px;
            border-radius: 12px;
            font-weight: 800;
            font-size: 1.1rem;
            cursor: pointer;
            transition: all 0.3s;
            margin-top: 15px;
            font-family: inherit;
        }

            .btn-activate:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(17,153,142,0.4);
            }

            .btn-activate:disabled {
                background: #6c757d;
                cursor: not-allowed;
                transform: none;
            }

        .price-badge {
            display: inline-block;
            background: linear-gradient(135deg, #fa709a, #fee140);
            color: white;
            padding: 8px 20px;
            border-radius: 25px;
            font-weight: 800;
            font-size: 1.1rem;
            margin: 10px;
        }

        .footer-text {
            color: #6c757d;
            font-size: 0.85rem;
            margin-top: 25px;
            padding-top: 25px;
            border-top: 1px solid #e9ecef;
        }

        .alert-msg {
            padding: 12px;
            border-radius: 8px;
            margin: 15px 0;
            display: none;
            font-weight: 600;
        }

            .alert-msg.success {
                background: #d4edda;
                color: #155724;
                border: 1px solid #c3e6cb;
            }

            .alert-msg.error {
                background: #f8d7da;
                color: #721c24;
                border: 1px solid #f5c6cb;
            }

        .copied-tooltip {
            position: fixed;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            background: #28a745;
            color: white;
            padding: 12px 25px;
            border-radius: 25px;
            font-weight: 700;
            display: none;
            z-index: 9999;
            animation: fadeInDown 0.3s ease;
        }

        @@keyframes fadeInDown {
            from {
                opacity: 0;
                transform: translate(-50%, -20px);
            }

            to {
                opacity: 1;
                transform: translate(-50%, 0);
            }
        }
    </style>
</head>
<body>

    <div class="expired-card">
        <!-- الأيقونة -->
        <div class="expired-icon">
            <i class="fas fa-clock"></i>
        </div>

        <!-- العنوان -->
        <h1>⏰ انتهت الفترة التجريبية</h1>
        <p class="subtitle">شكراً لاستخدامك SmarterGros خلال الفترة التجريبية</p>

        <!-- السعر -->
        <div>
            <span class="price-badge">💰 35,000 دج للنسخة الكاملة</span>
            <span class="price-badge" style="background: linear-gradient(135deg, #4facfe, #00f2fe);">
                ♾️ ترخيص دائم
            </span>
        </div>

        <!-- Hardware ID -->
        <div class="hw-id-section">
            <div class="label">
                <i class="fas fa-key"></i> رقم جهازك الفريد (Hardware ID):
            </div>
            <div class="hw-id-value" id="hardwareId" style="font-size: 1.1rem; word-break: break-all;">@ViewBag.FullHardwareId</div>
            <button class="btn-copy" onclick="copyHardwareId()">
                <i class="fas fa-copy"></i> نسخ الرقم
            </button>
            <p class="text-muted mt-2 mb-0" style="font-size: 0.85rem;">
                💡 أرسل هذا الرقم للمبرمج للحصول على مفتاح التفعيل
            </p>
        </div>

        <!-- معلومات التواصل -->
        <div class="contact-section">
            <h3><i class="fas fa-headset"></i> تواصل مع المبرمج</h3>

            <div class="contact-grid">
                <div class="contact-item">
                    <i class="fas fa-user"></i>
                    <div class="label">المطور</div>
                    <div class="value">بن يونس إبراهيم</div>
                </div>

                <div class="contact-item">
                    <i class="fas fa-building"></i>
                    <div class="label">الشركة</div>
                    <div class="value">إبداع سوفت</div>
                </div>

                <div class="contact-item">
                    <i class="fas fa-phone"></i>
                    <div class="label">الهاتف</div>
                    <div class="value">0551 73 52 94</div>
                </div>

                <div class="contact-item">
                    <i class="fab fa-whatsapp"></i>
                    <div class="label">واتساب</div>
                    <div class="value">0790 05 86 77</div>
                </div>

                <div class="contact-item">
                    <i class="fas fa-envelope"></i>
                    <div class="label">الإيميل</div>
                    <div class="value" style="font-size: 0.8rem;">Benyounesibrahiminfo@Gmail.com</div>
                </div>

                <div class="contact-item">
                    <i class="fas fa-map-marker-alt"></i>
                    <div class="label">المدينة</div>
                    <div class="value">المسيلة - الجزائر</div>
                </div>
            </div>
        </div>

        <!-- التفعيل -->
        <div class="activation-section">
            <h3 style="color: #2c3e50; margin-bottom: 15px;">
                <i class="fas fa-key"></i> أدخل مفتاح التفعيل
            </h3>

            <input type="text" id="activationKey" class="form-control-custom"
                   placeholder="SmarterGros-XXXX-XXXX-XXXX-XXXX"
                   maxlength="40" />

            <div id="alertMsg" class="alert-msg"></div>

            <button class="btn-activate" onclick="activateLicense()" id="activateBtn">
                <i class="fas fa-check-circle"></i> تفعيل الترخيص
            </button>
        </div>

        <!-- الفوتر -->
        <div class="footer-text">
            <p>🌟 SmarterGros - نظام تسيير المخزون الاحترافي</p>
            <p>© 2026 إبداع سوفت - جميع الحقوق محفوظة</p>
        </div>
    </div>

    <!-- Tooltip النسخ -->
    <div id="copiedTooltip" class="copied-tooltip">
        <i class="fas fa-check"></i> تم النسخ بنجاح!
    </div>

    @Html.AntiForgeryToken()

    <script>
        // نسخ Hardware ID
        function copyHardwareId() {
            const hwId = document.getElementById('hardwareId').textContent;
            navigator.clipboard.writeText(hwId).then(() => {
                showCopiedTooltip();
            });
        }

        function showCopiedTooltip() {
            const tooltip = document.getElementById('copiedTooltip');
            tooltip.style.display = 'block';
            setTimeout(() => {
                tooltip.style.display = 'none';
            }, 2000);
        }

        // تفعيل الترخيص
        function activateLicense() {
            const key = document.getElementById('activationKey').value.trim();
            const alertMsg = document.getElementById('alertMsg');
            const btn = document.getElementById('activateBtn');

            if (!key) {
                showAlert('error', '❌ يرجى إدخال مفتاح التفعيل');
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري التفعيل...';

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            const formData = new FormData();
            formData.append('activationKey', key);
            formData.append('__RequestVerificationToken', token);

            fetch('@Url.Action("ActivateKey", "License")', {
                method: 'POST',
                body: formData
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    showAlert('success', data.message);
                    setTimeout(() => {
                        window.location.href = data.redirectUrl || '/';
                    }, 2000);
                } else {
                    showAlert('error', data.message);
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-check-circle"></i> تفعيل الترخيص';
                }
            })
            .catch(err => {
                showAlert('error', '❌ حدث خطأ في الاتصال');
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-check-circle"></i> تفعيل الترخيص';
            });
        }

        function showAlert(type, message) {
            const alertMsg = document.getElementById('alertMsg');
            alertMsg.className = 'alert-msg ' + type;
            alertMsg.textContent = message;
            alertMsg.style.display = 'block';
        }

        // Enter للتفعيل
        document.getElementById('activationKey').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                activateLicense();
            }
        });

        // تحويل تلقائي للأحرف الكبيرة
        document.getElementById('activationKey').addEventListener('input', function(e) {
            this.value = this.value.toUpperCase();
        });
    </script>

</body>
</html>