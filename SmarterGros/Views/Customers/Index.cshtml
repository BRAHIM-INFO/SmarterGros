@model IEnumerable<SmarterGros.Models.Customer>
@{
    ViewData["Title"] = "العملاء";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div dir="rtl" class="customers-page">

    <!-- ===== PAGE HEADER ===== -->
    <div class="page-header">
        <h4 class="page-title">
            <i class="fas fa-truck me-2"></i> إدارة العملاء
        </h4>
        <button class="btn-add-customer" onclick="openAddModal()">
            <i class="fas fa-user-plus me-2"></i>
            إضافة عميل جديد
        </button>
    </div>

    <!-- ===== SEARCH BAR ===== -->
    <div class="search-container">
        <div class="search-box">
            <i class="fas fa-search search-icon"></i>
            <input type="text"
                   id="searchInput"
                   class="search-input"
                   placeholder="البحث في أسماء العملاء..."
                   onkeyup="filterCustomers()" />
        </div>
    </div>

    <!-- ===== customerS LIST ===== -->
    <div class="customers-list" id="customersList">
        @if (Model != null && Model.Any())
        {
            @foreach (var customer in Model)
            {
                <div class="customer-card" data-name="@customer.Name.ToLower()">

                    <!-- Right Color Bar -->
                    <div class="customer-card-bar"></div>

                    <!-- Avatar -->
                    <div class="customer-avatar-wrap">
                        <div class="customer-avatar">
                            @customer.Name.Substring(0, 1).ToUpper()
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="customer-actions-top">
                        <button class="action-btn delete-btn"
                                onclick="deleteCustomer(@customer.Id, '@customer.Name')"
                                title="حذف">
                            <i class="fas fa-trash"></i>
                        </button>
                        <button class="action-btn edit-btn"
                                onclick="openEditModal(@customer.Id)"
                                title="تعديل">
                            <i class="fas fa-pen"></i>
                        </button>
                    </div>

                    <!-- Info -->
                    <div class="customer-info">
                        <h5 class="customer-name">@customer.Name</h5>
                        @if (!string.IsNullOrEmpty(customer.Address))
                        {
                            <p class="customer-address">
                                <i class="fas fa-map-marker-alt me-1"></i>
                                @customer.Address
                            </p>
                        }
                    </div>

                    <!-- Details -->
                    <div class="customer-details">
                        @if (!string.IsNullOrEmpty(customer.Phone))
                        {
                            <div class="detail-row">
                                <span class="detail-label">رقم الهاتف</span>
                                <span class="detail-value">@customer.Phone</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(customer.NIF))
                        {
                            <div class="detail-row">
                                <span class="detail-label text-teal">NIF</span>
                                <span class="detail-value">@customer.NIF</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(customer.RC))
                        {
                            <div class="detail-row">
                                <span class="detail-label text-teal">RC</span>
                                <span class="detail-value">@customer.RC</span>
                            </div>
                        }
                    </div>

                    <!-- View Button -->
                    <div class="customer-footer">
                        <button class="btn-view-details"
                                onclick="openCustomerFile(@customer.Id)">
                            <i class="fas fa-file-invoice me-2"></i>
                            عرض المبيعات والديون
                        </button>
                    </div>

                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-truck-loading"></i>
                <p>لا يوجد عملاء مسجلون بعد</p>
                <button class="btn-add-customer" onclick="openAddModal()">
                    <i class="fas fa-plus me-2"></i> إضافة أول عميل
                </button>
            </div>
        }
    </div>

    <!-- ===== PAGINATION ===== -->
    <div class="pagination-bar">
        <button class="page-btn" id="prevBtn" onclick="changePage(-1)">السابق</button>
        <span class="page-info" id="pageInfo">صفحة 1 من 1</span>
        <button class="page-btn" id="nextBtn" onclick="changePage(1)">التالي</button>
    </div>

</div>

<!-- ================================================================
     MODAL: إضافة / تعديل عميل
     ================================================================ -->
<div class="modal-overlay" id="customerModal" onclick="closeModalOutside(event)">
    <div class="modal-box" id="customerModalBox">

        <!-- Modal Header -->
        <div class="modal-header-custom">
            <h5 class="modal-title-custom" id="modalTitle">إضافة عميل جديد</h5>
            <button class="modal-close-btn" onclick="closeCustomerModal()">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <!-- استبدل modal body في Index.cshtml بهذا -->
        <div class="modal-body-custom">
            <form id="customerForm">
                <input type="hidden" id="customerId" value="0" />

                <!-- اسم العميل -->
                <div class="form-group-custom">
                    <label class="form-label-custom">
                        العميل / اسم الشركة <span class="text-danger">*</span>
                    </label>
                    <input type="text" id="customerName"
                           class="form-input-custom" required />
                </div>

                <!-- النشاط التجاري -->
                <div class="form-group-custom">
                    <label class="form-label-custom">النشاط التجاري</label>
                    <input type="text" id="customerBusinessActivity"
                           class="form-input-custom"
                           placeholder="مثال: مواد غذائية، إلكترونيات..." />
                </div>

                <!-- الهاتف والمدينة -->
                <div class="form-row-custom">
                    <div class="form-col-custom">
                        <label class="form-label-custom">رقم الهاتف الأساسي</label>
                        <input type="text" id="customerPhone"
                               class="form-input-custom" />
                    </div>
                    <div class="form-col-custom">
                        <label class="form-label-custom">رقم الهاتف الثاني</label>
                        <input type="text" id="customerPhone2"
                               class="form-input-custom" />
                    </div>
                </div>

                <!-- البريد والعنوان -->
                <div class="form-row-custom">
                    <div class="form-col-custom">
                        <label class="form-label-custom">البريد الإلكتروني</label>
                        <input type="email" id="customerEmail"
                               class="form-input-custom" />
                    </div>
                    <div class="form-col-custom">
                        <label class="form-label-custom">المدينة</label>
                        <input type="text" id="customerCity"
                               class="form-input-custom" />
                    </div>
                </div>

                <!-- العنوان كامل -->
                <div class="form-group-custom">
                    <label class="form-label-custom">العنوان والموقع</label>
                    <input type="text" id="customerAddress"
                           class="form-input-custom" />
                </div>

                <!-- السجل التجاري والضريبي -->
                <div class="form-section-box">
                    <h6 class="form-section-title">
                        <i class="fas fa-file-alt me-2 text-teal"></i>
                        السجل التجاري والمعلومات الضريبية
                    </h6>
                    <div class="form-row-custom">
                        <div class="form-col-custom">
                            <label class="form-label-custom">RC (السجل التجاري)</label>
                            <input type="text" id="customerRC"
                                   class="form-input-custom" />
                        </div>
                        <div class="form-col-custom">
                            <label class="form-label-custom">NIF (الرقم الجبائي)</label>
                            <input type="text" id="customerNIF"
                                   class="form-input-custom" />
                        </div>
                    </div>
                    <div class="form-row-custom">
                        <div class="form-col-custom">
                            <label class="form-label-custom">AI (المادة الجبائية)</label>
                            <input type="text" id="customerAI"
                                   class="form-input-custom" />
                        </div>
                        <div class="form-col-custom">
                            <label class="form-label-custom">NIS (رقم الإحصاء)</label>
                            <input type="text" id="customerNIS"
                                   class="form-input-custom" />
                        </div>
                    </div>
                </div>

                <!-- المعلومات البنكية -->
                <div class="form-section-box">
                    <h6 class="form-section-title">
                        <i class="fas fa-university me-2 text-teal"></i>
                        المعلومات البنكية
                    </h6>
                    <div class="form-row-custom">
                        <div class="form-col-custom">
                            <label class="form-label-custom">اسم البنك</label>
                            <input type="text" id="customerBankName"
                                   class="form-input-custom" />
                        </div>
                        <div class="form-col-custom">
                            <label class="form-label-custom">رقم الحساب البنكي</label>
                            <input type="text" id="customerBankAccount"
                                   class="form-input-custom" />
                        </div>
                    </div>
                </div>

                <!-- الدين الابتدائي -->
                <div class="form-debt-box">
                    <label class="form-label-custom">
                        الدين الابتدائي
                        <small>(مبلغ تَدين به لهذا العميل قبل بدء استخدام البرنامج)</small>
                    </label>
                    <div class="debt-input-wrap">
                        <span class="currency-label">دج</span>
                        <input type="number" id="customerInitialDebt"
                               class="form-input-custom debt-input"
                               value="0" min="0" step="0.01" />
                    </div>
                    <small class="debt-hint">
                        سيُضاف هذا المبلغ إلى دينك الإجمالي لهذا العميل.
                        اتركه 0 إذا لم يكن هناك دين سابق.
                    </small>
                </div>

                <!-- حالة العميل -->
                <div class="form-group-custom">
                    <label class="form-check-label-custom">
                        <input type="checkbox" id="customerIsActive"
                               checked class="form-check-input me-2" />
                        العميل نشط
                    </label>
                </div>

                <!-- Footer Buttons -->
                <div class="modal-footer-custom">
                    <button type="button" class="btn-cancel"
                            onclick="closecustomerModal()">
                        إلغاء
                    </button>
                    <button type="button" class="btn-save"
                            onclick="savecustomer()">
                        <i class="fas fa-save me-2"></i>
                        حفظ العميل
                    </button>
                </div>
            </form>
        </div> 
    </div>
</div>

<!-- ================================================================
     MODAL: ملف العميل (المشتريات والديون)
     ================================================================ -->
<div class="modal-overlay" id="customerFileModal" onclick="closeFileModalOutside(event)">
    <div class="modal-box modal-box-lg" id="customerFileModalBox">

        <!-- Modal Header -->
        <div class="modal-header-custom file-header">
            <div class="file-header-info">
                <h5 class="modal-title-custom" id="filecustomerName">ملف العميل: ---</h5>
                <div class="file-header-sub">
                    <span id="filecustomerPhone">رقم الهاتف: ---</span>
                    <span id="filecustomerID">ID: ---</span>
                </div>
            </div>
            <div class="file-header-left">
                <div class="file-avatar" id="filecustomerAvatar">؟</div>
                <button class="modal-close-btn" onclick="closeFileModal()">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        </div>

        <!-- Stats Row -->
        <div class="file-stats-row">
            <div class="file-stat-card stat-purchases">
                <span class="stat-label">إجمالي المبيعات من هذا العميل</span>
                <span class="stat-value green" id="statTotalPurchases">0.00 دج</span>
            </div>
            <div class="file-stat-card stat-paid">
                <span class="stat-label">إجمالي المدفوعات</span>
                <span class="stat-value green" id="statTotalPaid">0.00 دج</span>
            </div>
            <div class="file-stat-card stat-debt">
                <span class="stat-label">الديون المستحقة للعميل</span>
                <span class="stat-value red" id="statTotalDebt">0.00 دج</span>
                <div class="stat-debt-bar"></div>
            </div>
        </div>

        <!-- Initial Debt Box -->
        <div class="initial-debt-box" id="initialDebtBox" style="display:none">
            <div class="initial-debt-right">
                <h6 class="initial-debt-title">الدين الابتدائي للعميل</h6>
                <p class="initial-debt-sub">
                    الدين الابتدائي (ديون سابقة قبل بدء استخدام البرنامج):
                    <span id="initialDebtAmount" class="text-orange fw-bold">0.00 دج</span>
                </p>
            </div>
            <div class="initial-debt-left">
                <span class="initial-debt-badge-label">الدين الابتدائي (الباقي)</span>
                <span class="initial-debt-value" id="initialDebtRemaining">0.00 دج</span>
            </div>
        </div>

        <!-- Payment Section -->
        <div class="payment-section">
            <h6 class="payment-title">
                <i class="fas fa-cash-register me-2"></i>
                تسديد دفعة للعميل
            </h6>
            <div class="payment-form-row">
                <button class="btn-confirm-payment" onclick="confirmPayment()">
                    <i class="fas fa-check-circle me-2"></i>
                    تأكيد التسديد
                </button>
                <div class="payment-field">
                    <label>التاريخ</label>
                    <input type="date" id="paymentDate" class="payment-input"
                           value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                </div>
                <div class="payment-field flex-1">
                    <label>المبلغ المدفوع</label>
                    <input type="number" id="paymentAmount"
                           class="payment-input payment-amount"
                           value="0.00" min="0" step="0.01" />
                </div>
            </div>
            <small class="payment-note">
                يُسدَّد الدين الابتدائي أولاً ثم الفواتير الأقدم فالأحدث.
            </small>
        </div>

        <!-- Tables Row -->
        <div class="file-tables-row">

            <!-- Invoices Table -->
            <div class="file-table-wrap">
                <h6 class="table-title">
                    <i class="fas fa-file-invoice me-2 text-teal"></i>
                    فواتير المبيعات
                </h6>
                <div class="table-responsive">
                    <table class="file-table">
                        <thead>
                            <tr>
                                <th>رقم الفاتورة / التاريخ</th>
                                <th>الإجمالي</th>
                                <th>المدفوع</th>
                                <th class="text-red">المتبقي (الديون)</th>
                            </tr>
                        </thead>
                        <tbody id="invoicesTableBody">
                            <tr>
                                <td colspan="4" class="text-center text-muted py-3">
                                    لا توجد فواتير.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Payments Table -->
            <div class="file-table-wrap">
                <h6 class="table-title">
                    <i class="fas fa-history me-2 text-teal"></i>
                    سجل الدفعات المتراكمة
                </h6>
                <div class="table-responsive">
                    <table class="file-table">
                        <thead>
                            <tr>
                                <th>التاريخ</th>
                                <th>المبلغ المدفوع</th>
                                <th>رقم الفاتورة المرتبطة</th>
                            </tr>
                        </thead>
                        <tbody id="paymentsTableBody">
                            <tr>
                                <td colspan="3" class="text-center text-muted py-3">
                                    لا يوجد سجل دفعات.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- ================================================================
     DELETE CONFIRM MODAL
     ================================================================ -->
<div class="modal-overlay" id="deleteModal" onclick="closeDeleteModalOutside(event)">
    <div class="modal-box modal-box-sm">
        <div class="modal-header-custom">
            <h5 class="modal-title-custom text-danger">
                <i class="fas fa-exclamation-triangle me-2"></i>
                تأكيد الحذف
            </h5>
            <button class="modal-close-btn" onclick="closeDeleteModal()">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="modal-body-custom text-center py-4">
            <p class="mb-1">هل أنت متأكد من حذف العميل:</p>
            <h5 class="text-danger fw-bold" id="deletecustomerName">---</h5>
            <p class="text-muted small mt-2">لا يمكن التراجع عن هذا الإجراء.</p>
        </div>
        <div class="modal-footer-custom justify-content-center gap-3">
            <button class="btn-cancel" onclick="closeDeleteModal()">إلغاء</button>
            <button class="btn-delete-confirm" onclick="confirmDelete()">
                <i class="fas fa-trash me-2"></i> حذف
            </button>
        </div>
    </div>
</div>

@section Styles {
    <style>

        /* ==============================
                   GLOBAL
                   ============================== */
        .customers-page {
            font-family: 'Tajawal', sans-serif;
        }

        /* ==============================
                   PAGE HEADER
                   ============================== */
        .page-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
        }

        .page-title {
            font-size: 1.6rem;
            font-weight: 700;
            color: #1a3a2a;
            margin: 0;
        }

        .btn-add-customer {
            background: #3b5bdb;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            transition: all 0.2s;
            font-family: 'Tajawal', sans-serif;
        }

            .btn-add-customer:hover {
                background: #2f4ac5;
                transform: translateY(-1px);
                box-shadow: 0 4px 14px rgba(59,91,219,0.35);
            }

        /* ==============================
                   SEARCH
                   ============================== */
        .search-container {
            background: white;
            border-radius: 12px;
            border: 1px solid #e5e7eb;
            padding: 14px 16px;
            margin-bottom: 20px;
            box-shadow: 0 1px 6px rgba(0,0,0,0.04);
        }

        .search-box {
            display: flex;
            align-items: center;
            gap: 10px;
            justify-content: flex-end;
        }

        .search-icon {
            color: #9ca3af;
            font-size: 16px;
        }

        .search-input {
            border: none;
            outline: none;
            font-size: 14px;
            font-family: 'Tajawal', sans-serif;
            color: #374151;
            background: transparent;
            width: 100%;
            text-align: right;
        }

            .search-input::placeholder {
                color: #9ca3af;
            }

        /* ==============================
                   customer CARD
                   ============================== */
        .customers-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-bottom: 20px;
        }

        .customer-card {
            background: white;
            border-radius: 12px;
            border: 1px solid #e9ecef;
            padding: 18px 18px 18px 22px;
            position: relative;
            overflow: hidden;
            box-shadow: 0 1px 6px rgba(0,0,0,0.04);
            transition: box-shadow 0.2s;
            display: grid;
            grid-template-columns: auto 1fr auto;
            grid-template-rows: auto auto auto;
            gap: 8px 14px;
        }

            .customer-card:hover {
                box-shadow: 0 4px 18px rgba(0,0,0,0.09);
            }

        /* Right Color Bar */
        .customer-card-bar {
            position: absolute;
            right: 0;
            top: 0;
            bottom: 0;
            width: 5px;
            background: #1a8a5c;
            border-radius: 0 12px 12px 0;
        }

        /* Avatar */
        .customer-avatar-wrap {
            grid-column: 3;
            grid-row: 1 / 3;
            display: flex;
            align-items: flex-start;
            padding-top: 2px;
        }

        .customer-avatar {
            width: 52px;
            height: 52px;
            background: #e8f5ee;
            color: #1a8a5c;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            font-weight: 700;
        }

        /* Actions Top */
        .customer-actions-top {
            grid-column: 3;
            grid-row: 1;
            display: flex;
            gap: 6px;
            justify-content: flex-end;
            align-items: center;
        }

        /* Re-layout with absolute positioning for cleaner look */
        .customer-card {
            display: block;
            padding: 16px 70px 16px 16px;
        }

        .customer-avatar-wrap {
            position: absolute;
            top: 16px;
            left: 16px;
        }

        .customer-actions-top {
            position: absolute;
            top: 16px;
            left: 76px;
            display: flex;
            gap: 6px;
        }

        .action-btn {
            width: 34px;
            height: 34px;
            border-radius: 8px;
            border: 1px solid #e5e7eb;
            background: white;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            transition: all 0.2s;
            color: #6b7280;
        }

            .action-btn:hover {
                background: #f3f4f6;
            }

        .delete-btn:hover {
            color: #ef4444;
            border-color: #fca5a5;
            background: #fef2f2;
        }

        .edit-btn:hover {
            color: #3b82f6;
            border-color: #93c5fd;
            background: #eff6ff;
        }

        /* Info */
        .customer-info {
            margin-bottom: 10px;
        }

        .customer-name {
            font-size: 16px;
            font-weight: 700;
            color: #111827;
            margin-bottom: 3px;
            text-align: right;
        }

        .customer-address {
            font-size: 13px;
            color: #6b7280;
            margin: 0;
            text-align: right;
        }

        /* Details */
        .customer-details {
            display: flex;
            flex-direction: column;
            gap: 5px;
            margin-bottom: 14px;
        }

        .detail-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 13.5px;
        }

        .detail-label {
            color: #6b7280;
        }

            .detail-label.text-teal {
                color: #1a8a5c;
                font-weight: 600;
            }

        .detail-value {
            font-weight: 600;
            color: #111827;
            direction: ltr;
        }

        /* Footer */
        .customer-footer {
            text-align: right;
        }

        .btn-view-details {
            background: #e8f5ee;
            color: #1a8a5c;
            border: 1px solid #a7f3d0;
            padding: 9px 18px;
            border-radius: 9px;
            font-size: 13.5px;
            font-weight: 600;
            cursor: pointer;
            font-family: 'Tajawal', sans-serif;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
        }

            .btn-view-details:hover {
                background: #1a8a5c;
                color: white;
                transform: translateY(-1px);
            }

        /* ==============================
                   PAGINATION
                   ============================== */
        .pagination-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: white;
            border-radius: 10px;
            border: 1px solid #e5e7eb;
            padding: 12px 20px;
        }

        .page-btn {
            background: transparent;
            border: none;
            color: #6b7280;
