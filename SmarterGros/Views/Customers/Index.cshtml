@section Scripts {
    <script>
        // ================================================
        //  PAGINATION
        // ================================================
        const ITEMS_PER_PAGE = 10;
        let currentPage = 1;
        let allCards = [];

        document.addEventListener('DOMContentLoaded', () => {
            allCards = Array.from(document.querySelectorAll('.customer-card'));
            renderPage();
        });

        function renderPage() {
            const visible = allCards.filter(c => c.style.display !== 'none');
            const total   = Math.ceil(visible.length / ITEMS_PER_PAGE) || 1;
            if (currentPage > total) currentPage = total;

            visible.forEach((c, i) => {
                c.style.visibility = (i >= (currentPage-1)*ITEMS_PER_PAGE &&
                                      i <  currentPage*ITEMS_PER_PAGE) ? '' : 'hidden';
                c.style.position   = (i >= (currentPage-1)*ITEMS_PER_PAGE &&
                                      i <  currentPage*ITEMS_PER_PAGE) ? '' : 'absolute';
            });

            document.getElementById('pageInfo').textContent =
                `صفحة ${currentPage} من ${total}`;
            document.getElementById('prevBtn').disabled = currentPage === 1;
            document.getElementById('nextBtn').disabled = currentPage === total;
        }

        function changePage(dir) {
            currentPage += dir;
            renderPage();
        }

        // ================================================
        //  SEARCH / FILTER
        // ================================================
        function filtercustomers() {
            const q = document.getElementById('searchInput').value.toLowerCase().trim();
            allCards.forEach(c => {
                const name = c.dataset.name || '';
                c.style.display = name.includes(q) ? '' : 'none';
            });
            currentPage = 1;
            renderPage();
        }

        // ================================================
        //  ADD MODAL
        // ================================================
        function openAddModal() {
            document.getElementById('modalTitle').textContent = 'إضافة عميل جديد';
            document.getElementById('customerId').value = '0';
            document.getElementById('customerName').value = '';
            document.getElementById('customerPhone').value = '';
            document.getElementById('customerAddress').value = '';
            document.getElementById('customerRC').value = '';
            document.getElementById('customerNIF').value = '';
            document.getElementById('customerAI').value = '';
            document.getElementById('customerNIS').value = '';
            document.getElementById('customerInitialDebt').value = '0';
            document.getElementById('customerModal').classList.add('show');
        }

        function closecustomerModal() {
            document.getElementById('customerModal').classList.remove('show');
        }

        function closeModalOutside(e) {
            if (e.target.id === 'customerModal') closecustomerModal();
        }

        // ================================================
        //  EDIT MODAL
        // ================================================
               // تحديث openEditModal
        function openEditModal(id) {
            fetch(`/customers/GetById/${id}`)
                .then(r => r.json())
                .then(data => {
                    document.getElementById('modalTitle').textContent
                        = 'تعديل بيانات العميل';
                    document.getElementById('customerId').value
                        = data.id;
                    document.getElementById('customerName').value
                        = data.name || '';
                    document.getElementById('customerBusinessActivity').value
                        = data.businessActivity || '';
                    document.getElementById('customerPhone').value
                        = data.phone || '';
                    document.getElementById('customerPhone2').value
                        = data.phone2 || '';
                    document.getElementById('customerEmail').value
                        = data.email || '';
                    document.getElementById('customerAddress').value
                        = data.address || '';
                    document.getElementById('customerCity').value
                        = data.city || '';
                    document.getElementById('customerRC').value
                        = data.RC || '';
                    document.getElementById('customerNIF').value
                        = data.NIF || '';
                    document.getElementById('customerAI').value
                        = data.ai || '';
                    document.getElementById('customerNIS').value
                        = data.nis || '';
                    document.getElementById('customerBankName').value
                        = data.bankName || '';
                    document.getElementById('customerBankAccount').value
                        = data.bankAccount || '';
                    document.getElementById('customerInitialDebt').value
                        = data.initialDebt || 0;
                    document.getElementById('customerIsActive').checked
                        = data.isActive;

                    document.getElementById('customerModal').classList.add('show');
                });
        }

        // ================================================
        //  SAVE customer
        // ================================================
               // تحديث savecustomer
        function savecustomer() {
            const id   = parseInt(document.getElementById('customerId').value);
            const name = document.getElementById('customerName').value.trim();

            if (!name) {
                alert('اسم العميل مطلوب!');
                document.getElementById('customerName').focus();
                return;
            }

            const payload = {
                id:                 id,
                name:               name,
                businessActivity:   document.getElementById('customerBusinessActivity').value.trim(),
                phone:              document.getElementById('customerPhone').value.trim(),
                phone2:             document.getElementById('customerPhone2').value.trim(),
                email:              document.getElementById('customerEmail').value.trim(),
                address:            document.getElementById('customerAddress').value.trim(),
                city:               document.getElementById('customerCity').value.trim(),
                RC: document.getElementById('customerRC').value.trim(),
                NIF:          document.getElementById('customerNIF').value.trim(),
                ai:                 document.getElementById('customerAI').value.trim(),
                nis:                document.getElementById('customerNIS').value.trim(),
                bankName:           document.getElementById('customerBankName').value.trim(),
                bankAccount:        document.getElementById('customerBankAccount').value.trim(),
                initialDebt:        parseFloat(document.getElementById('customerInitialDebt').value) || 0,
                isActive:           document.getElementById('customerIsActive').checked
            };

            const url = id === 0 ? '/customers/Create' : '/customers/Edit';

            fetch(url, {
                method:  'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': getToken()
                },
                body: JSON.stringify(payload)
            })
            .then(r => r.json())
            .then(res => {
                if (res.success) {
                    closecustomerModal();
                    location.reload();
                } else {
                    alert(res.message || 'حدث خطأ!');
                }
            })
            .catch(() => alert('تعذر الاتصال بالخادم!'));
        }

        // ================================================
        //  DELETE MODAL
        // ================================================
        let deleteTargetId = 0;

        function deletecustomer(id, name) {
            deleteTargetId = id;
            document.getElementById('deletecustomerName').textContent = name;
            document.getElementById('deleteModal').classList.add('show');
        }

        function closeDeleteModal() {
            document.getElementById('deleteModal').classList.remove('show');
        }

        function closeDeleteModalOutside(e) {
            if (e.target.id === 'deleteModal') closeDeleteModal();
        }

        function confirmDelete() {
            fetch(`/customers/Delete/${deleteTargetId}`, {
                method: 'POST',
                headers: { 'RequestVerificationToken': getToken() }
            })
            .then(r => r.json())
            .then(res => {
                if (res.success) { closeDeleteModal(); location.reload(); }
                else alert(res.message || 'حدث خطأ أثناء الحذف!');
            });
        }

        // ================================================
        //  customer FILE MODAL
        // ================================================
        function openCustomerFile(id) {
            fetch(`/customers/GetFile/${id}`)
                .then(r => r.json())
                .then(data => {
                    // Header
                    document.getElementById('filecustomerName').textContent =
                        'ملف العميل: ' + data.name;
                    document.getElementById('filecustomerPhone').textContent =
                        'رقم الهاتف: ' + (data.phone || '---');
                    document.getElementById('filecustomerID').textContent =
                        'ID: ' + data.id;
                    document.getElementById('filecustomerAvatar').textContent =
                        data.name.substring(0,1).toUpperCase();

                    // Stats
                    document.getElementById('statTotalPurchases').textContent =
                        formatMoney(data.totalPurchases) + ' دج';
                    document.getElementById('statTotalPaid').textContent =
                        formatMoney(data.totalPaid) + ' دج';
                    document.getElementById('statTotalDebt').textContent =
                        formatMoney(data.totalDebt) + ' دج';

                    // Initial Debt
                    if (data.initialDebt > 0) {
                        document.getElementById('initialDebtBox').style.display = 'flex';
                        document.getElementById('initialDebtAmount').textContent =
                            formatMoney(data.initialDebt) + ' دج';
                        document.getElementById('initialDebtRemaining').textContent =
                            formatMoney(data.initialDebtRemaining) + ' دج';
                    } else {
                        document.getElementById('initialDebtBox').style.display = 'none';
                    }

                    // Invoices Table
                    const invBody = document.getElementById('invoicesTableBody');
                    invBody.innerHTML = '';
                    if (data.initialDebt > 0) {
                        invBody.innerHTML += `
                            <tr>
                                <td>
                                    <strong class="text-orange">الدين الابتدائي (ديون سابقة قبل بدء استخدام البرنامج)</strong>
                                    <br/><small class="text-muted">الرصيد الافتتاحي</small>
                                </td>
                                <td>${formatMoney(data.initialDebt)}</td>
                                <td class="text-teal">${formatMoney(data.initialDebt - data.initialDebtRemaining)}</td>
                                <td class="text-red">${formatMoney(data.initialDebtRemaining)}</td>
                            </tr>`;
                    }
                    if (data.invoices && data.invoices.length > 0) {
                        data.invoices.forEach(inv => {
                            invBody.innerHTML += `
                                <tr>
                                    <td>
                                        <strong>${inv.invoiceNumber}</strong>
                                        <br/><small class="text-muted">${inv.date}</small>
                                    </td>
                                    <td>${formatMoney(inv.total)}</td>
                                    <td class="text-teal">${formatMoney(inv.paid)}</td>
                                    <td class="${inv.remaining > 0 ? 'text-red' : 'text-teal'}">
                                        ${formatMoney(inv.remaining)}
                                    </td>
                                </tr>`;
                        });
                    } else if (data.initialDebt === 0) {
                        invBody.innerHTML = '<tr><td colspan="4" class="text-center text-muted py-3">لا توجد فواتير.</td></tr>';
                    }

                    // Payments Table
                    const payBody = document.getElementById('paymentsTableBody');
                    payBody.innerHTML = '';
                    if (data.payments && data.payments.length > 0) {
                        data.payments.forEach(p => {
                            payBody.innerHTML += `
                                <tr>
                                    <td>${p.date}</td>
                                    <td class="text-teal fw-bold">${formatMoney(p.amount)}</td>
                                    <td>${p.invoiceRef || '—'}</td>
                                </tr>`;
                        });
                    } else {
                        payBody.innerHTML = '<tr><td colspan="3" class="text-center text-muted py-3">لا يوجد سجل دفعات.</td></tr>';
                    }

                    // Payment date default
                    document.getElementById('paymentDate').value =
                        new Date().toISOString().split('T')[0];
                    document.getElementById('paymentAmount').value = '0.00';
                    document.getElementById('paymentAmount').dataset.customerId = id;

                    document.getElementById('customerFileModal').classList.add('show');
                });
        }

        function closeFileModal() {
            document.getElementById('customerFileModal').classList.remove('show');
        }

        function closeFileModalOutside(e) {
            if (e.target.id === 'customerFileModal') closeFileModal();
        }

        // ================================================
        //  CONFIRM PAYMENT
        // ================================================
        function confirmPayment() {
            const amount = parseFloat(document.getElementById('paymentAmount').value);
            const date   = document.getElementById('paymentDate').value;
            const suppId = parseInt(document.getElementById('paymentAmount').dataset.customerId);

            if (!amount || amount <= 0) {
                alert('يرجى إدخال مبلغ صحيح!');
                return;
            }

            fetch('/customers/Pay', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json',
                           'RequestVerificationToken': getToken() },
                body: JSON.stringify({ customerId: suppId, amount: amount, date: date })
            })
            .then(r => r.json())
            .then(res => {
                if (res.success) { openCustomerFile(suppId); }
                else alert(res.message || 'حدث خطأ!');
            });
        }

        // ================================================
        //  HELPERS
        // ================================================
        function formatMoney(val) {
            return parseFloat(val || 0).toLocaleString('fr-DZ', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
        }

        function getToken() {
            const el = document.querySelector('input[name="__RequestVerificationToken"]');
            return el ? el.value : '';
        }
    </script>
}