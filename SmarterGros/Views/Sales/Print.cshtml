@model SmarterGros.ViewModels.SaleDetailsViewModel
@using SmarterGros.Models.Enums

@{
    Layout = null;
    var culture = new System.Globalization.CultureInfo("ar-DZ");
    var s = Model.Sale;
    var c = Model.CompanySettings;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>فاتورة بيع - @s.InvoiceNumber</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@@400;600;700;900&display=swap" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Cairo', Arial, sans-serif;
            background: #f0f0f0;
            color: #333;
        }

        .toolbar {
            background: #d32f2f;
            color: white;
            padding: 15px 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

            .toolbar h3 {
                margin: 0;
                font-size: 1.2rem;
            }

            .toolbar .actions {
                display: flex;
                gap: 10px;
            }

        .btn-action {
            padding: 8px 20px;
            border: none;
            border-radius: 6px;
            font-weight: 600;
            cursor: pointer;
            font-family: inherit;
        }

        .btn-print {
            background: white;
            color: #d32f2f;
        }

        .btn-back {
            background: #6c757d;
            color: white;
        }

        .invoice-page {
            max-width: 210mm;
            min-height: 297mm;
            margin: 20px auto;
            background: white;
            box-shadow: 0 0 20px rgba(0,0,0,0.1);
            padding: 20mm 15mm;
            position: relative;
        }

        .invoice-header {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
            margin-bottom: 25px;
            padding-bottom: 20px;
            border-bottom: 3px solid #d32f2f;
        }

        .company-info {
            display: flex;
            gap: 15px;
            align-items: flex-start;
        }

        .company-logo {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, #d32f2f, #ef5350);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 2rem;
            font-weight: 900;
        }

            .company-logo img {
                width: 100%;
                height: 100%;
                object-fit: contain;
                border-radius: 12px;
            }

        .company-details h1 {
            font-size: 1.6rem;
            color: #d32f2f;
            margin-bottom: 5px;
            font-weight: 900;
        }

        .company-details p {
            font-size: 0.8rem;
            color: #495057;
            margin: 2px 0;
        }

            .company-details p i {
                color: #d32f2f;
                width: 14px;
                margin-left: 4px;
            }

        .invoice-title {
            background: linear-gradient(135deg, #d32f2f, #ef5350);
            color: white;
            padding: 15px 25px;
            border-radius: 8px;
            text-align: center;
            margin-bottom: 15px;
        }

            .invoice-title h2 {
                font-size: 1.4rem;
                font-weight: 700;
                margin: 0;
            }

            .invoice-title .sub-title {
                font-size: 0.8rem;
                opacity: 0.9;
                margin-top: 3px;
            }

        .invoice-meta {
            background: #ffebee;
            padding: 12px 15px;
            border-radius: 8px;
            border-right: 4px solid #d32f2f;
        }

            .invoice-meta .meta-row {
                display: flex;
                justify-content: space-between;
                padding: 4px 0;
                font-size: 0.85rem;
            }

            .invoice-meta strong {
                color: #d32f2f;
            }

        .invoice-number {
            font-size: 1.1rem !important;
            font-weight: 700;
            color: #d32f2f !important;
        }

        .customer-section {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 15px 20px;
            margin-bottom: 25px;
            border-right: 4px solid #d32f2f;
        }

            .customer-section h3 {
                font-size: 0.9rem;
                color: #d32f2f;
                margin-bottom: 10px;
                font-weight: 700;
            }

        .customer-details {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 10px;
            font-size: 0.85rem;
        }

            .customer-details .field {
                display: flex;
                gap: 5px;
            }

            .customer-details .label {
                color: #6c757d;
                font-weight: 600;
            }

            .customer-details .value {
                color: #2c3e50;
                font-weight: 600;
            }

        .price-type-badge {
            display: inline-block;
            padding: 5px 15px;
            border-radius: 20px;
            background: #d32f2f;
            color: white;
            font-size: 0.85rem;
            font-weight: 700;
            margin-bottom: 15px;
        }

        .items-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.85rem;
            margin-bottom: 20px;
        }

            .items-table thead {
                background: linear-gradient(135deg, #d32f2f, #ef5350);
                color: white;
            }

                .items-table thead th {
                    padding: 10px 8px;
                    font-weight: 700;
                    text-align: center;
                    border: 1px solid #d32f2f;
                }

            .items-table tbody td {
                padding: 8px;
                border: 1px solid #dee2e6;
                text-align: center;
            }

                .items-table tbody td.text-right {
                    text-align: right;
                }

            .items-table tbody tr:nth-child(even) {
                background: #f8f9fa;
            }

            .items-table .product-name {
                font-weight: 600;
                color: #2c3e50;
            }

            .items-table .product-ref {
                font-size: 0.75rem;
                color: #6c757d;
                display: block;
            }

        .totals-section {
            display: grid;
            grid-template-columns: 1fr 350px;
            gap: 20px;
            margin-bottom: 25px;
        }

        .notes-box {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 12px 15px;
            border: 1px dashed #dee2e6;
        }

            .notes-box h5 {
                font-size: 0.85rem;
                color: #6c757d;
                margin-bottom: 5px;
            }

            .notes-box p {
                font-size: 0.85rem;
                color: #495057;
            }

        .totals-box {
            background: linear-gradient(135deg, #ffebee, #ffffff);
            border: 2px solid #d32f2f;
            border-radius: 8px;
            padding: 15px 20px;
        }

        .total-line {
            display: flex;
            justify-content: space-between;
            padding: 5px 0;
            font-size: 0.9rem;
        }

            .total-line.discount {
                color: #dc3545;
            }

            .total-line.grand {
                background: #d32f2f;
                color: white;
                margin: 10px -20px -15px;
                padding: 12px 20px;
                font-size: 1.2rem;
                font-weight: 900;
                border-radius: 0 0 6px 6px;
            }

        .payment-section {
            background: #fff3cd;
            border: 1px solid #ffc107;
            border-radius: 8px;
            padding: 12px 18px;
            margin-bottom: 25px;
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
            text-align: center;
        }

        .payment-item .label {
            font-size: 0.75rem;
            color: #856404;
            font-weight: 600;
        }

        .payment-item .value {
            font-size: 1.05rem;
            color: #2c3e50;
            font-weight: 700;
            margin-top: 3px;
        }

        .payment-type-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 20px;
            font-weight: 700;
            font-size: 0.85rem;
        }

            .payment-type-badge.cash {
                background: #d4edda;
                color: #155724;
            }

            .payment-type-badge.credit {
                background: #f8d7da;
                color: #721c24;
            }

            .payment-type-badge.partial {
                background: #fff3cd;
                color: #856404;
            }

        .signatures-section {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 50px;
            margin-top: 50px;
            padding-top: 20px;
        }

        .signature-box {
            text-align: center;
        }

            .signature-box .label {
                font-size: 0.9rem;
                color: #495057;
                font-weight: 700;
                margin-bottom: 50px;
            }

        .signature-line {
            border-top: 2px dashed #6c757d;
            padding-top: 8px;
            font-size: 0.8rem;
            color: #6c757d;
        }

        .invoice-footer {
            position: absolute;
            bottom: 15mm;
            left: 15mm;
            right: 15mm;
            border-top: 2px solid #d32f2f;
            padding-top: 10px;
            text-align: center;
            font-size: 0.75rem;
            color: #6c757d;
        }

            .invoice-footer .company-tagline {
                font-weight: 600;
                color: #d32f2f;
                margin-bottom: 3px;
            }

        @@media print {
            body {
                background: white;
                margin: 0;
                padding: 0;
            }

            .toolbar {
                display: none !important;
            }

            .invoice-page {
                box-shadow: none;
                margin: 0;
                padding: 15mm;
                width: 210mm;
                min-height: 297mm;
            }

            .no-print {
                display: none !important;
            }

            @@page {
                size: A4;
                margin: 0;
            }
        }
    </style>
</head>
<body>

    <!-- شريط الأدوات -->
    <div class="toolbar no-print">
        <h3>
            <i class="fas fa-print"></i>
            معاينة الفاتورة - @s.InvoiceNumber
        </h3>
        <div class="actions">
            <button class="btn-action btn-print" onclick="window.print()">
                <i class="fas fa-print"></i> طباعة
            </button>
            <button class="btn-action btn-back" onclick="window.close()">
                <i class="fas fa-times"></i> إغلاق
            </button>
        </div>
    </div>

    <!-- صفحة الفاتورة -->
    <div class="invoice-page">

        <!-- الترويسة -->
        <div class="invoice-header">
            <div class="company-info">
                <div class="company-logo">
                    @if (!string.IsNullOrEmpty(c?.LogoPath))
                    {
                        <img src="@c.LogoPath" alt="Logo" />
                    }
                    else
                    {
                        <span>@(c?.CompanyName?.Substring(0, 1).ToUpper() ?? "S")</span>
                    }
                </div>
                <div class="company-details">
                    <h1>@(c?.CompanyName ?? "SmarterGros")</h1>
                    @if (!string.IsNullOrEmpty(c?.CompanyType))
                    {
                        <div style="font-size: 0.85rem; color: #6c757d;">@c.CompanyType</div>
                    }
                    @if (!string.IsNullOrEmpty(c?.Address))
                    {
                        <p><i class="fas fa-map-marker-alt"></i> @c.Address @(string.IsNullOrEmpty(c?.City) ? "" : ", " + c.City)</p>
                    }
                    @if (!string.IsNullOrEmpty(c?.Phone))
                    {
                        <p><i class="fas fa-phone"></i> @c.Phone</p>
                    }
                    @if (!string.IsNullOrEmpty(c?.Email))
                    {
                        <p><i class="fas fa-envelope"></i> @c.Email</p>
                    }
                </div>
            </div>

            <div>
                <div class="invoice-title">
                    <h2>فاتورة بيع</h2>
                    <div class="sub-title">FACTURE DE VENTE</div>
                </div>

                <div class="invoice-meta">
                    <div class="meta-row">
                        <strong>رقم الفاتورة:</strong>
                        <span class="invoice-number">@s.InvoiceNumber</span>
                    </div>
                    <div class="meta-row">
                        <strong>التاريخ:</strong>
                        <span>@s.SaleDate.ToString("dd/MM/yyyy")</span>
                    </div>
                    <div class="meta-row">
                        <strong>الحالة:</strong>
                        <span style="color: #d32f2f; font-weight: 700;">@s.Status.GetArabicName()</span>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(c?.RC) || !string.IsNullOrEmpty(c?.NIF))
                {
                    <div style="margin-top: 10px; font-size: 0.75rem; color: #6c757d;">
                        @if (!string.IsNullOrEmpty(c?.RC))
                        {
                            <span style="margin-left: 10px;"><strong>RC:</strong> @c.RC</span>
                        }
                        @if (!string.IsNullOrEmpty(c?.NIF))
                        {
                            <span><strong>NIF:</strong> @c.NIF</span>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- معلومات العميل -->
        <div class="customer-section">
            <h3><i class="fas fa-user"></i> العميل - CLIENT</h3>
            <div class="customer-details">
                <div class="field">
                    <span class="label">الاسم:</span>
                    <span class="value">@(s.Customer?.Name ?? s.CustomerName ?? "عميل نقدي")</span>
                </div>
                @if (s.Customer != null)
                {
                    @if (!string.IsNullOrEmpty(s.Customer.Phone))
                    {
                        <div class="field">
                            <span class="label">الهاتف:</span>
                            <span class="value">@s.Customer.Phone</span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(s.Customer.Address))
                    {
                        <div class="field" style="grid-column: span 3;">
                            <span class="label">العنوان:</span>
                            <span class="value">@s.Customer.Address</span>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- نوع السعر -->
        <div class="price-type-badge">
            <i class="fas fa-tags"></i> نوع السعر: @s.PriceType.GetArabicName()
        </div>

        <!-- جدول البنود -->
        <table class="items-table">
            <thead>
                <tr>
                    <th width="35">#</th>
                    <th>المنتج / Désignation</th>
                    <th width="55">الكمية</th>
                    <th width="80">سعر الوحدة</th>
                    <th width="55">خصم %</th>
                    <th width="55">TVA %</th>
                    <th width="90">المجموع</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int rowNum = 1;
                }
                @foreach (var item in s.SaleItems)
                {
                    <tr>
                        <td>@rowNum</td>
                        <td class="text-right">
                            <span class="product-name">@(item.Product?.Name ?? "---")</span>
                            <span class="product-ref">@(item.Product?.Reference ?? "")</span>
                        </td>
                        <td><strong>@item.Quantity</strong></td>
                        <td>@item.UnitPrice.ToString("N2", culture)</td>
                        <td>@(item.Discount > 0 ? item.Discount.ToString("N2") + "%" : "-")</td>
                        <td>@(item.TaxRate > 0 ? item.TaxRate.ToString("N2") + "%" : "-")</td>
                        <td><strong>@item.TotalPrice.ToString("N2", culture)</strong></td>
                    </tr>
                    rowNum++;
                }
            </tbody>
        </table>

        <!-- المجاميع -->
        <div class="totals-section">
            <div class="notes-box">
                <h5><i class="fas fa-sticky-note"></i> ملاحظات</h5>
                <p>@(string.IsNullOrEmpty(s.Notes) ? "لا توجد ملاحظات" : s.Notes)</p>
            </div>

            <div class="totals-box">
                <div class="total-line">
                    <span>المجموع HT / Total HT:</span>
                    <strong>@s.SubTotal.ToString("N2", culture) دج</strong>
                </div>
                <div class="total-line">
                    <span>الضريبة TVA:</span>
                    <strong>@s.TaxAmount.ToString("N2", culture) دج</strong>
                </div>
                @if (s.Discount > 0)
                {
                    <div class="total-line discount">
                        <span>الخصم / Remise:</span>
                        <strong>- @s.Discount.ToString("N2", culture) دج</strong>
                    </div>
                }
                <div class="total-line grand">
                    <span>الإجمالي TTC:</span>
                    <strong>@s.TotalAmount.ToString("N2", culture) دج</strong>
                </div>
            </div>
        </div>

        <!-- الدفع -->
        <div class="payment-section">
            <div class="payment-item">
                <div class="label">طريقة الدفع</div>
                <div class="value">
                    <span class="payment-type-badge @s.PaymentType.ToString().ToLower()">
                        @s.PaymentType.GetArabicName()
                    </span>
                </div>
            </div>
            <div class="payment-item">
                <div class="label">المدفوع / Payé</div>
                <div class="value" style="color: #28a745;">@s.PaidAmount.ToString("N2", culture) دج</div>
            </div>
            <div class="payment-item">
                <div class="label">المتبقي / Reste</div>
                <div class="value" style="color: #dc3545;">@s.RemainingAmount.ToString("N2", culture) دج</div>
            </div>
        </div>

        <!-- التوقيعات -->
        <div class="signatures-section">
            <div class="signature-box">
                <div class="label">توقيع البائع / Signature Vendeur</div>
                <div class="signature-line">الختم والتوقيع</div>
            </div>
            <div class="signature-box">
                <div class="label">توقيع العميل / Signature Client</div>
                <div class="signature-line">الختم والتوقيع</div>
            </div>
        </div>

        <!-- الفوتر -->
        <div class="invoice-footer">
            <div class="company-tagline">@(c?.CompanyName ?? "SmarterGros") - نظام تسيير المخزون</div>
            <div>
                طُبعت بتاريخ: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
                @if (!string.IsNullOrEmpty(s.CreatedByName))
                {
                    <span style="margin-right: 20px;">| أنشأها: @s.CreatedByName</span>
                }
            </div>
        </div>

    </div>

    <script>
        document.addEventListener('keydown', function(e) {
            if (e.ctrlKey && e.key === 'p') {
                e.preventDefault();
                window.print();
            }
        });
    </script>
</body>
</html>