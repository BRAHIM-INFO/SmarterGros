@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using SmarterGros.Models
@using SmarterGros.Security
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IAuthorizationService AuthorizationService

@{
    // الحصول على المستخدم الحالي
    ApplicationUser? currentUser = null;
    string userInitial = "م";
    string userFullName = "مستخدم";
    string userRole = "زائر";

    if (SignInManager.IsSignedIn(User))
    {
        currentUser = await UserManager.GetUserAsync(User);
        if (currentUser != null)
        {
            userFullName = currentUser.FullName;
            userRole = currentUser.Role;
            userInitial = currentUser.FullName.Length > 0
                ? currentUser.FullName.Substring(0, 1).ToUpper()
                : "م";
        }
    }

    // دالة مساعدة للتحقق من الصلاحيات
    async Task<bool> HasPermission(string permission)
    {
        if (!SignInManager.IsSignedIn(User)) return false;
        var result = await AuthorizationService.AuthorizeAsync(
            User,
            null,
            $"{PermissionConstants.PolicyPrefix}{permission}"
        );
        return result.Succeeded;
    }
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SmarterGros</title>

    <!-- Cairo Font -->
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <!-- Bootstrap RTL -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.rtl.min.css" rel="stylesheet" />

    <!-- Font Awesome -->
    <script src="https://kit.fontawesome.com/3ae94e5958.js" crossorigin="anonymous"></script>
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
          integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LQ=="
          crossorigin="anonymous"
          referrerpolicy="no-referrer" />

    <!-- Site CSS -->
    <link href="~/css/site.css" rel="stylesheet" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="sg-body">
    @using SmarterGros.Services
    @inject ILicenseService LicenseService
    @inject IHardwareIdService HardwareIdService

    @{
        var licenseStatus = await LicenseService.CheckLicenseAsync();
        var remainingDays = await LicenseService.GetRemainingDaysAsync();
        var currentLicense = await LicenseService.GetCurrentLicenseAsync();
    }

    <!-- 🔐 شريط تنبيه الترخيص -->
    @if (licenseStatus == LicenseStatus.TrialActive || licenseStatus == LicenseStatus.TrialExpiring)
    {
        <div class="license-banner @(licenseStatus == LicenseStatus.TrialExpiring ? "expiring" : "")">
            <div class="banner-content">
                <div class="banner-info">
                    @if (licenseStatus == LicenseStatus.TrialExpiring)
                    {
                        <i class="fas fa-exclamation-triangle"></i>
                        <strong>⚠️ تنبيه!</strong>
                        <span>الفترة التجريبية ستنتهي خلال <strong>@remainingDays</strong> أيام</span>
                    }
                    else
                    {
                        <i class="fas fa-info-circle"></i>
                        <strong>🆓 نسخة تجريبية</strong>
                        <span>متبقي <strong>@remainingDays</strong> يوم من الفترة التجريبية</span>
                    }
                </div>
                <a href="/License/Activate" class="banner-btn">
                    <i class="fas fa-key"></i> تفعيل الترخيص الآن
                </a>
            </div>
        </div>
    }

    <style>
        .license-banner {
            background: linear-gradient(135deg, #dc3545, #c82333);
            color: white;
            padding: 12px 20px;
            text-align: center;
            position: sticky;
            top: 0;
            z-index: 9999;
            box-shadow: 0 2px 10px rgba(220,53,69,0.3);
            animation: pulse-banner 2s infinite;
        }

        @@keyframes pulse-banner {
            0%, 100% {
                box-shadow: 0 2px 10px rgba(220,53,69,0.3);
            }

            50% {
                box-shadow: 0 2px 25px rgba(220,53,69,0.7);
            }
        }

        .license-banner.expiring {
            background: linear-gradient(135deg, #dc3545, #ff4757);
            animation: pulse-banner-urgent 1s infinite;
        }

        @@keyframes pulse-banner-urgent {
            0%, 100% {
                box-shadow: 0 2px 10px rgba(220,53,69,0.3);
                opacity: 1;
            }

            50% {
                box-shadow: 0 2px 30px rgba(220,53,69,0.8);
                opacity: 0.9;
            }
        }

        .banner-content {
            max-width: 1200px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            flex-wrap: wrap;
        }

        .banner-info {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 0.95rem;
        }

            .banner-info i {
                font-size: 1.3rem;
            }

        .banner-btn {
            background: white;
            color: #dc3545;
            padding: 8px 20px;
            border-radius: 25px;
            text-decoration: none;
            font-weight: 700;
            transition: all 0.3s;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 0.9rem;
        }

            .banner-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(0,0,0,0.2);
                color: #dc3545;
            }
    </style>
