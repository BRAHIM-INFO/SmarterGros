    <div class="sg-wrapper">
        <!-- Sidebar -->
        <aside class="sg-sidebar" id="sidebar">
            <div class="sg-sidebar-header">
                <div class="sg-logo">
                    <div class="sg-logo-icon">SG</div>
                    <div class="sg-logo-text">
                        <span class="sg-logo-name">SmartGros</span>
                        <span class="sg-logo-sub">نظام تسيير المخزون</span>
                    </div>
                </div>
            </div>

            <nav class="sg-nav">
                <!-- ═══════════════════════════════════════════════════
                     📊 رئيسية
                ═══════════════════════════════════════════════════ -->
                @if (await HasPermission(Permissions.Dashboard.View))
                {
                    <div class="sg-nav-section">
                        <span class="sg-nav-label">رئيسية</span>
                        <a href="@Url.Action("Index", "Dashboard")" class="sg-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
                            <i class="fas fa-th-large"></i>
                            <span>لوحة التحكم</span>
                        </a>
                    </div>
                }

                <!-- ═══════════════════════════════════════════════════
                     📦 المخزن
                ═══════════════════════════════════════════════════ -->
                @{
                    var canViewProducts = await HasPermission(Permissions.Products.View);
                    var canViewStockMovements = await HasPermission(Permissions.StockMovements.View);
                    var canViewCategories = await HasPermission(Permissions.Categories.View);
                    var showStockSection = canViewProducts || canViewStockMovements || canViewCategories;
                }
                @if (showStockSection)
                {
                    <div class="sg-nav-section">
                        <span class="sg-nav-label">المخزن</span>

                        @if (canViewProducts)
                        {
                            <a href="@Url.Action("Index", "Products")" class="sg-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Products" ? "active" : "")">
                                <i class="fas fa-box"></i>
                                <span>المنتجات</span>
                            </a>
                        }

                        @if (canViewStockMovements)
                        {
                            <a href="@Url.Action("Index", "StockMovements")" class="sg-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "StockMovements" ? "active" : "")">
                                <i class="fas fa-exchange-alt"></i>
                                <span>حركات المخزون</span>
                            </a>
                        }

                        @if (canViewCategories)
                        {
                            <a href="@Url.Action("Index", "Categories")" class="sg-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Categories" ? "active" : "")">
                                <i class="fas fa-tags"></i>
                                <span>الفئات</span>
                            </a>
                        }
                    </div>
                }

                <!-- ═══════════════════════════════════════════════════
                     🛒 التجارة
                ═══════════════════════════════════════════════════ -->
                @{
                    var canViewPurchases = await HasPermission(Permissions.Purchases.View);
                    var canViewPurchaseReturns = await HasPermission(Permissions.PurchaseReturns.View);
                    var canViewSales = await HasPermission(Permissions.Sales.View);
                    var canViewSuppliers = await HasPermission(Permissions.Suppliers.View);
                    var canViewCustomers = await HasPermission(Permissions.Customers.View);
                    var showCommerceSection = canViewPurchases || canViewPurchaseReturns || canViewSales || canViewSuppliers || canViewCustomers;
                }
                @if (showCommerceSection)
                {
                    <div class="sg-nav-section">
                        <span class="sg-nav-label">التجارة</span>

                        @if (canViewPurchases)
                        {
                            <a href="@Url.Action("Index", "Purchases")" class="sg-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Purchases" ? "active" : "")">
                                <i class="fas fa-shopping-cart"></i>
                                <span>المشتريات</span>
                            </a>
                        }

                        @if (canViewPurchaseReturns)
                        {
                            <a href="@Url.Action("Index", "PurchaseReturns")" class="sg-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "PurchaseReturns" ? "active" : "")">
                                <i class="fas fa-rotate-left"></i>
                                <span>مرتجعات الشراء</span>
                            </a>
                        }

                        @if (canViewSales)
                        {
                            <a href="@Url.Action("Index", "Sales")" class="sg-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Sales" ? "active" : "")">
                                <i class="fas fa-cash-register"></i>
                                <span>المبيعات</span>
                            </a>
                        }

                        @{
                            var canViewSaleReturns = await HasPermission(Permissions.SaleReturns.View);
                        }
                        @if (canViewSaleReturns)
                        {
                            <a href="@Url.Action("Index", "SaleReturns")" class="sg-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "SaleReturns" ? "active" : "")">
                                <i class="fas fa-rotate-left"></i>
                                <span>مرتجعات البيع</span>
                            </a>
                        }

                        @if (canViewSuppliers)
                        {
                            <a href="@Url.Action("Index", "Suppliers")" class="sg-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Suppliers" ? "active" : "")">
                                <i class="fas fa-truck"></i>
                                <span>الموردون</span>
                            </a>
                        }

                        @if (canViewCustomers)
                        {
                            <a href="@Url.Action("Index", "Customers")" class="sg-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Customers" ? "active" : "")">
                                <i class="fas fa-users"></i>
                                <span>العملاء</span>
                            </a>
                        }

                        @if (User.HasClaim("Permission", "Sales.QuickSale"))
                        {
                            <a href="@Url.Action("POS", "Sales")" class="sg-nav-item" target="_blank">
                                <i class="fas fa-cash-register"></i>
                                <span>نقطة البيع (POS)</span>
                                <span class="badge bg-warning text-dark ms-auto">⚡</span>
                            </a>
                        }


                    </div>
                }

                <!-- ═══════════════════════════════════════════════════
                     💰 المالية
                ═══════════════════════════════════════════════════ -->
                @{
                    var canViewCashRegister = await HasPermission(Permissions.CashRegister.View);
                }
                @if (canViewCashRegister)
                {
                    <div class="sg-nav-section">
                        <span class="sg-nav-label">المالية</span>

                        <a href="@Url.Action("Index", "CashRegister")" class="sg-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "CashRegister" ? "active" : "")">
                            <i class="fas fa-cash-register"></i>
                            <span>الصندوق</span>
                        </a>
                    </div>
                }

                <!-- ═══════════════════════════════════════════════════
                     📊 التحليل
                ═══════════════════════════════════════════════════ -->
                @{
                    var canViewStatistics = await HasPermission(Permissions.Reports.ViewStatistics);
                    var canViewReports = await HasPermission(Permissions.Reports.ViewSalesReport)
                    || await HasPermission(Permissions.Reports.ViewPurchasesReport)
                    || await HasPermission(Permissions.Reports.ViewStockReport)
                    || await HasPermission(Permissions.Reports.ViewProfitReport);
                    var showAnalysisSection = canViewStatistics || canViewReports;
                }
                @if (showAnalysisSection)
                {
                    <div class="sg-nav-section">
                        <span class="sg-nav-label">التحليل</span>

                        @if (canViewStatistics)
                        {
                            <a href="@Url.Action("Statistics", "Reports")" class="sg-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" && ViewContext.RouteData.Values["action"]?.ToString() == "Statistics" ? "active" : "")">
                                <i class="fas fa-chart-bar"></i>
                                <span>الإحصائيات</span>
                            </a>
                        }

                        @if (canViewReports)
                        {
                            <a href="@Url.Action("Index", "Reports")" class="sg-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                                <i class="fas fa-file-alt"></i>
                                <span>التقارير</span>
                            </a>
                        }
                    </div>
                }


                <!-- ═══════════════════════════════════════════════════
                     📝 سجل النشاطات
                ═══════════════════════════════════════════════════ -->
                @if (await HasPermission(Permissions.ActivityLogs.View))
                {
                    <div class="sg-nav-section">
                        <span class="sg-nav-label">المراقبة</span>
                        <a href="@Url.Action("Index", "ActivityLogs")" class="sg-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "ActivityLogs" ? "active" : "")">
                            <i class="fas fa-history"></i>
                            <span>سجل النشاطات</span>
                        </a>
                    </div>
                }

                <!-- ═══════════════════════════════════════════════════
                     ⚙️ الإعدادات
                ═══════════════════════════════════════════════════ -->
                @{
                    var canViewSettings = await HasPermission(Permissions.CompanySettings.View)
                    || await HasPermission(Permissions.Users.View)
                    || await HasPermission(Permissions.Database.View)
                    || await HasPermission(Permissions.Support.View)
                    || await HasPermission(Permissions.Roles.View);
                }
                @if (canViewSettings)
                {
                    <div class="sg-nav-section">
                        <a href="@Url.Action("Index", "Settings")" class="sg-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Settings" ? "active" : "")">
                            <i class="fas fa-cog"></i>
                            <span>الإعدادات</span>
                        </a>
                    </div>
                }

                <!-- 🔐 الترخيص -->
                <div class="sg-nav-section">
                    <span class="sg-nav-label">الترخيص</span>

                    <a href="@Url.Action("Info", "License")" class="sg-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "License" ? "active" : "")">
                        <i class="fas fa-key"></i>
                        <span>معلومات الترخيص</span>
                        @{
                            var licStatus = await LicenseService.CheckLicenseAsync();
                            var licDays = await LicenseService.GetRemainingDaysAsync();
                        }
                        @if (licStatus == LicenseStatus.TrialActive)
                        {
                            <span class="badge bg-success ms-auto">@licDays يوم</span>
                        }
                        else if (licStatus == LicenseStatus.TrialExpiring)
                        {
                            <span class="badge bg-warning ms-auto blink">@licDays يوم</span>
                        }
                        else if (licStatus == LicenseStatus.Active)
                        {
                            <span class="badge bg-info ms-auto">
                                <i class="fas fa-check"></i>
                            </span>
                        }
                    </a>
                </div>

                <style>
                    .blink {
                        animation: blink 1.5s infinite;
                    }

                    @@keyframes blink {
                        0%, 100% {
                            opacity: 1;
                        }

                        50% {
                            opacity: 0.5;
                        }
                    }
                </style>

            </nav>

            <!-- ═══════════════════════════════════════════════════
                 👤 معلومات المستخدم في الأسفل
            ═══════════════════════════════════════════════════ -->
            <div class="sg-sidebar-footer">
                <div class="sg-user-info">
                    <div class="sg-user-avatar">@userInitial</div>
                    <div class="sg-user-details">
                        <span class="sg-user-name">@userFullName</span>
                        <span class="sg-user-role">@userRole</span>
                    </div>
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="sg-logout-btn" title="تسجيل الخروج">
                                <i class="fas fa-sign-out-alt"></i>
                            </button>
                        </form>
                    }
                </div>
            </div>
        </aside>

        <!-- Main Content -->
        <div class="sg-main">
            <!-- Top Bar -->
            <header class="sg-topbar">
                <div class="sg-topbar-right">
                    <button class="sg-sidebar-toggle" id="sidebarToggle">
                        <i class="fas fa-bars"></i>
                    </button>
                    <div class="sg-notification">
                        <i class="fas fa-bell"></i>
                        <span class="sg-badge">3</span>
                    </div>
                    <div class="sg-date-display">
                        <i class="fas fa-calendar-alt"></i>
                        <span id="currentDate"></span>
                    </div>
                </div>
                <div class="sg-topbar-left">
                    <div class="sg-search">
                        <input type="text" placeholder="بحث عن منتج، مورد، فاتورة..." id="globalSearch" />
                        <i class="fas fa-search"></i>
                    </div>
                    <span class="sg-page-title">@ViewData["Title"]</span>
                </div>
            </header>

            <!-- Content -->
            <main class="sg-content">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show sg-alert" role="alert">
                        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show sg-alert" role="alert">
                        <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

