@model SmarterGros.ViewModels.PurchaseReturnDetailsViewModel
@using SmarterGros.Models.Enums

@{
    Layout = null;
    var culture = new System.Globalization.CultureInfo("ar-DZ");
    var r = Model.PurchaseReturn;
    var op = Model.OriginalPurchase;
    var c = ViewBag.CompanySettings as SmarterGros.Models.CompanySettings;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>مرتجع شراء - @r.ReturnNumber</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@@400;600;700;900&display=swap" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Cairo', Arial, sans-serif;
            background: #f0f0f0;
            color: #333;
        }

        .toolbar {
            background: #e91e63;
            color: white;
            padding: 15px 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

            .toolbar h3 {
                margin: 0;
                font-size: 1.2rem;
            }

            .toolbar .actions {
                display: flex;
                gap: 10px;
            }

        .btn-action {
            padding: 8px 20px;
            border: none;
            border-radius: 6px;
            font-weight: 600;
            cursor: pointer;
            font-family: inherit;
        }

        .btn-print {
            background: white;
            color: #e91e63;
        }

        .btn-back {
            background: #6c757d;
            color: white;
        }

        .receipt-page {
            max-width: 210mm;
            min-height: 297mm;
            margin: 20px auto;
            background: white;
            box-shadow: 0 0 20px rgba(0,0,0,0.1);
            padding: 20mm 15mm;
            position: relative;
        }

        .receipt-header {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
            margin-bottom: 25px;
            padding-bottom: 20px;
            border-bottom: 3px solid #e91e63;
        }

        .company-info {
            display: flex;
            gap: 15px;
            align-items: flex-start;
        }

        .company-logo {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, #e91e63, #c2185b);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 2rem;
            font-weight: 900;
        }

            .company-logo img {
                width: 100%;
                height: 100%;
                object-fit: contain;
                border-radius: 12px;
            }

        .company-details h1 {
            font-size: 1.6rem;
            color: #e91e63;
            margin-bottom: 5px;
            font-weight: 900;
        }

        .company-details p {
            font-size: 0.8rem;
            color: #495057;
            margin: 2px 0;
        }

            .company-details p i {
                color: #e91e63;
                width: 14px;
                margin-left: 4px;
            }

        .receipt-title {
            background: linear-gradient(135deg, #e91e63, #c2185b);
            color: white;
            padding: 15px 25px;
            border-radius: 8px;
            text-align: center;
            margin-bottom: 15px;
        }

            .receipt-title h2 {
                font-size: 1.4rem;
                font-weight: 700;
                margin: 0;
            }

            .receipt-title .sub-title {
                font-size: 0.8rem;
                opacity: 0.9;
                margin-top: 3px;
            }

        .receipt-meta {
            background: #fce4ec;
            padding: 12px 15px;
            border-radius: 8px;
            border-right: 4px solid #e91e63;
        }

            .receipt-meta .meta-row {
                display: flex;
                justify-content: space-between;
                padding: 4px 0;
                font-size: 0.85rem;
            }

            .receipt-meta strong {
                color: #e91e63;
            }

        .receipt-number {
            font-size: 1.1rem !important;
            font-weight: 700;
            color: #e91e63 !important;
        }

        .info-cards {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-bottom: 20px;
        }

        .info-card {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 12px 15px;
            border-right: 4px solid;
        }

            .info-card.supplier {
                border-color: #28a745;
            }

            .info-card.original {
                border-color: #ffc107;
            }

            .info-card h4 {
                font-size: 0.9rem;
                margin-bottom: 8px;
                font-weight: 700;
            }

            .info-card.supplier h4 {
                color: #28a745;
            }

            .info-card.original h4 {
                color: #ffc107;
            }

        .info-row {
            display: flex;
            justify-content: space-between;
            padding: 3px 0;
            font-size: 0.85rem;
        }

            .info-row .label {
                color: #6c757d;
            }

            .info-row .value {
                color: #2c3e50;
                font-weight: 600;
            }

        .reason-box {
            background: #fff3cd;
            border: 1px solid #ffc107;
            border-radius: 8px;
            padding: 12px 15px;
            margin-bottom: 20px;
        }

            .reason-box h4 {
                font-size: 0.9rem;
                color: #856404;
                margin-bottom: 5px;
            }

        .items-section {
            margin-bottom: 20px;
        }

        .items-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.85rem;
        }

            .items-table thead {
                background: linear-gradient(135deg, #e91e63, #c2185b);
                color: white;
            }

                .items-table thead th {
                    padding: 10px 8px;
                    font-weight: 700;
                    text-align: center;
                    border: 1px solid #e91e63;
                }

            .items-table tbody td {
                padding: 8px;
                border: 1px solid #dee2e6;
                text-align: center;
            }

                .items-table tbody td.text-right {
                    text-align: right;
                }

            .items-table tbody tr:nth-child(even) {
                background: #fce4ec;
            }

        .totals-section {
            display: grid;
            grid-template-columns: 1fr 350px;
            gap: 20px;
            margin-bottom: 25px;
        }

        .totals-box {
            background: linear-gradient(135deg, #fce4ec, #ffffff);
            border: 2px solid #e91e63;
            border-radius: 8px;
            padding: 15px 20px;
        }

        .total-line {
            display: flex;
            justify-content: space-between;
            padding: 5px 0;
            font-size: 0.9rem;
        }

            .total-line.grand {
                background: #e91e63;
                color: white;
                margin: 10px -20px -15px;
                padding: 12px 20px;
                font-size: 1.2rem;
                font-weight: 900;
                border-radius: 0 0 6px 6px;
            }

        .refund-section {
            background: #fff3cd;
            border: 1px solid #ffc107;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 25px;
            text-align: center;
        }

            .refund-section h4 {
                color: #856404;
                margin-bottom: 10px;
            }

        .refund-amounts {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
        }

        .refund-amount-item {
            background: white;
            padding: 10px;
            border-radius: 6px;
        }

            .refund-amount-item .label {
                font-size: 0.8rem;
                color: #6c757d;
            }

            .refund-amount-item .value {
                font-size: 1.1rem;
                font-weight: 700;
                margin-top: 3px;
            }

        .signatures-section {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 50px;
            margin-top: 40px;
            padding-top: 20px;
        }

        .signature-box {
            text-align: center;
        }

            .signature-box .role {
                background: #e91e63;
                color: white;
                padding: 6px 12px;
                border-radius: 20px;
                display: inline-block;
                font-size: 0.8rem;
                font-weight: 700;
                margin-bottom: 50px;
            }

        .signature-line {
            border-top: 2px dashed #6c757d;
            padding-top: 8px;
            font-size: 0.8rem;
            color: #6c757d;
        }

        .receipt-footer {
            position: absolute;
            bottom: 15mm;
            left: 15mm;
            right: 15mm;
            border-top: 2px solid #e91e63;
            padding-top: 10px;
            text-align: center;
            font-size: 0.75rem;
            color: #6c757d;
        }

            .receipt-footer .tagline {
                font-weight: 600;
                color: #e91e63;
                margin-bottom: 3px;
            }

        @@media print {
            body {
                background: white;
            }

            .toolbar, .no-print {
                display: none !important;
            }

            .receipt-page {
                box-shadow: none;
                margin: 0;
                padding: 15mm;
            }

            @@page {
                size: A4;
                margin: 0;
            }
        }
    </style>
</head>
<body>

    <!-- Toolbar -->
    <div class="toolbar no-print">
        <h3><i class="fas fa-rotate-left"></i> مرتجع شراء - @r.ReturnNumber</h3>
        <div class="actions">
            <button class="btn-action btn-print" onclick="window.print()">
                <i class="fas fa-print"></i> طباعة
            </button>
            <button class="btn-action btn-back" onclick="window.close()">
                <i class="fas fa-times"></i> إغلاق
            </button>
        </div>
    </div>

    <!-- صفحة المرتجع -->
    <div class="receipt-page">

        <!-- الترويسة -->
        <div class="receipt-header">
            <div class="company-info">
                <div class="company-logo">
                    @if (!string.IsNullOrEmpty(c?.LogoPath))
                    {
                        <img src="@c.LogoPath" alt="Logo" />
                    }
                    else
                    {
                        <span>@(c?.CompanyName?.Substring(0, 1).ToUpper() ?? "S")</span>
                    }
                </div>
                <div class="company-details">
                    <h1>@(c?.CompanyName ?? "SmarterGros")</h1>
                    @if (!string.IsNullOrEmpty(c?.Address))
                    {
                        <p><i class="fas fa-map-marker-alt"></i> @c.Address</p>
                    }
                    @if (!string.IsNullOrEmpty(c?.Phone))
                    {
                        <p><i class="fas fa-phone"></i> @c.Phone</p>
                    }
                    @if (!string.IsNullOrEmpty(c?.Email))
                    {
                        <p><i class="fas fa-envelope"></i> @c.Email</p>
                    }
                </div>
            </div>

            <div>
                <div class="receipt-title">
                    <h2><i class="fas fa-rotate-left"></i> مرتجع شراء</h2>
                    <div class="sub-title">AVOIR / BON DE RETOUR</div>
                </div>

                <div class="receipt-meta">
                    <div class="meta-row">
                        <strong>رقم المرتجع:</strong>
                        <span class="receipt-number">@r.ReturnNumber</span>
                    </div>
                    <div class="meta-row">
                        <strong>التاريخ:</strong>
                        <span>@r.ReturnDate.ToString("dd/MM/yyyy")</span>
                    </div>
                    @if (op != null)
                    {
                        <div class="meta-row">
                            <strong>الفاتورة الأصلية:</strong>
                            <span>@op.InvoiceNumber</span>
                        </div>
                    }
                    @if (r.IsCancelled)
                    {
                        <div class="meta-row" style="color: #dc3545; font-weight: 700;">
                            <strong>الحالة:</strong>
                            <span>ملغى ❌</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- معلومات المورد والفاتورة -->
        <div class="info-cards">
            <div class="info-card supplier">
                <h4><i class="fas fa-truck"></i> المورد / FOURNISSEUR</h4>
                <div class="info-row">
                    <span class="label">الاسم:</span>
                    <span class="value">@(r.Supplier?.Name ?? "---")</span>
                </div>
                @if (!string.IsNullOrEmpty(r.Supplier?.Phone))
                {
                    <div class="info-row">
                        <span class="label">الهاتف:</span>
                        <span class="value">@r.Supplier.Phone</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(r.Supplier?.RC))
                {
                    <div class="info-row">
                        <span class="label">RC:</span>
                        <span class="value">@r.Supplier.RC</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(r.Supplier?.NIF))
                {
                    <div class="info-row">
                        <span class="label">NIF:</span>
                        <span class="value">@r.Supplier.NIF</span>
                    </div>
                }
            </div>

            @if (op != null)
            {
                <div class="info-card original">
                    <h4><i class="fas fa-file-invoice"></i> الفاتورة الأصلية</h4>
                    <div class="info-row">
                        <span class="label">رقم الفاتورة:</span>
                        <span class="value">@op.InvoiceNumber</span>
                    </div>
                    <div class="info-row">
                        <span class="label">التاريخ:</span>
                        <span class="value">@op.PurchaseDate.ToString("dd/MM/yyyy")</span>
                    </div>
                    <div class="info-row">
                        <span class="label">المبلغ الإجمالي:</span>
                        <span class="value">@op.GrandTotal.ToString("N2", culture) دج</span>
                    </div>
                </div>
            }
        </div>

        <!-- سبب الإرجاع -->
        @if (!string.IsNullOrEmpty(r.ReturnReason))
        {
            <div class="reason-box">
                <h4><i class="fas fa-exclamation-circle"></i> سبب الإرجاع</h4>
                <p style="font-size: 0.9rem;">@r.ReturnReason</p>
            </div>
        }

        <!-- جدول البنود -->
        <div class="items-section">
            <table class="items-table">
                <thead>
                    <tr>
                        <th width="35">#</th>
                        <th>المنتج / Désignation</th>
                        <th width="55">الكمية</th>
                        <th width="85">سعر الوحدة</th>
                        <th width="55">TVA %</th>
                        <th>سبب الإرجاع</th>
                        <th width="90">المجموع</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int rowNum = 1;
                    }
                    @foreach (var item in r.ReturnItems)
                    {
                        <tr>
                            <td>@rowNum</td>
                            <td class="text-right">
                                <strong>@(item.Product?.Name ?? "---")</strong>
                                @if (!string.IsNullOrEmpty(item.ProductCondition))
                                {
                                    <br>
                                    <small style="color: #6c757d;">حالة: @item.ProductCondition</small>
                                }
                            </td>
                            <td><strong>@item.ReturnedQuantity</strong></td>
                            <td>@item.UnitPrice.ToString("N2", culture)</td>
                            <td>@(item.TaxRate > 0 ? item.TaxRate.ToString("N2") + "%" : "-")</td>
                            <td class="text-right" style="font-size: 0.8rem;">
                                @(string.IsNullOrEmpty(item.ReturnReason) ? "-" : item.ReturnReason)
                            </td>
                            <td><strong>@item.TotalPrice.ToString("N2", culture)</strong></td>
                        </tr>
                        rowNum++;
                    }
                </tbody>
            </table>
        </div>

        <!-- المجاميع -->
        <div class="totals-section">
            <div></div>
            <div class="totals-box">
                <div class="total-line">
                    <span>المجموع HT / Total HT:</span>
                    <strong>@r.SubTotal.ToString("N2", culture) دج</strong>
                </div>
                <div class="total-line">
                    <span>الضريبة TVA:</span>
                    <strong>@r.TaxAmount.ToString("N2", culture) دج</strong>
                </div>
                <div class="total-line grand">
                    <span>الإجمالي TTC:</span>
                    <strong>@r.TotalAmount.ToString("N2", culture) دج</strong>
                </div>
            </div>
        </div>

        <!-- طريقة الاسترداد -->
        <div class="refund-section">
            <h4><i class="fas @r.RefundMethod.GetIcon()"></i> طريقة الاسترداد: @r.RefundMethod.GetArabicName()</h4>
            <div class="refund-amounts">
                <div class="refund-amount-item">
                    <div class="label">المخصوم من الدين</div>
                    <div class="value" style="color: #17a2b8;">
                        @r.DeductedFromDebt.ToString("N2", culture) دج
                    </div>
                </div>
                <div class="refund-amount-item">
                    <div class="label">المسترد نقداً</div>
                    <div class="value" style="color: #28a745;">
                        @r.CashRefunded.ToString("N2", culture) دج
                    </div>
                </div>
            </div>
        </div>

        <!-- التوقيعات -->
        <div class="signatures-section">
            <div class="signature-box">
                <div class="role">المورد / Fournisseur</div>
                <div class="signature-line">
                    <div>@(r.Supplier?.Name ?? "")</div>
                    <div>الختم والتوقيع</div>
                </div>
            </div>
            <div class="signature-box">
                <div class="role">المسؤول / Responsable</div>
                <div class="signature-line">
                    <div>@(r.CreatedByName ?? "")</div>
                    <div>الختم والتوقيع</div>
                </div>
            </div>
        </div>

        <!-- الفوتر -->
        <div class="receipt-footer">
            <div class="tagline">@(c?.CompanyName ?? "SmarterGros") - نظام تسيير المخزون</div>
            <div>
                طُبعت بتاريخ: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
                @if (!string.IsNullOrEmpty(r.CreatedByName))
                {
                    <span style="margin-right: 20px;">| أنشأها: @r.CreatedByName</span>
                }
            </div>
        </div>

    </div>

    <script>
        document.addEventListener('keydown', function(e) {
            if (e.ctrlKey && e.key === 'p') {
                e.preventDefault();
                window.print();
            }
        });
    </script>
</body>
</html>