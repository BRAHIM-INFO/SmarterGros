@using SmarterGros.Security
@{
    ViewData["Title"] = "إدارة الصلاحيات";
    var allRoles = ViewBag.AllRoles as List<string> ?? new List<string>();
    var selectedRole = ViewBag.SelectedRole as string ?? "";
    var allPermissions = ViewBag.AllPermissions as List<PermissionsList.PermissionGroup> ?? new();
    var currentPermissions = ViewBag.CurrentPermissions as HashSet<string> ?? new();
    var isSystemAdmin = (bool)(ViewBag.IsSystemAdmin ?? false);
    var totalPermissions = (int)(ViewBag.TotalPermissions ?? 0);
    var assignedPermissions = (int)(ViewBag.AssignedPermissions ?? 0);
}

<!-- Settings Tabs -->
<div class="sg-settings-tabs">
    <a href="@Url.Action("Index", "Settings")" class="sg-tab-btn">
        <i class="fas fa-building me-1"></i>بيانات المؤسسة
    </a>
    <a href="@Url.Action("Users", "Settings")" class="sg-tab-btn">
        <i class="fas fa-users me-1"></i>المستخدمون
    </a>
    <a href="@Url.Action("RolesPermissions", "Settings")" class="sg-tab-btn active">
        <i class="fas fa-user-shield me-1"></i>الصلاحيات
    </a>
    <a href="@Url.Action("Database", "Settings")" class="sg-tab-btn">
        <i class="fas fa-database me-1"></i>قاعدة البيانات
    </a>
    <a href="@Url.Action("Support", "Settings")" class="sg-tab-btn">
        <i class="fas fa-headset me-1"></i>الدعم
    </a>
</div>

<!-- Header -->
<div class="sg-page-header">
    <div class="sg-page-header-top">
        <div>
            <h1 class="sg-page-title-main">
                <i class="fas fa-user-shield me-2"></i>إدارة الصلاحيات
            </h1>
            <p class="sg-page-subtitle">
                تحكم في صلاحيات كل دور في النظام
            </p>
        </div>
    </div>
</div>

<!-- Role Selector & Stats -->
<div class="perm-toolbar">
    <div class="perm-role-selector">
        <label class="perm-label">
            <i class="fas fa-user-tag me-1"></i>اختر الدور:
        </label>
        <form method="get" id="roleSelectForm">
            <select name="roleName"
                    class="perm-role-select"
                    onchange="document.getElementById('roleSelectForm').submit()">
                @foreach (var role in allRoles)
                {
                    if (role == selectedRole)
                    {
                        <option value="@role" selected>@role</option>
                    }
                    else
                    {
                        <option value="@role">@role</option>
                    }
                }
            </select>
        </form>
    </div>

    <div class="perm-stats">
        <div class="perm-stat-box">
            <div class="perm-stat-number" id="selectedCount">@assignedPermissions</div>
            <div class="perm-stat-label">من @totalPermissions صلاحية</div>
        </div>
    </div>
</div>

<!-- Warning for System Admin -->
@if (isSystemAdmin)
{
    <div class="perm-warning">
        <i class="fas fa-shield-alt"></i>
        <div>
            <strong>مدير النظام:</strong>
            هذا الدور لديه جميع الصلاحيات تلقائياً ولا يمكن تعديلها لحماية النظام.
        </div>
    </div>
}

<!-- Action Buttons -->
@if (!isSystemAdmin)
{
    <div class="perm-actions-bar">
        <button class="perm-btn perm-btn-select-all" onclick="selectAllPermissions()">
            <i class="fas fa-check-double me-1"></i>تحديد الكل
        </button>
        <button class="perm-btn perm-btn-deselect-all" onclick="deselectAllPermissions()">
            <i class="fas fa-times me-1"></i>إلغاء الكل
        </button>
        <button class="perm-btn perm-btn-reset" onclick="resetToDefault()">
            <i class="fas fa-undo me-1"></i>إعادة الافتراضي
        </button>
        <div class="perm-actions-spacer"></div>
        <button class="perm-btn perm-btn-save" onclick="savePermissions()">
            <i class="fas fa-save me-1"></i>حفظ التغييرات
        </button>
    </div>
}

<!-- Permissions Grid -->
<div class="perm-groups-container">
    @foreach (var group in allPermissions)
    {
        var groupAssignedCount = group.Permissions.Count(p => currentPermissions.Contains(p.Key));
        var groupTotalCount = group.Permissions.Count;
        var allChecked = groupAssignedCount == groupTotalCount;

        <div class="perm-group" data-group="@group.GroupName">
            <div class="perm-group-header" style="background: linear-gradient(135deg, @group.GroupColor, @group.GroupColor)CC;">
                <div class="perm-group-title">
                    <i class="fas @group.GroupIcon"></i>
                    <span>@group.GroupName</span>
                </div>
                <div class="perm-group-actions">
                    <span class="perm-group-count">
                        <span class="group-selected-count">@groupAssignedCount</span> / @groupTotalCount
                    </span>
                    @if (!isSystemAdmin)
                    {
                        <label class="perm-group-toggle">
                            <input type="checkbox"
                                   class="group-toggle-cb"
                                   data-group="@group.GroupName"
                                   @(allChecked ? "checked" : "")
                                   onchange="toggleGroup('@group.GroupName', this.checked)" />
                            <span>الكل</span>
                        </label>
                    }
                </div>
            </div>

            <div class="perm-group-body">
                @foreach (var permission in group.Permissions)
                {
                    var isChecked = currentPermissions.Contains(permission.Key);
                    <label class="perm-item @(isChecked ? "checked" : "")" data-permission="@permission.Key">
                        <input type="checkbox"
                               class="perm-checkbox"
                               value="@permission.Key"
                               data-group="@group.GroupName"
                               @(isChecked ? "checked" : "")
                               @(isSystemAdmin ? "disabled" : "")
                               onchange="onPermissionChange(this)" />
                        <div class="perm-item-content">
                            <div class="perm-item-name">@permission.DisplayName</div>
                            <div class="perm-item-desc">@permission.Description</div>
                        </div>
                        <div class="perm-item-check">
                            <i class="fas fa-check"></i>
                        </div>
                    </label>
                }
            </div>
        </div>
    }
</div>

<!-- Toast Container -->
<div id="permToastContainer" style="position:fixed; top:80px; left:20px; z-index:9999;"></div>

@section Styles {
    <style>
        /* ═══════════════════════════════════════════════
                   Toolbar
                ═══════════════════════════════════════════════ */
        .perm-toolbar {
            background: white;
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
            margin-bottom: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            flex-wrap: wrap;
        }

        .perm-role-selector {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .perm-label {
            font-weight: 700;
            color: #0E4D3A;
            font-size: 15px;
            margin: 0;
        }

        .perm-role-select {
            background: white;
            border: 2px solid #e0e0e0;
            border-radius: 10px;
            padding: 10px 16px;
            font-size: 15px;
            font-weight: 600;
            color: #333;
            cursor: pointer;
            min-width: 200px;
            transition: all 0.3s;
        }

            .perm-role-select:hover {
                border-color: #0E4D3A;
            }

            .perm-role-select:focus {
                outline: none;
                border-color: #0E4D3A;
                box-shadow: 0 0 0 3px rgba(14, 77, 58, 0.1);
            }

        .perm-stats {
            display: flex;
            gap: 12px;
        }

        .perm-stat-box {
            background: linear-gradient(135deg, #0E4D3A, #1a6b52);
            color: white;
            padding: 12px 24px;
            border-radius: 12px;
            text-align: center;
            min-width: 140px;
        }

        .perm-stat-number {
            font-size: 28px;
            font-weight: 900;
            line-height: 1;
        }

        .perm-stat-label {
            font-size: 12px;
            opacity: 0.9;
            margin-top: 4px;
        }

        /* ═══════════════════════════════════════════════
                   Warning
                ═══════════════════════════════════════════════ */
        .perm-warning {
            background: linear-gradient(135deg, #fff3e0, #ffe0b2);
            border: 2px solid #ffb74d;
            border-radius: 12px;
            padding: 18px 24px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 16px;
            color: #e65100;
        }

            .perm-warning i {
                font-size: 32px;
            }

            .perm-warning strong {
                font-weight: 800;
            }

        /* ═══════════════════════════════════════════════
                   Action Buttons
                ═══════════════════════════════════════════════ */
        .perm-actions-bar {
            background: white;
            border-radius: 12px;
            padding: 16px 20px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
            margin-bottom: 20px;
            display: flex;
            gap: 12px;
            align-items: center;
            flex-wrap: wrap;
        }

        .perm-actions-spacer {
            flex: 1;
        }

        .perm-btn {
            border: none;
            padding: 10px 20px;
            border-radius: 10px;
            font-weight: 700;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.3s;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .perm-btn-select-all {
            background: #e8f5e9;
            color: #0E4D3A;
        }

            .perm-btn-select-all:hover {
                background: #c8e6c9;
            }

        .perm-btn-deselect-all {
            background: #fff3e0;
            color: #f57c00;
        }

            .perm-btn-deselect-all:hover {
                background: #ffe0b2;
            }

        .perm-btn-reset {
            background: #e3f2fd;
            color: #1976d2;
        }

            .perm-btn-reset:hover {
                background: #bbdefb;
            }

        .perm-btn-save {
            background: linear-gradient(135deg, #0E4D3A, #1a6b52);
            color: white;
            padding: 12px 28px;
            box-shadow: 0 4px 12px rgba(14, 77, 58, 0.3);
        }

            .perm-btn-save:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 16px rgba(14, 77, 58, 0.4);
            }

        /* ═══════════════════════════════════════════════
                   Permission Groups
                ═══════════════════════════════════════════════ */
        .perm-groups-container {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(420px, 1fr));
            gap: 20px;
        }

        .perm-group {
            background: white;
            border-radius: 14px;
            overflow: hidden;
            box-shadow: 0 2px 12px rgba(0,0,0,0.06);
            transition: all 0.3s;
        }

            .perm-group:hover {
                box-shadow: 0 4px 20px rgba(0,0,0,0.1);
                transform: translateY(-2px);
            }

        .perm-group-header {
            padding: 16px 20px;
            color: white;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
        }

        .perm-group-title {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 16px;
            font-weight: 800;
        }

            .perm-group-title i {
                font-size: 20px;
            }

        .perm-group-actions {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .perm-group-count {
            background: rgba(255,255,255,0.25);
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 700;
        }

        .perm-group-toggle {
            display: flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
            user-select: none;
            font-size: 13px;
            font-weight: 600;
            margin: 0;
        }

            .perm-group-toggle input {
                width: 18px;
                height: 18px;
                cursor: pointer;
            }

        .perm-group-body {
            padding: 12px;
            display: flex;
            flex-direction: column;
            gap: 6px;
            max-height: 400px;
            overflow-y: auto;
        }

            /* Custom Scrollbar */
            .perm-group-body::-webkit-scrollbar {
                width: 6px;
            }

            .perm-group-body::-webkit-scrollbar-track {
                background: #f5f5f5;
                border-radius: 3px;
            }

            .perm-group-body::-webkit-scrollbar-thumb {
                background: #ccc;
                border-radius: 3px;
            }

                .perm-group-body::-webkit-scrollbar-thumb:hover {
                    background: #999;
                }

        /* ═══════════════════════════════════════════════
                   Permission Item
                ═══════════════════════════════════════════════ */
        .perm-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px;
            background: #f9f9f9;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.2s;
            margin: 0;
            border: 2px solid transparent;
        }

            .perm-item:hover {
                background: #f0f0f0;
            }

            .perm-item.checked {
                background: #e8f5e9;
                border-color: #4caf50;
            }

        .perm-checkbox {
            width: 20px;
            height: 20px;
            cursor: pointer;
            accent-color: #0E4D3A;
            flex-shrink: 0;
        }

            .perm-checkbox:disabled {
                cursor: not-allowed;
                opacity: 0.6;
            }

        .perm-item-content {
            flex: 1;
            min-width: 0;
        }

        .perm-item-name {
            font-weight: 700;
            font-size: 14px;
            color: #333;
            margin-bottom: 2px;
        }

        .perm-item-desc {
            font-size: 12px;
            color: #777;
        }

        .perm-item-check {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: #4caf50;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            opacity: 0;
            transform: scale(0);
            transition: all 0.3s;
        }

        .perm-item.checked .perm-item-check {
            opacity: 1;
            transform: scale(1);
        }

        /* ═══════════════════════════════════════════════
                   Toast
                ═══════════════════════════════════════════════ */
        .perm-toast {
            background: white;
            border-radius: 12px;
            padding: 16px 24px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.15);
            margin-bottom: 10px;
            min-width: 300px;
            display: flex;
            align-items: center;
            gap: 12px;
            animation: slideInLeft 0.3s ease;
        }

        @@keyframes slideInLeft {
            from {
                transform: translateX(-100%);
                opacity: 0;
            }

            to {
                transform: translateX(0);
                opacity: 1;
            }
        }

        .perm-toast.success {
            border-right: 4px solid #4caf50;
        }

        .perm-toast.error {
            border-right: 4px solid #f44336;
        }

        .perm-toast i {
            font-size: 24px;
        }

        .perm-toast.success i {
            color: #4caf50;
        }

        .perm-toast.error i {
            color: #f44336;
        }

        .perm-toast-message {
            font-weight: 600;
            color: #333;
            flex: 1;
        }

        /* ═══════════════════════════════════════════════
                   Responsive
                ═══════════════════════════════════════════════ */
        @@media (max-width: 768px) {
            .perm-toolbar {
                flex-direction: column;
                align-items: stretch;
            }

            .perm-role-selector {
                flex-direction: column;
                align-items: stretch;
            }

            .perm-role-select {
                width: 100%;
            }

            .perm-groups-container {
                grid-template-columns: 1fr;
            }

            .perm-actions-bar {
                flex-direction: column;
                align-items: stretch;
            }
        }
    </style>
}

@section Scripts {
    <script>
        const selectedRole = '@selectedRole';
        const isSystemAdmin = @isSystemAdmin.ToString().ToLower();

        // ═══════════════════════════════════════════════
        // تحديث Counter عند تغيير صلاحية
        // ═══════════════════════════════════════════════
        function onPermissionChange(checkbox) {
            const item = checkbox.closest('.perm-item');
            if (checkbox.checked) {
                item.classList.add('checked');
            } else {
                item.classList.remove('checked');
            }

            updateCounts();
        }

        // ═══════════════════════════════════════════════
        // تحديث جميع العدادات
        // ═══════════════════════════════════════════════
        function updateCounts() {
            // العداد الإجمالي
            const allCheckboxes = document.querySelectorAll('.perm-checkbox');
            const checkedCount = document.querySelectorAll('.perm-checkbox:checked').length;
            document.getElementById('selectedCount').textContent = checkedCount;

            // عداد كل مجموعة
            document.querySelectorAll('.perm-group').forEach(group => {
                const groupName = group.dataset.group;
                const groupCheckboxes = group.querySelectorAll('.perm-checkbox');
                const groupChecked = group.querySelectorAll('.perm-checkbox:checked').length;

                const countSpan = group.querySelector('.group-selected-count');
                if (countSpan) countSpan.textContent = groupChecked;

                // تحديث "الكل" checkbox
                const groupToggle = group.querySelector('.group-toggle-cb');
                if (groupToggle) {
                    groupToggle.checked = groupChecked === groupCheckboxes.length;
                }
            });
        }

        // ═══════════════════════════════════════════════
        // تحديد/إلغاء قسم كامل
        // ═══════════════════════════════════════════════
        function toggleGroup(groupName, checked) {
            const group = document.querySelector(`.perm-group[data-group="${groupName}"]`);
            if (!group) return;

            group.querySelectorAll('.perm-checkbox').forEach(cb => {
                cb.checked = checked;
                const item = cb.closest('.perm-item');
                if (checked) {
                    item.classList.add('checked');
                } else {
                    item.classList.remove('checked');
                }
            });

            updateCounts();
        }

        // ═══════════════════════════════════════════════
        // تحديد الكل
        // ═══════════════════════════════════════════════
        function selectAllPermissions() {
            document.querySelectorAll('.perm-checkbox').forEach(cb => {
                cb.checked = true;
                cb.closest('.perm-item').classList.add('checked');
            });
            document.querySelectorAll('.group-toggle-cb').forEach(cb => {
                cb.checked = true;
            });
            updateCounts();
            showToast('تم تحديد جميع الصلاحيات', 'success');
        }

        // ═══════════════════════════════════════════════
        // إلغاء الكل
        // ═══════════════════════════════════════════════
        function deselectAllPermissions() {
            document.querySelectorAll('.perm-checkbox').forEach(cb => {
                cb.checked = false;
                cb.closest('.perm-item').classList.remove('checked');
            });
            document.querySelectorAll('.group-toggle-cb').forEach(cb => {
                cb.checked = false;
            });
            updateCounts();
            showToast('تم إلغاء تحديد جميع الصلاحيات', 'success');
        }

        // ═══════════════════════════════════════════════
        // حفظ الصلاحيات
        // ═══════════════════════════════════════════════
        async function savePermissions() {
            const permissions = [];
            document.querySelectorAll('.perm-checkbox:checked').forEach(cb => {
                permissions.push(cb.value);
            });

            try {
                const response = await fetch('@Url.Action("SaveRolePermissions", "Settings")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                    },
                    body: JSON.stringify({
                        roleName: selectedRole,
                        permissions: permissions
                    })
                });

                const data = await response.json();

                if (data.success) {
                    showToast(data.message, 'success');
                } else {
                    showToast(data.message || 'حدث خطأ', 'error');
                }
            } catch (error) {
                showToast('فشل الاتصال بالخادم', 'error');
                console.error(error);
            }
        }

        // ═══════════════════════════════════════════════
        // إعادة تعيين الافتراضي
        // ═══════════════════════════════════════════════
        async function resetToDefault() {
            if (!confirm(`هل تريد إعادة تعيين الصلاحيات الافتراضية لدور "${selectedRole}"؟`)) {
                return;
            }

            try {
                const formData = new FormData();
                formData.append('roleName', selectedRole);

                const response = await fetch('@Url.Action("ResetRolePermissions", "Settings")', {
                    method: 'POST',
                    body: formData
                });

                const data = await response.json();

                if (data.success) {
                    showToast(data.message, 'success');
                    // إعادة تحميل الصفحة لعرض الصلاحيات الجديدة
                    setTimeout(() => location.reload(), 1000);
                } else {
                    showToast(data.message || 'حدث خطأ', 'error');
                }
            } catch (error) {
                showToast('فشل الاتصال بالخادم', 'error');
                console.error(error);
            }
        }

        // ═══════════════════════════════════════════════
        // Toast Messages
        // ═══════════════════════════════════════════════
        function showToast(message, type = 'success') {
            const container = document.getElementById('permToastContainer');
            const toast = document.createElement('div');
            toast.className = `perm-toast ${type}`;
            toast.innerHTML = `
                <i class="fas ${type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle'}"></i>
                <span class="perm-toast-message">${message}</span>
            `;
            container.appendChild(toast);

            setTimeout(() => {
                toast.style.animation = 'slideInLeft 0.3s ease reverse';
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }
    </script>

    @Html.AntiForgeryToken()
}