@{
    ViewData["Title"] = "الدعم والتواصل";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div dir="rtl"> 
    <!-- ===== PAGE HEADER ===== -->
    <div class="settings-page-header">
        <h4 class="settings-title">
            <i class="fas fa-cog me-2"></i> التواصل والدعم
        </h4>

        <!-- ===== TABS NAV ===== -->
        <div class="settings-tabs">
            <a href="@Url.Action("Index", "Settings")"
               class="settings-tab @(ViewData["ActiveTab"]?.ToString() == "company" ? "active" : "")">
                <i class="fas fa-building me-1"></i> بيانات المؤسسة
            </a>
            <a href="@Url.Action("Users", "Settings")"
               class="settings-tab @(ViewData["ActiveTab"]?.ToString() == "users" ? "active" : "")">
                <i class="fas fa-users me-1"></i> المستخدمون
            </a>
            <a href="@Url.Action("Database", "Settings")"
               class="settings-tab @(ViewData["ActiveTab"]?.ToString() == "database" ? "active" : "")">
                <i class="fas fa-database me-1"></i> قاعدة البيانات
            </a>
            <a href="@Url.Action("Support", "Settings")"
               class="settings-tab @(ViewData["ActiveTab"]?.ToString() == "support" ? "active" : "")">
                <i class="fas fa-headset me-1"></i> الدعم
            </a>
        </div>
    </div>

    <!-- ===== SUPPORT CONTENT ===== -->
    <div class="support-wrapper">

        <!-- HERO BANNER -->
        <div class="support-hero">
            <div class="hero-badge">
                <i class="fas fa-heart text-danger me-1"></i>
                🏅  نسخة مرخَّصة رسمياً
            </div>
            <h1 class="hero-title">تواصل معي وأرسل ملاحظاتك</h1>
            <p class="hero-subtitle">
                إذا واجهت مشكلة، أو لديك اقتراح لتطوير البرنامج، أو تريد برنامجاً خاصاً،
                فبإمكانك التواصل المباشر معي عبر LinkedIn أو WhatsApp.
                ويمكنك أيضاً متابعة صفحتي على Facebook للمحتوى التعليمي التقني.
            </p>
            <div class="hero-buttons">
                <a href="https://www.linkedin.com/in/ibrahim-benyounes-08471532/"
                   target="_blank" class="btn-hero btn-linkedin">
                    <i class="fab fa-linkedin me-2"></i>
                    تواصل على LinkedIn
                </a>
                <a href="https://www.facebook.com/brahiminfobenyounes/"
                   target="_blank" class="btn-hero btn-facebook">
                    <i class="fab fa-facebook me-2"></i>
                    صفحة Facebook
                </a>
            </div>
        </div>

        <!-- MAIN GRID -->
        <div class="row g-4 mt-1">

            <!-- ===== RIGHT COLUMN ===== -->
            <div class="col-lg-5">

                <!-- About Developer Card -->
                <div class="support-card">
                    <div class="support-card-header green-header">
                        <i class="fas fa-user-circle me-2"></i>
                        نبذة عن المطوّر
                    </div>
                    <div class="support-card-body">

                        <!-- Profile -->
                        <div class="dev-profile">
                            <div class="dev-avatar">ب.إ</div>
                            <div class="dev-info">
                                <h5 class="dev-name">بن يونس ابراهيم</h5>
                                <p class="dev-title">
                                    مهندس برمجيات | ماستر إعلام آلي<br />
                                    <small class="text-muted">أنظمة معلومات متقدمة</small>
                                </p>
                            </div>
                        </div>

                        <!-- Description -->
                        <p class="dev-desc">
                            مرحباً بك، أنا <strong>بن يونس ابراهيم</strong>، مهندس برمجيات
                            وحاصل على ماستر في إعلام آلي تخصص أنظمة معلومات متقدمة.
                            أقدم حلولاً برمجية متكاملة في مجال إدارة المخزون والتجارة
                            بالجملة مع التركيز على الجودة والأداء.
                        </p>

                        <!-- Quick Links -->
                        <div class="quick-links">
                            <a href="https://www.linkedin.com/in/ibrahim-benyounes-08471532/"
                               target="_blank" class="quick-link">
                                <i class="fab fa-linkedin text-primary"></i>
                                <span>linkedin.com/in/ibrahim-benyounes</span>
                                <i class="fas fa-external-link-alt ms-auto text-muted small"></i>
                            </a>
                            <a href="https://www.facebook.com/brahiminfobenyounes/"
                               target="_blank" class="quick-link">
                                <i class="fab fa-facebook" style="color:#1877f2"></i>
                                <span>facebook.com/brahiminfobenyounes</span>
                                <i class="fas fa-external-link-alt ms-auto text-muted small"></i>
                            </a>
                            <a href="https://wa.me/213551735294"
                               target="_blank" class="quick-link">
                                <i class="fab fa-whatsapp text-success"></i>
                                <span dir="ltr">+213 551-73-52-94</span>
                                <i class="fas fa-external-link-alt ms-auto text-muted small"></i>
                            </a>
                            <div class="quick-link non-link">
                                <i class="fas fa-phone text-success"></i>
                                <span dir="ltr">0790-05-86-77</span>
                            </div>
                        </div>

                        <!-- System Note -->
                        <div class="system-note">
                            <i class="fas fa-shield-alt me-2 text-warning"></i>
                             <strong>SmarterGros</strong> جميع حقوق هذا البرنامج محفوظة،
                            | 📜  رقم الترخيص : SG-PRO-2025-DZ-IBY-7834
                        </div>

                        <!-- Skills -->
                        <div class="skills-section">
                            <p class="skills-title">
                                <i class="fas fa-code me-1"></i> التخصصات التقنية
                            </p>
                            <div class="skills-tags">
                                <span class="skill-tag"><i class="fab fa-microsoft me-1"></i>ASP.NET Core</span>
                                <span class="skill-tag"><i class="fas fa-database me-1"></i>SQL Server</span>
                                <span class="skill-tag"><i class="fab fa-js me-1"></i>JavaScript</span>
                                <span class="skill-tag"><i class="fas fa-layer-group me-1"></i>EF Core</span>
                                <span class="skill-tag"><i class="fas fa-boxes me-1"></i>إدارة المخزون</span>
                                <span class="skill-tag"><i class="fas fa-chart-bar me-1"></i>التقارير</span>
                                <span class="skill-tag"><i class="fas fa-cogs me-1"></i>أنظمة ERP</span>
                                <span class="skill-tag"><i class="fas fa-graduation-cap me-1"></i>أنظمة المعلومات</span>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- ===== LEFT COLUMN ===== -->
            <div class="col-lg-7">

                <!-- Card 1: إرسال مشكلة -->
                <div class="support-card mb-4">
                    <div class="support-card-header">
                        <i class="fas fa-bug text-danger me-2"></i>
                        إرسال مشكلة أو ملاحظة
                    </div>
                    <div class="support-card-body">
                        <p class="card-desc">
                            إذا ظهر خطأ في النظام أو لديك اقتراح تحسين أو ملاحظة واجهة،
                            أرسلها مباشرة عبر واتساب مع صورة أو وصف مختصر للمشكلة.
                        </p>
                        <a href="https://wa.me/213551735294"
                           target="_blank"
                           class="contact-btn whatsapp-btn">
                            <div class="contact-icon whatsapp-icon">
                                <i class="fab fa-whatsapp"></i>
                            </div>
                            <div class="contact-text">
                                <span class="contact-label">فتح واتساب</span>
                                <span class="contact-sub" dir="ltr">+213 551-73-52-94</span>
                            </div>
                        </a>
                    </div>
                </div>

                <!-- Card 2: التواصل المباشر -->
                <div class="support-card mb-4">
                    <div class="support-card-header">
                        <i class="fas fa-phone-alt text-success me-2"></i>
                        التواصل المباشر
                    </div>
                    <div class="support-card-body">
                        <p class="card-desc">
                            يمكنك الاتصال المباشر أو إرسال رسالة عبر الأرقام التالية
                            لطلب دعم فوري أو الاستفسار عن تطوير برنامج خاص.
                        </p>
                        <div class="phone-list">
                            <div class="phone-item">
                                <div class="phone-icon-wrap">
                                    <i class="fas fa-mobile-alt"></i>
                                </div>
                                <div class="phone-details">
                                    <span class="phone-label">رقم الهاتف الأول</span>
                                    <span class="phone-num" dir="ltr">0551-73-52-94</span>
                                </div>
                                <a href="tel:+213551735294" class="call-btn">
                                    <i class="fas fa-phone me-1"></i> اتصال
                                </a>
                            </div>
                            <div class="phone-item">
                                <div class="phone-icon-wrap">
                                    <i class="fas fa-mobile-alt"></i>
                                </div>
                                <div class="phone-details">
                                    <span class="phone-label">رقم الهاتف الثاني</span>
                                    <span class="phone-num" dir="ltr">0790-05-86-77</span>
                                </div>
                                <a href="tel:+213790058677" class="call-btn">
                                    <i class="fas fa-phone me-1"></i> اتصال
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Card 3: LinkedIn -->
                <div class="support-card mb-4">
                    <div class="support-card-header">
                        <i class="fab fa-linkedin text-primary me-2"></i>
                        تواصل عبر LinkedIn
                    </div>
                    <div class="support-card-body">
                        <p class="card-desc">
                            للتواصل المهني وطلب التعاون في المشاريع البرمجية
                            أو الاستفسار عن الخدمات التقنية.
                        </p>
                        <a href="https://www.linkedin.com/in/ibrahim-benyounes-08471532/"
                           target="_blank"
                           class="contact-btn linkedin-btn">
                            <div class="contact-icon linkedin-icon">
                                <i class="fab fa-linkedin"></i>
                            </div>
                            <div class="contact-text">
                                <span class="contact-label">فتح LinkedIn</span>
                                <span class="contact-sub">ibrahim-benyounes-08471532</span>
                            </div>
                        </a>
                    </div>
                </div>

                <!-- Card 4: Facebook -->
                <div class="support-card">
                    <div class="support-card-header">
                        <i class="fab fa-facebook me-2" style="color:#1877f2"></i>
                        صفحة Facebook
                    </div>
                    <div class="support-card-body">
                        <p class="card-desc">
                            تابع الصفحة على Facebook لمتابعة المحتوى التقني
                            والدروس التعليمية والمستجدات البرمجية.
                        </p>
                        <a href="https://www.facebook.com/brahiminfobenyounes/"
                           target="_blank"
                           class="contact-btn facebook-btn">
                            <div class="contact-icon facebook-icon">
                                <i class="fab fa-facebook-f"></i>
                            </div>
                            <div class="contact-text">
                                <span class="contact-label">فتح الصفحة</span>
