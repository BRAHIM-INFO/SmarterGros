            padding: 0;
            font-family: 'Tajawal', sans-serif;
        }

        /* --- HERO --- */
        .support-hero {
            background: linear-gradient(135deg, #1a5c38 0%, #2d8653 50%, #3aa870 100%);
            color: white;
            padding: 40px 35px 35px;
            border-radius: 16px;
            margin-bottom: 28px;
            position: relative;
            overflow: hidden;
        }

            .support-hero::before {
                content: '';
                position: absolute;
                top: -50px;
                left: -50px;
                width: 200px;
                height: 200px;
                background: rgba(255,255,255,0.05);
                border-radius: 50%;
            }

            .support-hero::after {
                content: '';
                position: absolute;
                bottom: -80px;
                right: 100px;
                width: 300px;
                height: 300px;
                background: rgba(255,255,255,0.03);
                border-radius: 50%;
            }

        .hero-badge {
            display: inline-flex;
            align-items: center;
            background: rgba(255,255,255,0.15);
            border: 1px solid rgba(255,255,255,0.3);
            padding: 6px 16px;
            border-radius: 50px;
            font-size: 13px;
            margin-bottom: 16px;
            backdrop-filter: blur(4px);
