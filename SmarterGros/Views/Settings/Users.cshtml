@section Scripts {
<script>
// ============================================
// ROLES PERMISSIONS DATA
// ============================================
const rolesPermissions = {
    "مدير النظام": [
        "لوحة التحكم", "المنتجات", "المخزون", "المشتريات",
        "المبيعات", "الموردون", "العملاء", "التقارير", "الإعدادات"
    ],
    "مدير المخزن": [
        "لوحة التحكم", "المنتجات", "المخزون", "التقارير"
    ],
    "مسؤول المبيعات": [
        "لوحة التحكم", "المبيعات", "العملاء", "التقارير"
    ],
    "مسؤول المشتريات": [
        "لوحة التحكم", "المشتريات", "الموردون", "التقارير"
    ],
    "مستخدم عادي": [
        "لوحة التحكم", "المنتجات"
    ]
};

const roleColors = {
    "مدير النظام":       { bg: "#fef3c7", color: "#b45309" },
    "مدير المخزن":       { bg: "#dcfce7", color: "#15803d" },
    "مسؤول المبيعات":    { bg: "#dbeafe", color: "#1d4ed8" },
    "مسؤول المشتريات":   { bg: "#ede9fe", color: "#7c3aed" },
    "مستخدم عادي":       { bg: "#f0f9f4", color: "#0E4D3A" }
};

// ============================================
// ADD USER MODAL
// ============================================
function openAddModal() {
    clearAddForm();
    document.getElementById('addUserModal').classList.add('show');
    setTimeout(() => document.getElementById('addFullName').focus(), 100);
}

function closeAddModal() {
    document.getElementById('addUserModal').classList.remove('show');
}

function clearAddForm() {
    ['addFullName','addUserName','addEmail','addPhone','addPassword','addConfirmPassword']
        .forEach(id => document.getElementById(id).value = '');
    document.getElementById('addRole').value = '';
    document.getElementById('addAvatarPreview').textContent = 'م';
    document.getElementById('addNamePreview').textContent = 'الاسم الكامل';
    document.getElementById('addRolePreview').textContent = 'الدور الوظيفي';
    document.getElementById('addRolePreview').style.background = '#e8f5e9';
    document.getElementById('addRolePreview').style.color = '#0E4D3A';
    document.getElementById('permissionsPreview').style.display = 'none';
    ['addFullNameError','addUserNameError','addRoleError','addPasswordError','addConfirmError']
        .forEach(id => document.getElementById(id).textContent = '');
    document.getElementById('addPassStrength').style.display = 'none';
}

// Update Preview
document.getElementById('addFullName').addEventListener('input', function() {
    const val = this.value.trim();
    document.getElementById('addNamePreview').textContent = val || 'الاسم الكامل';
    document.getElementById('addAvatarPreview').textContent = val ? val[0].toUpperCase() : 'م';
});

function updateRolePreview() {
    const role = document.getElementById('addRole').value;
    const preview = document.getElementById('addRolePreview');
    const permsDiv = document.getElementById('permissionsPreview');

    if (role) {
        const rc = roleColors[role] || { bg: '#e8f5e9', color: '#0E4D3A' };
        preview.textContent = role;
        preview.style.background = rc.bg;
        preview.style.color = rc.color;

        // Show permissions
        const perms = rolesPermissions[role] || [];
        document.getElementById('permList').innerHTML = perms
            .map(p => `<span class="usr-perm-item"><i class="fas fa-check"></i>${p}</span>`)
            .join('');
        permsDiv.style.display = 'block';
    } else {
        preview.textContent = 'الدور الوظيفي';
        permsDiv.style.display = 'none';
    }
}

// Password Strength
document.getElementById('addPassword').addEventListener('input', function() {
    checkPasswordStrength(this.value, 'addPassStrength', 'addStrengthFill', 'addStrengthText');
});

async function saveNewUser() {
    // Validate
    let valid = true;

    const fullName = document.getElementById('addFullName').value.trim();
    const userName = document.getElementById('addUserName').value.trim();
    const role     = document.getElementById('addRole').value;
    const password = document.getElementById('addPassword').value;
    const confirm  = document.getElementById('addConfirmPassword').value;

    if (!fullName) {
        document.getElementById('addFullNameError').textContent = 'الاسم الكامل مطلوب';
        valid = false;
    } else {
        document.getElementById('addFullNameError').textContent = '';
    }

    if (!userName) {
        document.getElementById('addUserNameError').textContent = 'اسم المستخدم مطلوب';
        valid = false;
    } else {
        document.getElementById('addUserNameError').textContent = '';
    }

    if (!role) {
        document.getElementById('addRoleError').textContent = 'الدور الوظيفي مطلوب';
        valid = false;
    } else {
        document.getElementById('addRoleError').textContent = '';
    }

    if (password.length < 6) {
        document.getElementById('addPasswordError').textContent = 'كلمة المرور يجب أن تكون 6 أحرف على الأقل';
        valid = false;
    } else {
        document.getElementById('addPasswordError').textContent = '';
    }

    if (password !== confirm) {
        document.getElementById('addConfirmError').textContent = 'كلمتا المرور غير متطابقتين';
        valid = false;
    } else {
        document.getElementById('addConfirmError').textContent = '';
    }

    if (!valid) return;

    const btn = document.getElementById('addSaveBtn');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>جاري الإنشاء...';

    try {
        const res = await fetch('/Settings/CreateUser', {
            method:  'POST',
            headers: { 'Content-Type': 'application/json' },
            body:    JSON.stringify({
                fullName,
                userName,
                email:           document.getElementById('addEmail').value.trim(),
                phoneNumber:     document.getElementById('addPhone').value.trim(),
                role,
                password,
                confirmPassword: confirm
            })
        });

        const result = await res.json();

        if (result.success) {
            showToast(result.message, 'success');
            closeAddModal();
            setTimeout(() => location.reload(), 800);
        } else {
            showToast(result.message, 'error');
        }
    } catch(e) {
        showToast('خطأ في الاتصال', 'error');
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-user-plus me-1"></i>إنشاء المستخدم';
    }
}

// ============================================
// EDIT USER MODAL
// ============================================
async function openEditModal(id) {
    const res  = await fetch(`/Settings/GetUser/${id}`);
    const data = await res.json();

    if (!data.success) { showToast('خطأ في تحميل البيانات', 'error'); return; }

    document.getElementById('editUserId').value         = data.id;
    document.getElementById('editFullName').value       = data.fullName;
    document.getElementById('editUserName').value       = data.userName;
    document.getElementById('editEmail').value          = data.email || '';
    document.getElementById('editPhone').value          = data.phoneNumber || '';
    document.getElementById('editRole').value           = data.role;
    document.getElementById('editIsActive').checked     = data.isActive;
    document.getElementById('editAvatarPreview').textContent  = data.fullName[0].toUpperCase();
    document.getElementById('editNamePreview').textContent    = data.fullName;
    document.getElementById('editUserNamePreview').textContent = String.fromCharCode(64) + data.userName;
    document.getElementById('editIsActiveLabel').textContent  = data.isActive ? 'نشط' : 'معطل';
    document.getElementById('editIsActiveLabel').className    =
        'fw-bold ' + (data.isActive ? 'text-success' : 'text-danger');

    document.getElementById('editUserModal').classList.add('show');
}

function closeEditModal() {
    document.getElementById('editUserModal').classList.remove('show');
}

document.getElementById('editIsActive').addEventListener('change', function() {
    document.getElementById('editIsActiveLabel').textContent  = this.checked ? 'نشط' : 'معطل';
    document.getElementById('editIsActiveLabel').className    =
        'fw-bold ' + (this.checked ? 'text-success' : 'text-danger');
});

async function saveEditUser() {
    const btn = document.getElementById('editSaveBtn');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>جاري الحفظ...';

    try {
        const res = await fetch('/Settings/EditUser', {
            method:  'POST',
            headers: { 'Content-Type': 'application/json' },
            body:    JSON.stringify({
                id:          document.getElementById('editUserId').value,
                fullName:    document.getElementById('editFullName').value.trim(),
                userName:    document.getElementById('editUserName').value.trim(),
                email:       document.getElementById('editEmail').value.trim(),
                phoneNumber: document.getElementById('editPhone').value.trim(),
                role:        document.getElementById('editRole').value,
                isActive:    document.getElementById('editIsActive').checked
            })
        });

        const result = await res.json();

        if (result.success) {
            showToast(result.message, 'success');
            closeEditModal();
            setTimeout(() => location.reload(), 800);
        } else {
            showToast(result.message, 'error');
        }
    } catch(e) {
        showToast('خطأ في الاتصال', 'error');
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-save me-1"></i>حفظ التغييرات';
    }
}

// ============================================
// PASSWORD MODAL
// ============================================
function openPasswordModal(id, name) {
    document.getElementById('passUserId').value          = id;
    document.getElementById('passUserName').textContent  = name;
    document.getElementById('newPassword').value         = '';
    document.getElementById('confirmNewPassword').value  = '';
    document.getElementById('passConfirmError').textContent = '';
    document.getElementById('newPassStrength').style.display = 'none';
    document.getElementById('passwordModal').classList.add('show');
}

function closePasswordModal() {
    document.getElementById('passwordModal').classList.remove('show');
}

document.getElementById('newPassword').addEventListener('input', function() {
    checkPasswordStrength(this.value, 'newPassStrength', 'newStrengthFill', 'newStrengthText');
});

async function savePassword() {
    const newPass  = document.getElementById('newPassword').value;
    const confirm  = document.getElementById('confirmNewPassword').value;

    if (newPass.length < 6) {
        showToast('كلمة المرور يجب أن تكون 6 أحرف على الأقل', 'error');
        return;
    }

    if (newPass !== confirm) {
        document.getElementById('passConfirmError').textContent = 'كلمتا المرور غير متطابقتين';
        return;
    }

    document.getElementById('passConfirmError').textContent = '';

    const btn = document.getElementById('passSaveBtn');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>جاري التغيير...';

    try {
        const res = await fetch('/Settings/ChangePassword', {
            method:  'POST',
            headers: { 'Content-Type': 'application/json' },
            body:    JSON.stringify({
                userId:          document.getElementById('passUserId').value,
                newPassword:     newPass,
                confirmPassword: confirm
            })
        });

        const result = await res.json();

        if (result.success) {
            showToast(result.message, 'success');
            closePasswordModal();
        } else {
            showToast(result.message, 'error');
        }
    } catch(e) {
        showToast('خطأ في الاتصال', 'error');
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-key me-1"></i>تغيير كلمة المرور';
    }
}

// ============================================
// TOGGLE USER
// ============================================
async function toggleUser(id, name, isActive) {
    const action = isActive ? 'تعطيل' : 'تفعيل';
    if (!confirm(`هل تريد ${action} حساب "${name}"؟`)) return;

    try {
        const res    = await fetch(`/Settings/ToggleUser?id=${id}`, { method: 'POST' });
        const result = await res.json();

        if (result.success) {
            showToast(result.message, 'success');
            setTimeout(() => location.reload(), 800);
        } else {
            showToast(result.message, 'error');
        }
    } catch(e) {
        showToast('خطأ في الاتصال', 'error');
    }
}

// ============================================
// DELETE USER
// ============================================
function deleteUser(id, name) {
    document.getElementById('deleteUserMessage').textContent = `هل تريد حذف المستخدم "${name}"؟`;
    document.getElementById('confirmDeleteUserBtn').onclick  = () => confirmDeleteUser(id);
    document.getElementById('deleteUserModal').classList.add('show');
}

function closeDeleteModal() {
    document.getElementById('deleteUserModal').classList.remove('show');
}

async function confirmDeleteUser(id) {
    const btn = document.getElementById('confirmDeleteUserBtn');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>جاري الحذف...';

    try {
        const res    = await fetch(`/Settings/DeleteUser?id=${id}`, { method: 'POST' });
        const result = await res.json();

        if (result.success) {
            showToast(result.message, 'success');
            closeDeleteModal();
            setTimeout(() => location.reload(), 800);
        } else {
            showToast(result.message, 'error');
        }
    } catch(e) {
        showToast('خطأ في الاتصال', 'error');
    }
}

// ============================================
// PASSWORD STRENGTH CHECKER
// ============================================
function checkPasswordStrength(password, containerId, fillId, textId) {
    const container = document.getElementById(containerId);
    const fill      = document.getElementById(fillId);
    const text      = document.getElementById(textId);

    if (!password) { container.style.display = 'none'; return; }
    container.style.display = 'flex';

    let score = 0;
    if (password.length >= 6)  score++;
    if (password.length >= 10) score++;
    if (/[A-Z]/.test(password)) score++;
    if (/[0-9]/.test(password)) score++;
    if (/[^A-Za-z0-9]/.test(password)) score++;

    const levels = [
        { w: '20%',  bg: '#ef4444', label: 'ضعيفة جداً' },
        { w: '40%',  bg: '#f97316', label: 'ضعيفة' },
        { w: '60%',  bg: '#eab308', label: 'متوسطة' },
        { w: '80%',  bg: '#22c55e', label: 'قوية' },
        { w: '100%', bg: '#16a34a', label: 'قوية جداً' },
    ];

    const level = levels[Math.min(score, 4)];
    fill.style.width      = level.w;
    fill.style.background = level.bg;
    text.textContent      = level.label;
    text.style.color      = level.bg;
}

// ============================================
// TOGGLE PASSWORD VISIBILITY
// ============================================
function togglePassword(inputId, iconId) {
    const input = document.getElementById(inputId);
    const icon  = document.getElementById(iconId);
    if (input.type === 'password') {
        input.type       = 'text';
        icon.className   = 'fas fa-eye-slash';
    } else {
        input.type       = 'password';
        icon.className   = 'fas fa-eye';
    }
}

// ============================================
// CLOSE ON OVERLAY CLICK
// ============================================
['addUserModal','editUserModal','passwordModal','deleteUserModal'].forEach(id => {
    document.getElementById(id).addEventListener('click', function(e) {
        if (e.target === this) this.classList.remove('show');
    });
});

// ============================================
// TOAST
// ============================================
function showToast(message, type = 'success') {
    const icons = {
        success: 'fa-check-circle',
        error:   'fa-times-circle',
        warning: 'fa-exclamation-triangle'
    };
    const toast = document.createElement('div');
    toast.className = `sg-toast ${type}`;
    toast.innerHTML = `<i class="fas ${icons[type]}"></i> ${message}`;
    document.getElementById('toastContainer').appendChild(toast);
    setTimeout(() => {
        toast.style.transition = 'opacity 0.4s';
        toast.style.opacity    = '0';
        setTimeout(() => toast.remove(), 400);
    }, 3500);
}
</script>
}

@functions {
    dynamic GetRoleInfo(string role)
    {
        return role switch
        {
            "مدير النظام"      => new { Color = "#b45309", Bg = "#fef3c7", Icon = "fas fa-crown" },
            "مدير المخزن"      => new { Color = "#15803d", Bg = "#dcfce7", Icon = "fas fa-warehouse" },
            "مسؤول المبيعات"   => new { Color = "#1d4ed8", Bg = "#dbeafe", Icon = "fas fa-cash-register" },
            "مسؤول المشتريات"  => new { Color = "#7c3aed", Bg = "#ede9fe", Icon = "fas fa-shopping-cart" },
            _                  => new { Color = "#0E4D3A", Bg = "#f0f9f4", Icon = "fas fa-user" }
        };
    }
}