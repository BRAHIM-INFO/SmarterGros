@model List<SmarterGros.ViewModels.UserViewModel>
@{
    ViewData["Title"] = "إدارة المستخدمين";
    var roles = new List<string>
    {
        "مدير النظام", "مدير المخزن",
        "مسؤول المبيعات", "مسؤول المشتريات", "مستخدم عادي"
    };
}


<!-- Settings Tabs -->
<div class="sg-settings-tabs">
    <a href="@Url.Action("Index", "Settings")" class="sg-tab-btn">
        <i class="fas fa-building me-1"></i>بيانات المؤسسة
    </a>
    <a href="@Url.Action("Users", "Settings")" class="sg-tab-btn active">
        <i class="fas fa-users me-1"></i>المستخدمون
    </a>
    <a href="@Url.Action("RolesPermissions", "Settings")" class="sg-tab-btn">
        <i class="fas fa-user-shield me-1"></i>الصلاحيات
    </a>
    <a href="@Url.Action("Database", "Settings")" class="sg-tab-btn">
        <i class="fas fa-database me-1"></i>قاعدة البيانات
    </a>
    <a href="@Url.Action("Support", "Settings")" class="sg-tab-btn">
        <i class="fas fa-headset me-1"></i>الدعم
    </a>
</div>


<!-- Header -->
<div class="sg-page-header">
    <div class="sg-page-header-top">
        <div>
            <h1 class="sg-page-title-main">
                <i class="fas fa-users-cog me-2"></i>إدارة المستخدمين
            </h1>
            <p class="sg-page-subtitle">
                إدارة حسابات المستخدمين والصلاحيات
            </p>
        </div>
        <button class="btn sg-btn-primary" onclick="openAddModal()">
            <i class="fas fa-user-plus me-1"></i>+ مستخدم جديد
        </button>
    </div>

    <!-- Stats -->
    <div class="usr-stats-row">
        <div class="usr-stat green">
            <i class="fas fa-users"></i>
            <div>
                <span class="usr-stat-num">@ViewBag.TotalUsers</span>
                <span class="usr-stat-label">إجمالي المستخدمين</span>
            </div>
        </div>
        <div class="usr-stat blue">
            <i class="fas fa-user-check"></i>
            <div>
                <span class="usr-stat-num">@ViewBag.ActiveUsers</span>
                <span class="usr-stat-label">مستخدمون نشطون</span>
            </div>
        </div>
        <div class="usr-stat red">
            <i class="fas fa-user-times"></i>
            <div>
                <span class="usr-stat-num">@(ViewBag.TotalUsers - ViewBag.ActiveUsers)</span>
                <span class="usr-stat-label">حسابات معطلة</span>
            </div>
        </div>
        <div class="usr-stat gold">
            <i class="fas fa-user-shield"></i>
            <div>
                <span class="usr-stat-num">@Model.Count(u => u.Role == "مدير النظام")</span>
                <span class="usr-stat-label">مدراء النظام</span>
            </div>
        </div>
    </div>
</div>



<!-- Filters -->
<div class="sg-filters-bar">
    <form method="get" class="d-flex gap-2 align-items-center flex-wrap">
        <div class="sg-search-box">
            <i class="fas fa-search"></i>
            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   placeholder="بحث بالاسم أو اسم المستخدم..."
                   class="sg-search-input" />
        </div>
        <select name="role" class="sg-select">
            <option value="">كل الأدوار</option>
            @foreach (var r in roles)
            {
                if (ViewBag.RoleFilter == r)
                {
                    <option value="@r" selected="selected">@r</option>
                }
                else
                {
                    <option value="@r">@r</option>
                }
            }
        </select>
        <select name="status" class="sg-select">
            <option value="">كل الحالات</option>
            @if (ViewBag.StatusFilter == "active")
            {
                <option value="active" selected="selected">نشط</option>
                <option value="inactive">معطل</option>
            }
            else if (ViewBag.StatusFilter == "inactive")
            {
                <option value="active">نشط</option>
                <option value="inactive" selected="selected">معطل</option>
            }
            else
            {
                <option value="active">نشط</option>
                <option value="inactive">معطل</option>
            }
        </select>
        <button type="submit" class="btn sg-btn-search">
            <i class="fas fa-search me-1"></i>بحث
        </button>
        @if (!string.IsNullOrEmpty(ViewBag.Search as string) ||
             !string.IsNullOrEmpty(ViewBag.RoleFilter as string) ||
             !string.IsNullOrEmpty(ViewBag.StatusFilter as string))
        {
            <a href="@Url.Action("Users")" class="btn sg-btn-prev">
                <i class="fas fa-times me-1"></i>مسح
            </a>
        }
    </form>
    <span class="text-muted small fw-bold">@Model.Count مستخدم</span>
</div>

<!-- Users Grid -->
@if (!Model.Any())
{
    <div class="usr-empty">
        <div class="usr-empty-icon">
            <i class="fas fa-users"></i>
        </div>
        <h3>لا يوجد مستخدمون</h3>
        <p>ابدأ بإضافة مستخدم جديد</p>
        <button class="btn sg-btn-primary mt-3" onclick="openAddModal()">
            <i class="fas fa-user-plus me-1"></i>إضافة مستخدم
        </button>
    </div>
}
else
{
    <div class="usr-grid">
        @foreach (var user in Model)
        {
            var roleInfo = GetRoleInfo(user.Role);
            <div class="usr-card @(!user.IsActive ? "inactive" : "")">
                <!-- Card Header -->
                <div class="usr-card-header">
                    <div class="usr-avatar" style="background: @roleInfo.Color;">
                        @user.FullName.Substring(0, 1).ToUpper()
                    </div>
                    <div class="usr-status-dot @(user.IsActive ? "active" : "inactive")"
                         title="@(user.IsActive ? "نشط" : "معطل")">
                    </div>
                </div>

                <!-- Card Body -->
                <div class="usr-card-body">
                    <h3 class="usr-name">@user.FullName</h3>
                    <span class="usr-username">
                        <i class="fas fa-at me-1"></i>@user.UserName
                    </span>

                    <div class="usr-role-badge" style="background: @roleInfo.Bg; color: @roleInfo.Color;">
                        <i class="@roleInfo.Icon me-1"></i>@user.Role
                    </div>

                    @if (!string.IsNullOrEmpty(user.Email))
                    {
                        <div class="usr-info-row">
                            <i class="fas fa-envelope"></i>
                            <span>@user.Email</span>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(user.PhoneNumber))
                    {
                        <div class="usr-info-row">
                            <i class="fas fa-phone"></i>
                            <span>@user.PhoneNumber</span>
                        </div>
                    }

                    <div class="usr-info-row">
                        <i class="fas fa-calendar-plus"></i>
                        <span>@user.CreatedAt.ToString("dd/MM/yyyy")</span>
                    </div>

                    <div class="usr-status-row">
                        @if (user.IsActive)
                        {
                            <span class="sg-status-badge success">
                                <i class="fas fa-circle me-1" style="font-size:7px;"></i>نشط
                            </span>
                        }
                        else
                        {
                            <span class="sg-status-badge danger">
                                <i class="fas fa-circle me-1" style="font-size:7px;"></i>معطل
                            </span>
                        }
                    </div>
                </div>

                <!-- Card Actions -->
                <div class="usr-card-footer">
                    <button class="usr-btn edit"
                            onclick="openEditModal('@user.Id')"
                            title="تعديل">
                        <i class="fas fa-edit"></i>
                        <span>تعديل</span>
                    </button>
                    <button class="usr-btn password"
                            onclick="openPasswordModal('@user.Id', '@user.FullName')"
                            title="تغيير كلمة المرور">
                        <i class="fas fa-key"></i>
                    </button>
                    <button class="usr-btn @(user.IsActive ? "deactivate" : "activate")"
                            onclick="toggleUser('@user.Id', '@user.FullName', @user.IsActive.ToString().ToLower())"
                            title="@(user.IsActive ? "تعطيل" : "تفعيل")">
                        <i class="fas fa-@(user.IsActive ? "ban" : "check-circle")"></i>
                    </button>
                    <button class="usr-btn delete"
                            onclick="deleteUser('@user.Id', '@user.FullName')"
                            title="حذف">
                        <i class="fas fa-trash"></i>
                    </button>
                </div>
            </div>
        }
    </div>
}

<!-- ============================================
     MODAL: إضافة مستخدم جديد
============================================ -->
<div class="sg-modal-overlay" id="addUserModal">
    <div class="sg-modal" style="max-width: 600px;">
        <div class="sg-modal-header">
            <h2 class="sg-modal-title">
                <i class="fas fa-user-plus me-2"></i>إضافة مستخدم جديد
            </h2>
            <button class="sg-modal-close" onclick="closeAddModal()">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <div class="sg-modal-body">
            <!-- Avatar Preview -->
            <div class="usr-modal-avatar-row">
                <div class="usr-modal-avatar" id="addAvatarPreview">م</div>
                <div>
                    <h4 id="addNamePreview" style="margin:0; font-size:16px; font-weight:800;">
                        الاسم الكامل
                    </h4>
                    <span id="addRolePreview" class="usr-role-badge"
                          style="background:#e8f5e9; color:#0E4D3A;">
                        الدور الوظيفي
                    </span>
                </div>
            </div>

            <div class="usr-form-divider">المعلومات الأساسية</div>

            <div class="sg-form-row">
                <div class="sg-form-group">
                    <label><i class="fas fa-user me-1 text-success"></i>الاسم الكامل *</label>
                    <input type="text" id="addFullName" class="sg-form-input"
                           placeholder="مثال: أحمد محمد" maxlength="200" />
                    <span class="text-danger small" id="addFullNameError"></span>
                </div>
                <div class="sg-form-group">
                    <label><i class="fas fa-at me-1 text-primary"></i>اسم المستخدم *</label>
                    <input type="text" id="addUserName" class="sg-form-input"
                           placeholder="مثال: ahmed.mohamed" maxlength="100" />
                    <span class="text-danger small" id="addUserNameError"></span>
                </div>
            </div>

            <div class="sg-form-row">
                <div class="sg-form-group">
                    <label><i class="fas fa-envelope me-1 text-warning"></i>البريد الإلكتروني</label>
                    <input type="email" id="addEmail" class="sg-form-input"
                           placeholder="example@email.com" />
                </div>
                <div class="sg-form-group">
                    <label><i class="fas fa-phone me-1 text-info"></i>رقم الهاتف</label>
                    <input type="text" id="addPhone" class="sg-form-input"
                           placeholder="0550000000" />
                </div>
            </div>

            <div class="sg-form-group">
                <label><i class="fas fa-user-shield me-1 text-purple"></i>الدور الوظيفي *</label>
                <select id="addRole" class="sg-form-select" onchange="updateRolePreview()">
                    <option value="">-- اختر الدور --</option>
                    @foreach (var r in roles)
                    {
                        <option value="@r">@r</option>
                    }
                </select>
                <span class="text-danger small" id="addRoleError"></span>
            </div>

            <!-- Permissions Preview -->
            <div class="usr-permissions-preview" id="permissionsPreview" style="display:none;">
                <div class="usr-perm-title">
                    <i class="fas fa-shield-alt me-1"></i>صلاحيات هذا الدور:
                </div>
                <div class="usr-perm-list" id="permList"></div>
            </div>

            <div class="usr-form-divider">كلمة المرور</div>

            <div class="sg-form-row">
                <div class="sg-form-group">
                    <label><i class="fas fa-lock me-1 text-danger"></i>كلمة المرور *</label>
                    <div class="usr-pass-input">
                        <input type="password" id="addPassword" class="sg-form-input"
                               placeholder="6 أحرف على الأقل" />
                        <button type="button" class="usr-pass-toggle"
                                onclick="togglePassword('addPassword', 'addPassIcon')">
                            <i class="fas fa-eye" id="addPassIcon"></i>
                        </button>
                    </div>
                    <div class="usr-pass-strength" id="addPassStrength" style="display:none;">
                        <div class="usr-strength-bar">
                            <div class="usr-strength-fill" id="addStrengthFill"></div>
                        </div>
                        <span id="addStrengthText"></span>
                    </div>
                    <span class="text-danger small" id="addPasswordError"></span>
                </div>
                <div class="sg-form-group">
                    <label><i class="fas fa-lock me-1 text-danger"></i>تأكيد كلمة المرور *</label>
                    <div class="usr-pass-input">
                        <input type="password" id="addConfirmPassword" class="sg-form-input"
                               placeholder="أعد كتابة كلمة المرور" />
                        <button type="button" class="usr-pass-toggle"
                                onclick="togglePassword('addConfirmPassword', 'addConfirmIcon')">
                            <i class="fas fa-eye" id="addConfirmIcon"></i>
                        </button>
                    </div>
                    <span class="text-danger small" id="addConfirmError"></span>
                </div>
            </div>
        </div>

        <div class="sg-modal-footer">
            <button class="sg-btn-cancel" onclick="closeAddModal()">
                <i class="fas fa-times me-1"></i>إلغاء
            </button>
            <button class="sg-btn-next" id="addSaveBtn" onclick="saveNewUser()">
                <i class="fas fa-user-plus me-1"></i>إنشاء المستخدم
            </button>
        </div>
    </div>
</div>

<!-- ============================================
     MODAL: تعديل مستخدم
============================================ -->
<div class="sg-modal-overlay" id="editUserModal">
    <div class="sg-modal" style="max-width: 600px;">
        <div class="sg-modal-header">
            <h2 class="sg-modal-title">
                <i class="fas fa-user-edit me-2"></i>تعديل بيانات المستخدم
            </h2>
            <button class="sg-modal-close" onclick="closeEditModal()">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <div class="sg-modal-body">
            <input type="hidden" id="editUserId" />

            <div class="usr-modal-avatar-row">
                <div class="usr-modal-avatar" id="editAvatarPreview"
                     style="background: var(--sg-primary);">م</div>
                <div>
                    <h4 id="editNamePreview" style="margin:0; font-size:16px; font-weight:800;">
                        الاسم الكامل
                    </h4>
                    <span class="usr-username" id="editUserNamePreview">username</span>
                </div>
            </div>

            <div class="usr-form-divider">المعلومات الأساسية</div>

            <div class="sg-form-row">
                <div class="sg-form-group">
                    <label><i class="fas fa-user me-1 text-success"></i>الاسم الكامل *</label>
                    <input type="text" id="editFullName" class="sg-form-input" />
                </div>
                <div class="sg-form-group">
                    <label><i class="fas fa-at me-1 text-primary"></i>اسم المستخدم *</label>
                    <input type="text" id="editUserName" class="sg-form-input" />
                </div>
            </div>

            <div class="sg-form-row">
                <div class="sg-form-group">
                    <label><i class="fas fa-envelope me-1 text-warning"></i>البريد الإلكتروني</label>
                    <input type="email" id="editEmail" class="sg-form-input" />
                </div>
                <div class="sg-form-group">
                    <label><i class="fas fa-phone me-1 text-info"></i>رقم الهاتف</label>
                    <input type="text" id="editPhone" class="sg-form-input" />
                </div>
            </div>

            <div class="sg-form-row">
                <div class="sg-form-group">
                    <label><i class="fas fa-user-shield me-1"></i>الدور الوظيفي *</label>
                    <select id="editRole" class="sg-form-select">
                        @foreach (var r in roles)
                        {
                            <option value="@r">@r</option>
                        }
                    </select>
                </div>
                <div class="sg-form-group">
                    <label><i class="fas fa-toggle-on me-1"></i>حالة الحساب</label>
                    <div class="usr-toggle-row">
                        <label class="usr-toggle">
                            <input type="checkbox" id="editIsActive" />
                            <span class="usr-toggle-slider"></span>
                        </label>
                        <span id="editIsActiveLabel" class="fw-bold text-success">نشط</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="sg-modal-footer">
            <button class="sg-btn-cancel" onclick="closeEditModal()">
                <i class="fas fa-times me-1"></i>إلغاء
            </button>
            <button class="sg-btn-next" id="editSaveBtn" onclick="saveEditUser()">
                <i class="fas fa-save me-1"></i>حفظ التغييرات
            </button>
        </div>
    </div>
</div>

<!-- ============================================
     MODAL: تغيير كلمة المرور
============================================ -->
<div class="sg-modal-overlay" id="passwordModal">
    <div class="sg-modal sg-modal-sm">
        <div class="sg-modal-header">
            <h2 class="sg-modal-title">
                <i class="fas fa-key me-2"></i>تغيير كلمة المرور
            </h2>
            <button class="sg-modal-close" onclick="closePasswordModal()">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <div class="sg-modal-body">
            <input type="hidden" id="passUserId" />

            <div class="usr-pass-user-info" id="passUserInfo">
                <i class="fas fa-user-circle fa-2x text-muted"></i>
                <span id="passUserName">اسم المستخدم</span>
            </div>

            <div class="sg-form-group">
                <label><i class="fas fa-lock me-1 text-danger"></i>كلمة المرور الجديدة *</label>
                <div class="usr-pass-input">
                    <input type="password" id="newPassword" class="sg-form-input"
                           placeholder="6 أحرف على الأقل" />
                    <button type="button" class="usr-pass-toggle"
                            onclick="togglePassword('newPassword', 'newPassIcon')">
                        <i class="fas fa-eye" id="newPassIcon"></i>
                    </button>
                </div>
                <div class="usr-pass-strength" id="newPassStrength" style="display:none;">
                    <div class="usr-strength-bar">
                        <div class="usr-strength-fill" id="newStrengthFill"></div>
                    </div>
                    <span id="newStrengthText"></span>
                </div>
            </div>

            <div class="sg-form-group">
                <label><i class="fas fa-lock me-1 text-danger"></i>تأكيد كلمة المرور *</label>
                <div class="usr-pass-input">
                    <input type="password" id="confirmNewPassword" class="sg-form-input"
                           placeholder="أعد كتابة كلمة المرور" />
                    <button type="button" class="usr-pass-toggle"
                            onclick="togglePassword('confirmNewPassword', 'confirmNewIcon')">
                        <i class="fas fa-eye" id="confirmNewIcon"></i>
                    </button>
                </div>
                <span class="text-danger small" id="passConfirmError"></span>
            </div>
        </div>

        <div class="sg-modal-footer">
            <button class="sg-btn-cancel" onclick="closePasswordModal()">إلغاء</button>
            <button class="sg-btn-save" id="passSaveBtn" onclick="savePassword()">
                <i class="fas fa-key me-1"></i>تغيير كلمة المرور
            </button>
        </div>
    </div>
</div>

<!-- ============================================
     MODAL: تأكيد الحذف
============================================ -->
<div class="sg-modal-overlay" id="deleteUserModal">
    <div class="sg-modal sg-modal-sm">
        <div class="sg-modal-header">
            <h2 class="sg-modal-title text-danger">
                <i class="fas fa-exclamation-triangle me-2"></i>تأكيد الحذف
            </h2>
            <button class="sg-modal-close" onclick="closeDeleteModal()">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="sg-modal-body text-center">
            <div class="delete-icon-wrapper">
                <i class="fas fa-user-times"></i>
            </div>
            <h4 id="deleteUserMessage">هل تريد حذف هذا المستخدم؟</h4>
            <p class="text-muted small mt-2">لا يمكن التراجع عن هذا الإجراء</p>
        </div>
        <div class="sg-modal-footer">
            <button class="sg-btn-cancel" onclick="closeDeleteModal()">إلغاء</button>
            <button class="sg-btn-danger" id="confirmDeleteUserBtn">
                <i class="fas fa-trash me-1"></i>حذف
            </button>
        </div>
    </div>
</div>

<!-- Toast Container -->
<div id="toastContainer" style="position:fixed; top:80px; left:20px; z-index:9999;"></div>

@section Styles {
<style>
    /* ===== STATS ===== */
    .usr-stats-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
        margin-top: 15px;
    }

    .usr-stat {
        background: white;
        border-radius: 12px;
        padding: 15px 18px;
        display: flex;
        align-items: center;
        gap: 12px;
        box-shadow: var(--sg-shadow);
        font-size: 22px;
        transition: transform 0.2s;
    }

    .usr-stat:hover { transform: translateY(-2px); }

    .usr-stat.green { border-right: 4px solid #16a34a; }
    .usr-stat.blue  { border-right: 4px solid #2563eb; }
    .usr-stat.red   { border-right: 4px solid #dc2626; }
    .usr-stat.gold  { border-right: 4px solid #ca8a04; }

    .usr-stat.green i { color: #16a34a; }
    .usr-stat.blue  i { color: #2563eb; }
    .usr-stat.red   i { color: #dc2626; }
    .usr-stat.gold  i { color: #ca8a04; }

    .usr-stat-num {
        display: block;
        font-size: 22px;
        font-weight: 800;
        color: var(--sg-text);
        line-height: 1.2;
    }

    .usr-stat-label {
        display: block;
        font-size: 11px;
        color: var(--sg-text-light);
        font-weight: 500;
    }

    /* ===== USERS GRID ===== */
    .usr-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
        gap: 18px;
    }

    /* ===== USER CARD ===== */
    .usr-card {
        background: white;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: var(--sg-shadow);
        border: 1px solid rgba(14,77,58,0.06);
        transition: all 0.25s;
    }

    .usr-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--sg-shadow-hover);
    }

    .usr-card.inactive {
        opacity: 0.75;
        border: 1px dashed #e5e7eb;
    }

    .usr-card-header {
        background: linear-gradient(135deg, var(--sg-primary), var(--sg-primary-light));
        padding: 25px 20px 15px;
        display: flex;
        justify-content: center;
        position: relative;
    }

    .usr-avatar {
        width: 65px;
        height: 65px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
