@model SmarterGros.ViewModels.PurchaseStatsViewModel

@{
    var culture = new System.Globalization.CultureInfo("ar-DZ");
}

<div class="stats-grid">
    <!-- إجمالي المشتريات -->
    <div class="stat-card stat-primary">
        <div class="stat-icon">
            <i class="fas fa-shopping-cart"></i>
        </div>
        <div class="stat-content">
            <div class="stat-value">@Model.TotalAmount.ToString("N2", culture) <small>دج</small></div>
            <div class="stat-label">إجمالي المشتريات</div>
            <div class="stat-meta">@Model.TotalCount فاتورة</div>
        </div>
    </div>

    <!-- المدفوع -->
    <div class="stat-card stat-success">
        <div class="stat-icon">
            <i class="fas fa-money-bill-wave"></i>
        </div>
        <div class="stat-content">
            <div class="stat-value">@Model.TotalPaid.ToString("N2", culture) <small>دج</small></div>
            <div class="stat-label">المبالغ المدفوعة</div>
            <div class="stat-meta">@Model.PaymentPercentage% من الإجمالي</div>
        </div>
    </div>

    <!-- الدين -->
    <div class="stat-card stat-danger">
        <div class="stat-icon">
            <i class="fas fa-credit-card"></i>
        </div>
        <div class="stat-content">
            <div class="stat-value">@Model.TotalDebt.ToString("N2", culture) <small>دج</small></div>
            <div class="stat-label">إجمالي الديون</div>
            <div class="stat-meta">@Model.UnpaidCount فاتورة غير مسددة</div>
        </div>
    </div>

    <!-- المرتجعات -->
    <div class="stat-card stat-warning">
        <div class="stat-icon">
            <i class="fas fa-rotate-left"></i>
        </div>
        <div class="stat-content">
            <div class="stat-value">@Model.TotalReturns.ToString("N2", culture) <small>دج</small></div>
            <div class="stat-label">قيمة المرتجعات</div>
            <div class="stat-meta">@Model.ReturnsCount مرتجع</div>
        </div>
    </div>

    <!-- تكلفة الشحن -->
    <div class="stat-card stat-info">
        <div class="stat-icon">
            <i class="fas fa-truck-fast"></i>
        </div>
        <div class="stat-content">
            <div class="stat-value">@Model.TotalShipping.ToString("N2", culture) <small>دج</small></div>
            <div class="stat-label">تكاليف الشحن</div>
            <div class="stat-meta">مصاريف إضافية</div>
        </div>
    </div>

    <!-- إحصائيات الحالات -->
    <div class="stat-card stat-secondary">
        <div class="stat-icon">
            <i class="fas fa-chart-pie"></i>
        </div>
        <div class="stat-content">
            <div class="stat-counters">
                <div class="counter-item">
                    <span class="counter-badge bg-secondary">@Model.DraftCount</span>
                    <small>مسودة</small>
                </div>
                <div class="counter-item">
                    <span class="counter-badge bg-warning">@Model.SentCount</span>
                    <small>مرسلة</small>
                </div>
                <div class="counter-item">
                    <span class="counter-badge bg-success">@Model.ReceivedCount</span>
                    <small>مستلمة</small>
                </div>
                <div class="counter-item">
                    <span class="counter-badge bg-danger">@Model.CancelledCount</span>
                    <small>ملغاة</small>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 15px;
        margin-bottom: 20px;
    }

    .stat-card {
        background: white;
        border-radius: 12px;
        padding: 18px;
        display: flex;
        align-items: center;
        gap: 15px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        transition: all 0.3s ease;
        border-right: 4px solid;
    }

    .stat-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 5px 15px rgba(0,0,0,0.12);
    }

    .stat-icon {
        width: 55px;
        height: 55px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: white;
        flex-shrink: 0;
    }

    .stat-content {
        flex: 1;
        min-width: 0;
    }

    .stat-value {
        font-size: 1.3rem;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 4px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .stat-value small {
        font-size: 0.7em;
        color: #6c757d;
        font-weight: 500;
    }

    .stat-label {
        font-size: 0.85rem;
        color: #6c757d;
        font-weight: 600;
        margin-bottom: 2px;
    }

    .stat-meta {
        font-size: 0.75rem;
        color: #95a5a6;
    }

    /* الألوان */
    .stat-primary { border-color: #0E4D3A; }
    .stat-primary .stat-icon { background: linear-gradient(135deg, #0E4D3A, #1a6b54); }

    .stat-success { border-color: #28a745; }
    .stat-success .stat-icon { background: linear-gradient(135deg, #28a745, #20c997); }

    .stat-danger { border-color: #dc3545; }
    .stat-danger .stat-icon { background: linear-gradient(135deg, #dc3545, #e74c3c); }

    .stat-warning { border-color: #ffc107; }
    .stat-warning .stat-icon { background: linear-gradient(135deg, #ffc107, #ff9800); }

    .stat-info { border-color: #17a2b8; }
    .stat-info .stat-icon { background: linear-gradient(135deg, #17a2b8, #0288d1); }

    .stat-secondary { border-color: #6c757d; }
    .stat-secondary .stat-icon { background: linear-gradient(135deg, #6c757d, #455a64); }

    /* العدّادات */
    .stat-counters {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
    }

    .counter-item {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .counter-badge {
        background: #6c757d;
        color: white;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 700;
        min-width: 32px;
        text-align: center;
    }

    .counter-item small {
        font-size: 0.75rem;
        color: #495057;
    }
</style>